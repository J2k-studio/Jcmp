#import <stdlib>
#import <opengl3>
#import <compute>
// the Mali-G76 against the CPU: n x n times n x n on the GPU (a compute shader, tiles of 16 x 16), the numbers stay on the chip between runs
//   jcmp -dyn bench/gpu_matmul.jk -o gm && ./gm
int main() {
    Gl gl = Gl::open(64, 64, 3, 1);
    if !gl.ok { cout << "no GL: " << gl.log << "\n"; return 1; }
    int[] sizes = arr(4);
    sizes.push(128); sizes.push(256); sizes.push(512); sizes.push(1024);
    for q in 0..4 {
        int n = sizes[q];
        String src = "#version 310 es\nprecision highp float;\nlayout(local_size_x = 16, local_size_y = 16) in;\n";
        src = src + "layout(std430, binding = 0) readonly buffer A { float a[]; };\nlayout(std430, binding = 1) readonly buffer B { float b[]; };\nlayout(std430, binding = 2) buffer C { float c[]; };\n";
        src = src + "shared float ta[16][16];\nshared float tb[16][16];\nconst uint N = " + str(n) + "u;\n";
        src = src + "void main() {\n uint row = gl_GlobalInvocationID.y; uint col = gl_GlobalInvocationID.x; uint lr = gl_LocalInvocationID.y; uint lc = gl_LocalInvocationID.x;\n float acc = 0.0;\n";
        src = src + " for (uint t = 0u; t < N / 16u; t++) {\n  ta[lr][lc] = a[row * N + t * 16u + lc];\n  tb[lr][lc] = b[(t * 16u + lr) * N + col];\n  barrier();\n";
        src = src + "  for (uint k = 0u; k < 16u; k++) { acc += ta[lr][k] * tb[k][lc]; }\n  barrier();\n }\n c[row * N + col] = acc;\n}\n";
        Kernel k = Kernel::make(gl, src);
        if !k.ok { cout << "kernel: " << k.error << "\n"; return 1; }
        Floats fa = Floats::make(n * n);
        Floats fb = Floats::make(n * n);
        Floats fc = Floats::make(n * n);
        for i in 0..n * n { fa.set(i, (float)(i % 7) * 0.25); fb.set(i, (float)(i % 5) * 0.5); fc.set(i, 0.0); }
        GpuBuffer ga = GpuBuffer::make(gl, 0, fa);
        GpuBuffer gb = GpuBuffer::make(gl, 1, fb);
        GpuBuffer gc = GpuBuffer::make(gl, 2, fc);
        k.run(n / 16, n / 16, 1);
        Floats warm = gc.read();                              // the first run and its compile are not counted
        int reps = 3;
        if n <= 256 { reps = 20; }
        int t0 = Time::now_ms();
        for r in 0..reps { k.run(n / 16, n / 16, 1); }
        Floats out = gc.read();                               // reading waits for the GPU to finish
        int t1 = Time::now_ms();
        double ms = (double)(t1 - t0) / (double)reps;
        double gf = 2.0 * (double)n * (double)n * (double)n / (ms * 1000000.0);
        // one number checked against the CPU
        double want = 0.0;
        for kk in 0..n { want += (double)(fa.get(5 * n + kk)) * (double)(fb.get(kk * n + 3)); }
        cout << n << ": " << ms << " ms, " << gf << " GFLOPS (c[5][3] " << out.get(5 * n + 3) << " want " << want << ")\n";
    }
    return 0;
}
