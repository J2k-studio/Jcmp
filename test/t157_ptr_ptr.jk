void set_text(char^^ out, char^ s) {
    out^ = s;                              // store a pointer through a pointer to pointer
}

int count(char^^ list, int n) {
    int total = 0;
    int i = 0;
    while i < n {
        char^ s = list[i];                 // an element that is a pointer
        int k = 0;
        while s[k] != 0 { k += 1; }
        total += k;
        i += 1;
    }
    return total;
}

char^ names[3];

int main() {
    char^ p = null;
    set_text(@p, "hello");
    cout << p << "\n";
    names[0] = "ab";
    names[1] = "cde";
    names[2] = "f";
    char^^ pp = @names;
    cout << pp[1] << " " << names[2][0] << " " << pp[0][1] << "\n";
    int r = count(@names, 3);              // 2 + 3 + 1
    int x = 5;
    int^ ix = @x;
    int^^ pix = @ix;
    pix^^ = 9;                             // x = 9
    return r + x;                          // 6 + 9
}
