int main() {
    int a = 5;
    int b = 0;
    int c = 7;
    int r = 0;
    if a > 1 && c > 6 { r += 1; }
    if a > 1 && b > 0 { r += 100; }
    if b > 0 || c == 7 { r += 2; }
    if b > 0 || c == 8 { r += 100; }
    if a == 5 && b == 0 || c == 1 { r += 4; }
    if a == 1 && b == 0 || c == 7 && a == 5 { r += 8; }
    if (a == 1 || c == 7) && b == 0 { r += 16; }
    if (a == 1 || c == 2) && b == 0 { r += 100; }
    if a != 0 && c != 0 { r += 32; }
    if b != 0 || b != 0 { r += 100; }
    int i = 0;
    int n = 0;
    while i < 10 && n < 3 { i += 1; n += 1; }
    r += n * 0 + i;
    for int k = 0; k < 10 && k != 4; k += 1 { r += 1; }
    while true { r += 1; break; }
    if a < 3 { r += 100; } else if a > 3 && c > 3 { r += 64; } else { r += 100; }
    return r;
}
