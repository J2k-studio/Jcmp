int main() {
    int a = 5;
    int r = 0;
    r += ~a + 7;           // -6 + 7 = 1
    r += ~0 + 1;           // -1 + 1 = 0
    r += ~~a - 4;          // 5 - 4 = 1
    r += (~a & 7);         // ...11111010 & 111 = 2
    i8 b = 0;
    b = ~b;                // -1
    if b < 0 { r += 10; }
    char c = 240;
    c = ~c;                // 15 (unsigned wrap)
    r += c;                // 15
    return r;              // 1+0+1+2+10+15 = 29
}
