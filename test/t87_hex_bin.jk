int main() {
    int a = 0xFF;            // 255
    int b = 0b1010;          // 10
    int c = 0x10 + 0b11;     // 19
    int d = 0xFFFFFFFF;      // 4294967295
    int e = 0xDEADBEEF >> 28;    // 13
    int r = a & 0x0F;        // 15
    r += b + c;              // 15+10+19 = 44
    if d == 4294967295 { r += 1; }
    r += e;                  // 44 + 1 + 13 = 58
    return r;
}
