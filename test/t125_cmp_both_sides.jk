int f(int x) { return x * 2; }
int g(int x) { return x + 5; }

struct P { int v; }

int main() {
    int a[3];
    int b[3];
    a[0] = 5; a[1] = 9; a[2] = 3;
    b[0] = 5; b[1] = 4; b[2] = 8;
    int r = 0;
    if a[0] == b[0] { r += 1; }               // equal
    if a[1] != b[1] { r += 2; }               // different
    if a[1] > b[1] { r += 4; }                // 9 > 4
    if a[2] < b[2] { r += 8; }                // 3 < 8
    if f(3) < g(3) { r += 16; }               // 6 < 8
    if f(5) > g(1) { r += 32; }               // 10 > 6
    if f(2) == g(-1) { r += 64; }             // 4 == 4
    int^ p = @a;
    int^ q = @b;
    if p[1] != q[1] && p^ == q^ { r += 128; } // 9 != 4 and 5 == 5
    P u;
    P w;
    u.v = 7;
    w.v = 7;
    if u.v == w.v { r += 256; }
    return r % 251;                           // 511 % 251 = 9
}
