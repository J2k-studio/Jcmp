int g[4];

int get(int i, int a[]) {
    return a[i];
}

int main() {
    int v[5];
    int m[2][3];
    for i in 0..5 { v[i] = i; }
    int ok = 0;
    ok += v[4];                  // 4
    ok += m[1][2] * 0;
    ok += get(3, v);             // 3
    g[3] = 2;
    ok += g[3];                  // 2
    cout << ok << "\n";          // 9
    int i = 5;
    cout << get(i, v) << "\n";   // out of range: stops here with -d
    return 1;
}
