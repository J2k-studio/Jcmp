struct Point {
    i32 x;
    i32 y;
}

struct Box {
    Point lo;
    Point hi;
    char tag;
    bool ok;
    i32 weights[3];
}

Point gp;
Point list[3];

int main() {
    Point a = {1, 2};                       // brace init
    Point b = a;                            // copy at declaration
    b.x = 10;
    Point c;
    c = b;                                  // assignment copy
    list[1] = c;                            // copy into an array element
    list[2] = {7, 8};
    gp = list[2];                           // global <- element
    Box box = { {1, 2}, {3, 4}, 'k', true, {5, 6, 7} };
    Box copy = box;
    copy.hi.y = 40;
    Point^ pp = @a;
    pp^ = list[1];                          // copy through a pointer
    int r = 0;
    r += a.x + a.y;                         // 10 + 2 = 12
    r += b.x + b.y;                         // 10 + 2 = 12
    r += list[1].x + list[2].y;             // 10 + 8 = 18
    r += gp.x;                              // 7
    r += box.hi.y + copy.hi.y;              // 4 + 40 = 44
    r += copy.weights[2] + copy.lo.x;       // 7 + 1 = 8
    if copy.ok { r += 1; }                  // 1
    if copy.tag == 'k' { r += 2; }          // 2
    return r;                               // 12 + 12 + 18 + 7 + 44 + 8 + 3 = 104
}
