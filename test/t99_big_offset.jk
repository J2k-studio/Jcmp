char big[70000];
int counter;
i32 words[20000];

int main() {
    big[69999] = 9;
    big[65537] = 4;
    counter = 11;              // global scalar after a 70 KB array: offset > 32760
    words[19999] = 123456;
    words[1] += 5;
    int^ p = @words;
    p[2] = 7;
    int e = 0;
    if words[19999] == 123456 { e = 1; }
    return big[69999] + big[65537] + counter + e + words[1] + p[2];
    // 9 + 4 + 11 + 1 + 5 + 7 = 37
}
