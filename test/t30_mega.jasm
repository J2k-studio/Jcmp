mov x0, 0
mov x1, 1
mov x2, 2
mov x3, 3
mul x4, x2, x3
add x4, x4, x1
sub x4, x4, 1
cmp x4, 6
b.ne mega_fail
add x0, x0, 10
mov x5, 0
mega_loop:
cmp x5, 4
b.ge mega_loop_done
add x0, x0, x5
add x5, x5, 1
b mega_loop
mega_loop_done:
bl mega_helper
add x0, x0, x9
sub sp, sp, 16
str x0, [sp]
ldr x0, [sp]
add sp, sp, 16
mov x8, 93
svc 0
mega_helper:
mov x9, 7
ret
mega_fail:
mov x0, 255
mov x8, 93
svc 0
