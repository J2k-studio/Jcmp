struct Point { i32 x; i32 y; }
struct Rect { Point a; Point b; char tag; bool ok; }

int g[7];

int main() {
    int r = 0;
    r += sizeof(int);              // 8
    r += sizeof(i32);              // 4
    r += sizeof(char);             // 1
    r += sizeof(bool);             // 1
    r += sizeof(f32) + sizeof(f64);   // 4 + 8
    r += sizeof(int^);             // 8
    r += sizeof(Point);            // 8
    r += sizeof(Rect);             // 24
    int a[10];
    Point p;
    r += sizeof(a);                // 80
    r += sizeof(a[0]);             // 8
    r += sizeof(p);                // 8
    r += sizeof(p.x);              // 4
    r += sizeof(g);                // 56
    return r % 256;                // 8+4+1+1+12+8+8+24+80+8+8+4+56 = 222
}
