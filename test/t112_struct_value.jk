struct Vec {
    int x;
    int y;
}

struct Pair {
    Vec a;
    Vec b;
}

Vec origin;

int sum(Vec v) {
    return v.x + v.y;
}

void bump(Vec v) {            // modifies only its own copy
    v.x += 100;
}

Vec make(int x, int y) {
    Vec r;
    r.x = x;
    r.y = y;
    return r;
}

Vec add(Vec a, Vec b) {
    Vec r;
    r.x = a.x + b.x;
    r.y = a.y + b.y;
    return r;
}

Pair twin(Vec v) {
    Pair p;
    p.a = v;
    p.b = v;
    p.b.y += 1;
    return p;
}

int main() {
    Vec a = {3, 4};
    bump(a);                  // a unchanged
    int s = sum(a);           // 7
    Vec b = make(10, 20);
    Vec c = add(a, b);        // (13, 24)
    origin = make(1, 2);
    Pair t = twin(c);         // a = (13, 24), b = (13, 25)
    Vec d;
    d = add(origin, a);       // (4, 6)
    Vec arr[2];
    arr[1] = make(5, 6);
    int e = sum(arr[1]);      // 11
    return a.x + s + c.x + c.y + origin.y + t.b.y + d.y + e;
    // 3 + 7 + 13 + 24 + 2 + 25 + 6 + 11 = 91
}
