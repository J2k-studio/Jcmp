int main() {
    char msg[] = "sys\n";
    syscall(64, 1, @msg, 4);                       // write(1, msg, 4)

    char path[] = "test/t96_data.txt";
    int fd = syscall(56, -100, @path, 0, 0);       // openat(AT_FDCWD, path, O_RDONLY)
    char buf[32];
    int n = syscall(63, fd, @buf, 31);             // read(fd, buf, 31)
    syscall(57, fd);                               // close(fd)
    syscall(64, 1, @buf, n);                       // echo the file

    int bad = syscall(56, -100, @msg, 0, 0);       // no such file: negative errno
    char^ prog = arg(0);
    int r = 0;
    if argc() == 1 { r += 1; }
    if prog[0] == '.' { r += 2; }                  // "./_test_out/..."
    if n == 16 { r += 4; }
    if bad < 0 { r += 8; }
    syscall(93, r + 20);                           // exit(r + 20)
    return 0;
}
