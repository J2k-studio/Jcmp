struct Item {
    int id;
    char name[8];
    i32 score[3];
}

struct Inventory {
    int count;
    Item items[4];
}

Item table[3];
Inventory inv;

int sum_scores(Item^ it) {
    int s = 0;
    int i = 0;
    while i < 3 { s += it^.score[i]; i += 1; }
    return s;
}

int main() {
    int i = 0;
    while i < 3 {
        table[i].id = i + 10;
        table[i].score[0] = i;
        table[i].score[1] = i * 2;
        table[i].score[2] = i * 3;
        i += 1;
    }
    table[1].name[0] = 'h';
    table[1].name[1] = 'i';
    table[1].name[2] = 0;
    int a = table[2].id;                      // 12
    int b = table[2].score[2];                // 6
    int c = sum_scores(@table);               // element 0: 0 + 0 + 0 = 0
    inv.count = 2;
    inv.items[1].id = 77;
    inv.items[1].score[2] = 5;
    int d = inv.items[1].id + inv.items[1].score[2];   // 82
    Item^ p = @table;
    int e = p[2].id;                          // 12
    p[0].score[1] += 40;
    int f = table[0].score[1];                // 40
    int g = table[1].name[1] - 'a';           // 'i' - 'a' = 8
    return a + b + c + d + e + f + g;         // 12 + 6 + 0 + 82 + 12 + 40 + 8 = 160
}
