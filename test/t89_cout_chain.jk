int main() {
    int x = 42;
    int n = 7;
    char c = 'Z';
    char s[] = "hi";
    cout << "value: " << x << "\n";
    cout << x << " " << n << " " << x + n << "\n";
    cout << s << ' ' << c << "!" << '\n';
    cout << "shift: " << n shl 2 << " " << (n << 1) << "\n";
    cout << -5 << "|" << 0 << "\n";
    cout << x;
    cout << "end\n";
    return 0;
}
