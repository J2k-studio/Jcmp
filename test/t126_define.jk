#define MAX 10
#define DOUBLE_MAX MAX * 2
#define NAME "J2K"
#define SIZE 4          // a comment after the value is part of it
#define MASK 0xFF
#define NEG -3

int table[SIZE];

int main() {
    int r = MAX;                         // 10
    r += DOUBLE_MAX;                     // 10 * 2 = 20 (text substitution)
    int a[MAX];
    a[MAX - 1] = 7;
    r += a[9];                           // 7
    table[SIZE - 1] = 5;
    r += table[3];                       // 5
    char^ s = NAME;
    r += s[0] - 'J';                     // 0
    r += (0x1FF & MASK) - 250;           // 255 - 250 = 5
    r += NEG;                            // -3
    cout << "MAX stays in strings\n";
    int MAXIMUM = 4;                     // not touched: a different word
    r += MAXIMUM;                        // 4
    return r;                            // 10 + 20 + 7 + 5 + 0 + 5 - 3 + 4 = 48
}
