struct Vec {
    f64 x;
    f64 y;
    f32 w;
}

f64 g = 2.5;
f64 table[3];

f64 area(f64 w, f64 h) {
    return w * h;
}

f32 half(f32 v) {
    return v / 2.0;
}

f64 dot(Vec^ a, Vec^ b) {
    return a^.x * b^.x + a^.y * b^.y;
}

int main() {
    Vec p;
    Vec q;
    p.x = 1.0; p.y = 2.0; p.w = 3.0;
    q.x = 4.0; q.y = 5.0; q.w = 6.0;
    f64 d = dot(@p, @q);                  // 14
    coutf << d << " ";
    coutf << area(g, 4.0) << " ";         // 10
    coutf << half(p.w + q.w) << "\n";     // 4.5
    table[0] = 0.5; table[1] = 1.5; table[2] = 2.5;
    f64 s = 0.0;
    int i = 0;
    while i < 3 {
        s += table[i];
        i += 1;
    }
    s *= 2.0;
    s -= 1.0;
    s /= 4.0;                             // (4.5 * 2 - 1) / 4 = 2
    coutf << s << "\n";
    f64^ ptr = @table;
    ptr[1] = 10.0;
    f64 total = table[0] + table[1];      // 10.5
    coutf << total << "\n";
    int r = 0;
    if total > 10.0 { r += 1; }
    if total >= 10.5 { r += 2; }
    if total < 11.0 { r += 4; }
    if total <= 10.4 { r += 8; }
    return r + (int)(d / 2.0);            // 7 + 7
}
