int main() {
    int n;
    i8 small;
    u8 byte;
    char c;
    char word[6];
    f64 x;
    f32 y;
    cin >> n >> small >> byte >> c >> word;
    cinf >> x >> y;
    cout << n << " " << small << " " << byte << " " << c << " " << word << "\n";
    coutf << x << " " << y << "\n";
    int bad = 0;
    try {
        cin >> n;                      // "abc" is not a number
    } catch (e) {
        cout << e << "\n";
        bad += 1;
    }
    cin >> word;                       // skip the bad word "abc"
    try {
        cin >> small;                  // 300 does not fit an i8
    } catch (e2) {
        cout << e2 << "\n";
        bad += 10;
    }
    int last;
    try {
        cin >> last;                   // nothing left
        cin >> last;
    } catch (e3) {
        cout << e3 << "\n";
        bad += 100;
    }
    return bad;
}
