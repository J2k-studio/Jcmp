struct Vec {
    int x;
    int y;

    Vec plus(self, int dx, int dy) {
        Vec r;
        r.x = self.x + dx;
        r.y = self.y + dy;
        return r;
    }
    Vec scaled(self, int k) {
        Vec r = {self.x * k, self.y * k};
        return r;
    }
    int sum(self) { return self.x + self.y; }
}

Vec make(int x, int y) {
    Vec v;
    v.x = x;
    v.y = y;
    return v;
}

int main() {
    Vec a = make(1, 2);
    Vec b = a.plus(10, 20);              // (11, 22)
    int r = b.x + b.y;                   // 33
    r += make(5, 6).y;                   // 6
    r += a.plus(1, 1).x;                 // 2
    r += a.scaled(3).plus(1, 0).sum();   // (3,6) -> (4,6) -> 10
    Vec c = a.scaled(2).scaled(2);       // (4, 8)
    r += c.y;                            // 8
    return r;                            // 33 + 6 + 2 + 10 + 8 = 59
}
