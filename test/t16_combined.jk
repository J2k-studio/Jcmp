int main() {
    int i = 0;
    int evens = 0;
    int odds = 0;
    while i < 6 {
        int r = i - 2;
        if r == 0 {
            evens += 1;
        } else if r == 1 {
            odds += 1;
        } else if r == 2 {
            evens += 1;
        } else {
            odds += 1;
        }
        i++;
    }
    return evens;
}
