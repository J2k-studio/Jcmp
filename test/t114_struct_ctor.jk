struct Cell {
    int v;
    int tag;
    void init(self) {
        self.v = 7;
        self.tag = 1;
    }
    int twice(self) { return self.v * 2; }
}

Cell g;
Cell gs[3];

int main() {
    Cell a;                      // init() runs
    Cell arr[3];                 // init() runs for each element
    arr[2].v += 1;
    Cell b = {1, 2};             // brace init: init() does not run
    int r = 0;
    r += a.v + g.v + gs[2].v;    // 7 + 7 + 7 = 21
    r += arr[0].v + arr[2].v;    // 7 + 8 = 15
    r += b.v + b.tag;            // 3
    r += g.twice() + gs[1].twice();   // 14 + 14 = 28
    return r;                    // 21 + 15 + 3 + 28 = 67
}
