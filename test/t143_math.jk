import std
using std::math

int main() {
    coutf << sqrt(2.0) << " " << sqrt(144.0) << "\n";          // 1.414214 12.000000
    coutf << floor(2.7) << " " << floor(-2.7) << " " << ceil(2.1) << " " << trunc(-2.7) << "\n";   // 2 -3 3 -2
    coutf << abs(-3.5) << " " << min(1.5, 2.5) << " " << max(1.5, 2.5) << " " << pow(2.0, 10) << "\n";
    int r = iabs(-7) + imin(3, 9) + imax(3, 9) + ipow(2, 5);     // 7 + 3 + 9 + 32 = 51
    f64 s = sqrt(16.0);
    if s == 4.0 { r += 100; }
    return r;                                                     // 151
}
