int depth(int n) {
    if n == 0 { throw "bottom reached"; }
    return depth(n - 1) + 1;
}

int safe_div(int a, int b) {
    if b == 0 { throw "division by zero"; }
    return a / b;
}

int first_even(int limit) {
    int i = 1;
    while i < limit {
        try {
            if i % 2 == 0 { return i * 10; }       // return from inside a try
        } catch (e) {
            return -1;
        }
        i += 1;
    }
    return 0;
}

int main() {
    int r = 0;
    try {
        r += depth(5);
        r += 1000;                                   // not reached
    } catch (e) {
        cout << "caught: " << e << "\n";
        r += 1;
    }
    try {
        r += safe_div(10, 2);                        // 5
        r += safe_div(1, 0);
    } catch (msg) {
        cout << "caught: " << msg << "\n";
        r += 10;
    }
    try {
        try {
            throw "inner";
        } catch (a) {
            cout << a << "\n";
            throw "outer";                           // thrown from a catch block
        }
    } catch (b) {
        cout << b << "\n";
        r += 100;
    }
    int k = 0;
    while k < 5 {
        try {
            k += 1;
            if k == 2 { continue; }                  // leaves the try
            if k == 4 { break; }
        } catch (z) { r += 0; }
    }
    r += first_even(10);                             // 20
    r += k;                                          // 4
    cout << "r=" << r << "\n";
    safe_div(5, 0);                                  // nobody catches this
    return r;
}
