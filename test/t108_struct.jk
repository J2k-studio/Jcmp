struct Point {
    i32 x;
    i32 y;
}

struct Rect {
    Point min;
    Point max;
    char tag;
    bool ok;
}

struct Node {
    int value;
    Node^ next;
    i8 small;
}

Point origin;
Rect big;

int area(Rect^ r) {
    return (r^.max.x - r^.min.x) * (r^.max.y - r^.min.y);
}

void move(Point^ p, int dx, int dy) {
    p^.x += dx;
    p^.y += dy;
}

int main() {
    Point p;
    p.x = 3;
    p.y = 4;
    p.x += 10;                       // 13
    origin.x = p.y * 2;              // 8
    Rect r;
    r.min.x = 1;
    r.min.y = 2;
    r.max.x = 11;
    r.max.y = 7;
    r.tag = 'R';
    r.ok = true;
    int a = area(@r);                // 10 * 5 = 50
    move(@p, 1, 1);                  // p = (14, 5)
    big.max.y = 9;
    Node n1;
    Node n2;
    n1.value = 100;
    n2.value = 23;
    n1.next = @n2;
    n1.small = 100;
    n1.small += 100;                 // wraps: -56
    int rr = 0;
    if r.ok { rr += 1; }
    if r.tag == 'R' { rr += 2; }
    if n1.small < 0 { rr += 4; }
    return a + p.x + p.y + origin.x + big.max.y + n1.next^.value + rr;
    // 50 + 14 + 5 + 8 + 9 + 23 + 7 = 116
}
