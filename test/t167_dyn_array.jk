struct Point { int x; int y; }

int sum(int[] a) {                       // a dynamic array is passed by reference
    int s = 0;
    for i in 0..a.len { s += a[i]; }
    return s;
}

void fill(int[] a, int n) {
    for i in 0..n { a.push(i * i); }     // the caller sees these pushes
}

int[] numbers;                           // a global starts as null

int main() {
    int[] list = arr(2);                 // room for 2, length 0
    fill(list, 10);                      // grows beyond its first capacity
    int r = list.len;                    // 10
    r += sum(list);                      // 285
    r += list.pop();                     // 81
    r += list.len;                       // 9
    list[0] = 100;
    r += list[0];                        // 100
    list.resize(12);
    r += list.len + list[11];            // 12 + 0
    int[] same = list;                   // the same array under another name
    same.push(7);
    r += list.len;                       // 13
    Point[] ps = arr(1);
    Point p = {3, 4};
    ps.push(p);
    Point p2 = {5, 6};
    ps.push(p2);
    r += ps[1].y + ps[0].x;              // 6 + 3
    Point q = ps.pop();
    r += q.x;                            // 5
    char^[] words = arr(2);
    words.push("one");
    words.push("two");
    cout << words[1] << " " << words.len << "\n";
    list.free();                         // frees for every name; the variable is null now
    try {
        r += list.len;                   // the array is gone: an exception
    } catch (e) {
        cout << e << "\n";
        r += 1;
    }
    return r % 256;                      // 10+285+81+9+100+12+13+9+5 + 1 = 525 -> 13
}
