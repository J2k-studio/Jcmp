int main() {
    int a = 1;
    int r = 0;
    if a == 1 {
        int b = 5;
        r += b;
    }
    if a == 1 {
        int b = 7;                  // a new block: the same name is fine
        r += b;
    }
    for i in 0..2 { r += i; }
    for i in 0..2 { r += i; }
    return r;                       // 12 + 1 + 1
}
