int main() {
    int a = 4;
    int b = 9;
    int r = 0;
    bool p = (5 > 3);
    bool q = (a < b && b < 10) || a == 100;
    bool u = (a < b);
    bool v = (b < a);
    bool w = (a == 4 && b == 9);
    bool nn = !(a == 5);
    if p { r += 1; }
    if q { r += 2; }
    if u { r += 4; }
    if v { r += 4; }           // false: adds nothing
    if w { r += 4; }
    if nn { r += 4; }          // 4 + 0 + 4 + 4 = 12
    if (5 > 3) { r += 16; }
    return r;                  // 1 + 2 + 12 + 16 = 31
}
