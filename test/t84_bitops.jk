int main() {
    int a = 6;
    int b = 3;
    int r = 0;
    r += a & b;                    // 2
    r += a | b;                    // 7
    r += a xor b;                  // 5
    r += a << 2;                   // 24
    r += 24 >> 2;                  // 6
    r += a shl b;                  // 48
    r += 48 shr 3;                 // 6
    r += 1 | 2 & 3 xor 6;          // 2&3=2, 2 xor 6=4, 1|4 = 5
    r += 1 + 2 << 1;               // (1+2)<<1 = 6
    int m = -16;
    r += (m >> 2) + 4;             // -4 + 4 = 0 (arithmetic shift)
    if a & 1 == 0 { r += 100; }    // (a&1)==0 -> a is even -> true: +100
    if (a & 2) != 0 && a >> 1 == 3 { r += 1000; }
    return r % 256;
}
