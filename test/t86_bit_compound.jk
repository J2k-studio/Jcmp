int main() {
    int a = 255;
    a &= 60;            // 60
    a |= 3;             // 63
    a xor= 5;           // 58
    a <<= 2;            // 232
    a >>= 3;            // 29
    a shl= 1;           // 58
    a shr= 1;           // 29
    int v[3];
    v[1] = 12;
    v[1] &= 10;         // 8
    v[1] |= 1;          // 9
    v[1] xor= 3;        // 10
    v[1] <<= 1;         // 20
    v[1] shr= 2;        // 5
    i8 b = 100;
    b <<= 1;            // wraps: 200 -> -56
    int w = 0;
    if b < 0 { w = 1; }
    return a + v[1] + w;    // 29 + 5 + 1 = 35
}
