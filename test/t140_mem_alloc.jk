import std
using std::mem

struct Node {
    int value;
    Node^ next;
}

int main() {
    int^ a = (int^)alloc(80);              // room for 10 ints
    int i = 0;
    while i < 10 { a[i] = i * i; i += 1; }
    int sum = 0;
    i = 0;
    while i < 10 { sum += a[i]; i += 1; }  // 285
    int a_addr = (int)a;
    free(a);                               // a is null from now on
    int^ b = (int^)alloc(64);              // reuses the freed block
    int reused = 0;
    if (int)b == a_addr { reused = 1; }
    // a linked list on the heap
    Node^ head = null;
    i = 1;
    while i <= 5 {
        Node^ n = (Node^)alloc(16);
        n^.value = i;
        n^.next = head;
        head = n;
        i += 1;
    }
    int total = 0;
    Node^ p = head;
    while (int)p != 0 {
        total += p^.value;                 // 15
        p = p^.next;
    }
    char^ big = (char^)alloc(3000000);     // bigger than one chunk
    big[0] = 'x';
    big[2999999] = 'y';
    int ok = 0;
    if big[0] == 'x' && big[2999999] == 'y' { ok = 1; }
    char^ z = (char^)alloc(16);
    Mem::set(z, 65, 15);
    z[15] = 0;
    cout << z << "\n";
    return (sum + total + reused + ok) % 256;   // 285 + 15 + 1 + 1 = 302 -> 46
}
