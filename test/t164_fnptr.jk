int add(int a, int b) { return a + b; }
int mul(int a, int b) { return a * b; }
void note(int x) { cout << "note " << x << "\n"; }

struct Op {
    char^ name;
    int(int, int)^ fn;
}

int(int, int)^ pick(int which) {
    if which == 0 { return add; }
    return mul;
}

int apply(int(int, int)^ f, int a, int b) {
    return f(a, b);
}

int twice(int(int)^ f, int x) { return f(f(x)); }
int inc(int x) { return x + 1; }

int(int, int)^ table[2];

int main() {
    int(int, int)^ op = add;
    int r = op(3, 4);                       // 7
    op = mul;
    r += op(3, 4);                          // 12
    r += apply(add, 10, 20);                // 30
    r += pick(1)(5, 5);                     // 25 (call the returned pointer)
    table[0] = add;
    table[1] = mul;
    r += table[1](2, 8) + table[0](1, 1);   // 16 + 2
    Op o;
    o.name = "mul";
    o.fn = mul;
    r += o.fn(6, 7);                        // 42
    r += twice(inc, 5);                     // 7
    void(int)^ cb = note;
    cb(99);
    if op != null { r += 1; }
    int(int, int)^ none = null;
    if none == null { r += 1; }
    cout << r << "\n";
    return r % 256;
}
