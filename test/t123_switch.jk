enum class Kind { Num, Plus, Minus, Star, End };

int eval(Kind k, int a, int b) {
    int r = 0;
    switch k {
        Kind::Plus: r = a + b;
        Kind::Minus: r = a - b;
        Kind::Star: { r = a * b; r += 1; }
        _: r = -1;
    }
    return r;
}

int classify(int n) {
    int out = 0;
    switch n {
        1, 2, 3: out = 10;
        4: out = 20;
        -1: out = 30;
        'a': out = 40;
        _: out = 99;
    }
    return out;
}

int main() {
    int r = 0;
    r += eval(Kind::Plus, 3, 4);       // 7
    r += eval(Kind::Minus, 10, 4);     // 6
    r += eval(Kind::Star, 3, 4);       // 13
    r += eval(Kind::End, 1, 1) + 1;    // -1 + 1 = 0
    r += classify(2);                  // 10
    r += classify(4);                  // 20
    r += classify(-1);                 // 30
    r += classify(97);                 // 40
    r += classify(50);                 // 99
    Kind k = Kind::Star;
    int hits = 0;
    int i = 0;
    while i < 5 {
        switch i {
            0, 1: hits += 1;
            2: { hits += 10; }
            _: hits += 100;
        }
        i += 1;
    }
    using enum Kind;
    switch k {
        Plus: r += 1000;
        Star: r += 0;
    }
    return (r + hits) % 256;           // r = 225, hits = 212 -> 437 % 256 = 181
}
