int counter = 5;
i8 small = 100;
char flag;

void bump() {
    counter += 2;
    counter++;
    small += 100;
}

int get() { return counter * 2; }

int main() {
    bump();
    bump();
    flag = 'A';
    int x = counter;          // 5 + 3 + 3 = 11
    int r = 0;
    if small < 0 { r = 1; }   // 100+100+100 wraps in i8: 44 -> not negative: 300 mod 256 = 44
    r += get();               // 22
    int e = 0;
    if small == 44 { e = 1; }
    return x + r + flag - 'A' + e;   // 11 + 22 + 0 + 1 = 34
}
