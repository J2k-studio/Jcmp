// The J2K logo in colour dots (the ASCII-character one, the mascot, is shown by  jcmp -space): a glowing J with a ring tilted 45 degrees that turns around it, twinkling stars, 24 frames a second.
// It is small and of a fixed size (64 x 40 dots = 64 columns x 20 rows of text), so it needs a terminal of 64 x 22.
//   logo             runs until you press Ctrl-C (or Enter)
//   logo 120         stops after 120 frames
#import <stdlib>
#import <math>
#import <gfx>
using stdlib
using math::matrix;
using gfx::screen;

// how close the point (x, y) is to the letter J (0 = far away, 1 = inside the stroke); the letter fills -1..1
double j_shape(double x, double y) {
    double half = 0.11;                                       // half the width of the stroke
    // the top bar, the stem, and the hook (half a circle) at the bottom
    double d = 9.0;
    // top bar: from (-0.20, -0.82) to (0.50, -0.82)
    double bx = Math::clamp(x, -0.20, 0.50);
    d = Math::min(d, Math::sqrt((x - bx) * (x - bx) + (y + 0.82) * (y + 0.82)));
    // stem: x = 0.20 from y = -0.82 to y = 0.28
    double sy = Math::clamp(y, -0.82, 0.28);
    d = Math::min(d, Math::sqrt((x - 0.20) * (x - 0.20) + (y - sy) * (y - sy)));
    // hook: the lower half of a circle with the centre (-0.15, 0.28) and radius 0.35, from the stem round to the left
    double cx = x + 0.15;
    double cy = y - 0.28;
    if cy >= 0.0 {
        d = Math::min(d, Math::abs(Math::sqrt(cx * cx + cy * cy) - 0.35));
    } else if cx < 0.0 {
        d = Math::min(d, Math::sqrt((x + 0.50) * (x + 0.50) + (y - 0.28) * (y - 0.28)));       // the end of the hook
    }
    double v = 1.0 - (d - half) / 0.05;                      // a soft edge
    return Math::clamp(v, 0.0, 1.0);
}

void main() {
    int frames = 0;
    String[] args = Env::args();
    if args.len > 1 {
        switch Num::parse_int(args[1]) {
            Result::Ok(v): frames = v;
            Result::Err(e): {
                cout << "usage: logo [frames]\n";
                return;
            }
        }
    }
    int w = 64;                                               // a small picture of a fixed size: 64 x 40 dots
    int h = 40;                                               // (64 columns, 20 rows of text; about 25 KB of memory)
    Screen s = Screen::make(w, h);
    s.begin();
    double side = (double)Math::min_int(w, s.h);               // the picture is as big as the short side
    double cxs = (double)w / 2.0;
    double cys = (double)s.h / 2.0;
    // the stars: fixed places, each with its own speed and phase of twinkling
    int star_n = 90;
    double star_x[90];
    double star_y[90];
    double star_f[90];
    double star_p[90];
    int seed = 4242;
    for i in 0..star_n {
        seed = (seed * 1103515245 + 12345) & 2147483647;
        star_x[i] = (double)((seed >> 8) % 1000) / 1000.0 * (double)w;
        seed = (seed * 1103515245 + 12345) & 2147483647;
        star_y[i] = (double)((seed >> 8) % 1000) / 1000.0 * (double)s.h;
        seed = (seed * 1103515245 + 12345) & 2147483647;
        star_f[i] = 1.5 + (double)((seed >> 8) % 1000) / 1000.0 * 4.0;
        seed = (seed * 1103515245 + 12345) & 2147483647;
        star_p[i] = (double)((seed >> 8) % 1000) / 1000.0 * 6.283;
    }
    mat3 lean = mat3::rotate_x(Math::radians(45.0));          // the ring leans 45 degrees towards us
    mat3 slant = mat3::rotate_z(Math::radians(-22.0));        // and a little sideways
    int frame = 0;
    int t0 = Time::mono_ns();
    while frames == 0 || frame < frames {
        double t = (double)frame / 24.0;                      // seconds
        s.clear(2, 3, 10);
        for i in 0..star_n {
            double tw = 0.5 + 0.5 * Math::sin(t * star_f[i] + star_p[i]);        // 0..1
            int v = (int)(40.0 + 215.0 * tw * tw);
            s.add((int)star_x[i], (int)star_y[i], v * 8 / 10, v * 9 / 10, v);
            if tw > 0.93 {                                                       // a bright star has little rays
                s.add((int)star_x[i] + 1, (int)star_y[i], v / 4, v / 4, v / 3);
                s.add((int)star_x[i] - 1, (int)star_y[i], v / 4, v / 4, v / 3);
                s.add((int)star_x[i], (int)star_y[i] + 1, v / 4, v / 4, v / 3);
                s.add((int)star_x[i], (int)star_y[i] - 1, v / 4, v / 4, v / 3);
            }
        }
        // the ring: points on a circle, leaned, then turned round the up axis; z > 0 is behind the letter
        mat3 spin = mat3::rotate_y(t * 0.6);                      // the whole ring turns slowly round the letter
        double ring_r = 0.95;
        // the part behind the letter first
        for pass in 0..2 {
            if pass == 1 {
                // the letter, on top of the back of the ring
                for y in 0..s.h {
                    for x in 0..w {
                        double nx = ((double)x - cxs + 0.5) / (side * 0.34);
                        double ny = ((double)y - cys + 0.5) / (side * 0.34);
                        double l = j_shape(nx, ny);
                        if l > 0.0 {
                            double k = (ny + 0.9) / 1.8;                      // 0 at the top, 1 at the bottom
                            int r = (int)((90.0 + 90.0 * k) * l);
                            int g = (int)((225.0 - 110.0 * k) * l);
                            int b = (int)(255.0 * l);
                            s.set(x, y, r, g, b);
                        }
                    }
                }
            }
            for i in 0..720 {
                double a = (double)i * Math::tau() / 720.0;
                vec3 p = {ring_r * Math::cos(a), 0.0, ring_r * Math::sin(a)};
                vec3 q = spin.mul_vec(slant.mul_vec(lean.mul_vec(p)));
                bool behind = q.z > 0.0;
                if (pass == 0 && behind) || (pass == 1 && !behind) {
                    double persp = 1.0 / (1.0 + 0.25 * q.z);
                    int px = (int)(cxs + q.x * persp * side * 0.46);
                    int py = (int)(cys + q.y * persp * side * 0.46);
                    double depth = 0.5 - 0.5 * q.z;                       // near = bright
                    // two beads run round the ring (the ring is turning), the rest of it is calm
                    double bead = 0.0;
                    double da = Math::sin((a - t * 2.2) * 0.5);
                    if da * da > 0.985 { bead = 1.0; }
                    int v = (int)(70.0 + 120.0 * depth + 65.0 * bead);
                    int rr = v * 7 / 10;
                    int gg = v * 85 / 100;
                    s.add(px, py, rr, gg, v);
                    if depth > 0.55 {
                        s.add(px + 1, py, rr / 3, gg / 3, v / 3);
                        s.add(px, py + 1, rr / 3, gg / 3, v / 3);
                    }
                }
            }
        }
        s.glow(0.5);
        s.show();
        cout << "\n";
        if frames == 0 && Term::key_pressed() { break; }
        frame += 1;
        // 24 frames a second: wait until the frame's time has come
        int due = t0 + frame * 41666666;
        int now = Time::mono_ns();
        if due > now { Time::sleep_ms((due - now) / 1000000); }
    }
    s.end();
}
