// jget -- fetch things from the web and libraries for J2K (version 0)
//   jget -h URL [-o FILE]         fetch the data at URL (http, https, ftp, file): to the screen, or to FILE
//   jget -li list                 the libraries in the index (a * marks the ones that are installed)
//   jget -li install NAME         download the library NAME, check its SHA-256 against the index, put it in the library folder
//   jget -li uninstall NAME       delete an installed library
//   jget -li installed            the libraries in the library folder
// (the words install, remove, uninstall, list and installed also work without -li)
// The index is a text file; each line is:  NAME VERSION URL SHA256   (lines that start with # are comments).
// Where: JGET_INDEX (an address or a file path) - default: the public index of the project.
//        JGET_LIB   (the library folder) - default: ~/.j2k/Library, where `#import <name>` looks for libraries.
// A library is one J2K source file NAME.j. Nothing from the library is run when it is installed.
// The download is done by curl, or by wget when there is no curl (jget has no web client of its own yet).
#import <stdlib>
using stdlib;

// the error output (the language has no cerr yet: docs/open-questions.md)
void err(String m) {
    syscall(64, 2, m.c(), m.len);
}

String lib_dir() {
    switch Env::get("JGET_LIB") {
        Option::Some(d): return d;
        Option::None: { }
    }
    switch Env::get("HOME") {
        Option::Some(h): return h + "/.j2k/Library";
        Option::None: return "./Library";
    }
    return "./Library";
}

String index_address() {
    switch Env::get("JGET_INDEX") {
        Option::Some(u): return u;
        Option::None: return "https://raw.githubusercontent.com/J2k-studio/Jcmp-libs/main/index.txt";
    }
    return "";
}

// a name is letters, digits and _ only: it becomes a file name, so no / and no ..
bool name_ok(String n) {
    if n.len == 0 || n.len > 60 { return false; }
    for i in 0..n.len {
        int c = n[i];
        bool good = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        if !good { return false; }
    }
    return true;
}

// run a program and give its exit code (127: it was not found or could not start)
int run_prog(String cmd, String[] args) {
    switch Proc::run(cmd, args) {
        Result::Ok(code): return code;
        Result::Err(e): return 127;
    }
    return 127;
}

// download `address` to the file `to` (to the screen when `to` is empty); false (with a message) when it cannot
bool download(String address, String to) {
    String[] a = arr(0);
    a.push("-fsSL");
    if to.len > 0 {
        a.push("-o");
        a.push(to);
    }
    a.push(address);
    int code = run_prog("curl", a);
    if code == 127 {
        String[] w = arr(0);
        w.push("-q");
        w.push("-O");
        if to.len > 0 { w.push(to); } else { w.push("-"); }
        w.push(address);
        code = run_prog("wget", w);
        if code == 127 {
            err("jget: neither curl nor wget was found; install one of them (jget has no web client of its own yet)\n");
            return false;
        }
    }
    if code != 0 {
        err("jget: cannot fetch " + address + " (exit code " + str(code) + ")\n");
        return false;
    }
    return true;
}

// the index text, fetched into a temporary file in the library folder
String fetch_index(String dir) {
    String tmp = dir + "/.index.tmp";
    if !download(index_address(), tmp) {
        err("jget: the index of libraries could not be fetched. The index of the project is not published yet: set JGET_INDEX to the address (or the path) of an index.\n");
        return "";
    }
    switch Fs::read_text(tmp) {
        Result::Ok(t): { Fs::remove(tmp); return t; }
        Result::Err(e): { err("jget: cannot read the index: " + e.message + "\n"); return ""; }
    }
    return "";
}

bool make_dir(String dir) {
    switch Dir::make_all(dir) {
        Result::Ok(x): return true;
        Result::Err(e): { err("jget: cannot make the folder " + dir + ": " + e.message + "\n"); return false; }
    }
    return false;
}

// the line of the index for `name`, split in four; an empty list when there is none
String[] find_entry(String index, String name) {
    String[] lines = index.split("\n");
    for i in 0..lines.len {
        String line = lines[i].trim();
        if line.len == 0 || line.starts_with("#") { continue; }
        String[] w = line.split(" ");
        if w.len >= 4 && w[0] == name { return w; }
    }
    String[] none = arr(0);
    return none;
}

// the libraries that are inside the compiler: #import <name> needs no install
bool builtin_name(String n) {
    String[] b = "stdlib core number text files system time data crypto net math gfx cpu simd vector matrix quat complex stats canvas screen".split(" ");
    for i in 0..b.len {
        if b[i] == n { return true; }
    }
    return false;
}

int cmd_install(String name) {
    if builtin_name(name) {
        cout << name << " is part of the compiler: write  #import <" << name << ">  in your program; nothing to install" << nl;
        return 0;
    }
    if !name_ok(name) {
        err("jget: '" + name + "' is not a library name (letters, digits and _ only)\n");
        return 1;
    }
    String dir = lib_dir();
    if !make_dir(dir) { return 1; }
    String index = fetch_index(dir);
    if index.len == 0 { return 1; }
    String[] e = find_entry(index, name);
    if e.len < 4 {
        err("jget: the index has no library named '" + name + "' (try: jget list)\n");
        return 1;
    }
    String tmp = dir + "/." + name + ".tmp";
    if !download(e[2], tmp) { return 1; }
    switch Sha256::file(tmp) {
        Result::Ok(h): {
            if h != e[3] {
                Fs::remove(tmp);
                err("jget: the checksum of " + name + " does not match the index, nothing was installed\n");
                err("  index: " + e[3] + "\n");
                err("  file : " + h + "\n");
                return 1;
            }
        }
        Result::Err(er): {
            err("jget: cannot check the file: " + er.message + "\n");
            return 1;
        }
    }
    String target = dir + "/" + name + ".j";
    switch Fs::rename(tmp, target) {
        Result::Ok(x): { cout << "installed " << name << " " << e[1] << " in " << target << nl; return 0; }
        Result::Err(er): { err("jget: cannot install: " + er.message + "\n"); return 1; }
    }
    return 1;
}

int cmd_remove(String name) {
    if !name_ok(name) {
        err("jget: '" + name + "' is not a library name\n");
        return 1;
    }
    String target = lib_dir() + "/" + name + ".j";
    if !Fs::exists(target) {
        err("jget: " + name + " is not installed\n");
        return 1;
    }
    switch Fs::remove(target) {
        Result::Ok(x): { cout << "removed " << name << nl; return 0; }
        Result::Err(er): { err("jget: cannot remove: " + er.message + "\n"); return 1; }
    }
    return 1;
}

int cmd_list() {
    String dir = lib_dir();
    if !make_dir(dir) { return 1; }
    String index = fetch_index(dir);
    if index.len == 0 { return 1; }
    String[] lines = index.split("\n");
    for i in 0..lines.len {
        String line = lines[i].trim();
        if line.len == 0 || line.starts_with("#") { continue; }
        String[] w = line.split(" ");
        if w.len < 4 { continue; }
        String mark = " ";
        if Fs::exists(dir + "/" + w[0] + ".j") { mark = "*"; }
        cout << mark << " " << w[0] << " " << w[1] << nl;
    }
    return 0;
}

int cmd_installed() {
    String dir = lib_dir();
    switch Dir::list(dir) {
        Result::Ok(names): {
            for i in 0..names.len {
                if names[i].ends_with(".j") && !names[i].starts_with(".") {
                    cout << names[i].slice(0, names[i].len - 2) << nl;
                }
            }
            return 0;
        }
        Result::Err(er): { cout << "(no libraries installed)" << nl; return 0; }
    }
    return 0;
}

int usage() {
    err("usage: jget -h URL [-o FILE]            fetch the data at URL\n");
    err("       jget -li list | installed        libraries (the index / the installed ones)\n");
    err("       jget -li install NAME            install a library\n");
    err("       jget -li uninstall NAME          remove a library\n");
    return 1;
}

// jget -h URL [-o FILE]
int cmd_fetch(String[] av, int at) {
    if av.len <= at { return usage(); }
    String url = av[at];
    String to = "";
    if av.len > at + 1 {
        if av[at + 1] == "-o" && av.len > at + 2 { to = av[at + 2]; } else { return usage(); }
    }
    if download(url, to) { return 0; }
    return 1;
}

bool is_address(String s) {
    return s.starts_with("http://") || s.starts_with("https://") || s.starts_with("ftp://") || s.starts_with("file://");
}

int cmd_library(String[] av, int at) {
    if av.len <= at { return usage(); }
    String cmd = av[at];
    if cmd == "list" { return cmd_list(); }
    if cmd == "installed" { return cmd_installed(); }
    if cmd == "install" || cmd == "remove" || cmd == "uninstall" {
        if av.len <= at + 1 { return usage(); }
        String name = av[at + 1];
        if cmd == "install" { return cmd_install(name); }
        return cmd_remove(name);
    }
    return usage();
}

int main() {
    String[] av = Env::args();
    if av.len < 2 { return usage(); }
    String first = av[1];
    if first == "-h" { return cmd_fetch(av, 2); }
    if first == "--help" { usage(); return 0; }
    if first == "-li" { return cmd_library(av, 2); }
    if is_address(first) { return cmd_fetch(av, 1); }
    return cmd_library(av, 1);
}
