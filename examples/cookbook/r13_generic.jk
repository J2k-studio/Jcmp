// A generic struct and a lambda.
#import <stdlib>
using stdlib;

struct Pair<A, B> {
    A first;
    B second;
}

i64 apply_twice(i64(i64)^ f, i64 x) { return f(f(x)); }

i64 main() {
    Pair<String, i64> p;
    p.first = "age";
    p.second = 31;
    jout << p.first << "=" << p.second << "\n";
    jout << apply_twice(i64(i64 v) { return v * 3; }, 5) << "\n";
    return 0;
}
