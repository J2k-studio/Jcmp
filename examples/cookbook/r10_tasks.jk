// Work on several threads: a Task gives a value, a Channel carries values between threads.
#import <stdlib>
#import <cpu>
#import <tasks>
using stdlib;

i64 square(void^ arg) {
    i64 n = (i64)arg;
    return n * n;
}

i64 main() {
    Task a = Task::run(square, (void^)12);
    Task b = Task::run(square, (void^)7);
    jout << a.wait() + b.wait() << "\n";
    Channel<i64> c = Channel<i64>::make();
    c.send(5);
    c.send(6);
    c.close();
    i64 sum = 0;
    bool got = true;
    while got {
        i64 v = c.try_receive(@got);
        if got { sum += v; }
    }
    jout << sum << "\n";
    return 0;
}
