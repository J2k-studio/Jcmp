// Measure time, wait, and print dates.
#import <stdlib>
using stdlib;

i64 fib(i64 n) { if n < 2 { return n; } return fib(n - 1) + fib(n - 2); }

i64 main() {
    i64 t0 = Time::mono_ns();
    i64 f = fib(27);
    i64 ms = (Time::mono_ns() - t0) / 1000000;
    jout << "fib(27) = " << f << "\n";
    jout << "it took a measurable time: " << (ms >= 0) << "\n";
    Time::sleep_ms(20);
    jout << "slept\n";
    return 0;
}
