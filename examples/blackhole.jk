// An ASCII black hole: for every character a ray of light is followed from the eye; its path is bent by gravity.
// The glowing disk around the hole shows up twice (the light from behind it is bent over the top).
//   blackhole [frames]        (default 200 frames; a terminal of at least 100 x 37)
#import <stdlib>
#import <math>
#import <gfx>
using stdlib
using math::matrix;
using gfx::canvas;

// the brightness (0..1) of the disk at radius r, angle a, at time t: hotter inside, with turning arms
double disk_light(double r, double a, double t) {
    double inner = 2.6;
    double outer = 9.0;
    if r < inner || r > outer { return 0.0; }
    double edge = (outer - r) / (outer - inner);              // 1 inside, 0 outside
    double arms = 0.65 + 0.35 * Math::sin(3.0 * a - 2.0 * t + r * 0.9);
    return Math::min(1.0, Math::powi(edge, 2) * 1.3 * arms + 0.08);
}

// a star in the direction (x, y, z) now and then: the same direction always gives the same answer
char star_at(double x, double y, double z) {
    int i = (int)((x + 2.0) * 61.0);
    int j = (int)((y + 2.0) * 61.0);
    int k = (int)((z + 2.0) * 61.0);
    int h = (i * 73856093 xor j * 19349663 xor k * 83492791) & 65535;
    if h % 211 == 0 { return '*'; }
    if h % 97 == 0 { return '.'; }
    return ' ';
}

void main() {
    int frames = 200;
    String[] args = Env::args();
    if args.len > 1 { frames = Num::parse_int(args[1]).unwrap(); }
    String ramp = " .:-=+*#%@";
    Canvas c = Canvas::make(100, 37);
    int W = 100;
    int H = 37;
    // the eye: above the plane of the disk, looking at the hole
    mat3 look = mat3::rotate_x(0.30);
    vec3 eye0 = {0.0, 0.0, -17.0};
    vec3 eye = look.mul_vec(eye0);
    c.clear_screen();
    for frame in 0..frames {
        double t = (double)frame * 0.08;
        for cy in 0..H {
            for cx in 0..W {
                // the direction of the ray for this character
                double u = ((double)cx - (double)W / 2.0 + 0.5) / ((double)H * 2.0) * 1.5;
                double v = ((double)cy - (double)H / 2.0 + 0.5) / (double)H * 1.5;
                vec3 d0 = {u, v, 1.0};
                vec3 d = look.mul_vec(d0.normalize());
                // follow the ray in small steps; plain numbers because this is the hot loop
                double px = eye.x;
                double py = eye.y;
                double pz = eye.z;
                double vx = d.x;
                double vy = d.y;
                double vz = d.z;
                // h2: the square of the angular momentum (the pull on light depends on it)
                double hx = py * vz - pz * vy;
                double hy = pz * vx - px * vz;
                double hz = px * vy - py * vx;
                double h2 = hx * hx + hy * hy + hz * hz;
                double light = 0.0;
                char ch = ' ';
                bool done = false;
                int steps = 0;
                while !done && steps < 400 {
                    double r2 = px * px + py * py + pz * pz;
                    double r = Math::sqrt(r2);
                    if r < 1.0 {
                        done = true;                                   // inside the horizon: black
                        ch = ' ';
                    } else if r > 40.0 && (px * vx + py * vy + pz * vz) > 0.0 {
                        done = true;                                   // away for ever: a star, or dark space
                        ch = star_at(vx, vy, vz);
                    } else {
                        double step = 0.04 * r + 0.03;
                        double acc = 0.0 - 1.5 * h2 / (r2 * r2 * r);   // the bending of light (in units of the hole's radius)
                        vx += acc * px * step;
                        vy += acc * py * step;
                        vz += acc * pz * step;
                        double ny = py + vy * step;
                        double nx = px + vx * step;
                        double nz = pz + vz * step;
                        if (py > 0.0 && ny <= 0.0) || (py < 0.0 && ny >= 0.0) {
                            // the ray goes through the plane of the disk
                            double rd = Math::sqrt(nx * nx + nz * nz);
                            double l = disk_light(rd, Math::atan2(nz, nx), t);
                            if l > light { light = l; }
                        }
                        px = nx;
                        py = ny;
                        pz = nz;
                    }
                    steps += 1;
                }
                if light > 0.0 {
                    int k = (int)(light * 9.0);
                    if k > 9 { k = 9; }
                    ch = ramp[k];
                }
                c.put(cx, cy, ch);
            }
        }
        c.show();
        Time::sleep_ms(30);
    }
}
