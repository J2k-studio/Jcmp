// wc: count lines, words and bytes of the file named by the first argument.
#import <stdlib>
using stdlib;
using stdlib::fs;

char data[65536];

bool is_space(i64 c) {
    return c == 32 || c == 10 || c == 9 || c == 13;
}

void main() {
    if argc() < 2 {
        jout << "usage: wc file\n";
        return;
    }
    i32 f = File::open(arg(1), FileMode::Read);
    if f < 0 {
        jout << "cannot open file\n";
        return;
    }
    i64 size = File::read(f, data);
    File::close(f);
    i64 lines = 0;
    i64 words = 0;
    bool in_word = false;
    i64 i = 0;
    while i < size {
        i64 c = data[i];
        if c == 10 { lines += 1; }
        if is_space(c) {
            in_word = false;
        } else if !in_word {
            in_word = true;
            words += 1;
        }
        i += 1;
    }
    jout << lines << " " << words << " " << size << "\n";
}
