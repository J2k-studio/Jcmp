// The solar system in colour: planets on ellipses (Kepler's law), each ball lit by the sun with its own surface
// (continents and clouds on the Earth, bands and the red spot on Jupiter, the rings of Saturn), moons,
// an asteroid belt, a glowing sun and twinkling stars.
//   solar            runs until you press Ctrl-C (or Enter)
//   solar 300        stops after 300 frames
// Needs a terminal with 24-bit colour (Termux has it); the picture takes the size of the terminal.
#import <stdlib>
#import <math>
#import <gfx>
using stdlib
using math::matrix;
using gfx::screen;

// where a planet is on its ellipse: semi-major axis a, eccentricity e, period p, at time t
// (Kepler's equation  E - e sin E = M  solved by Newton's method; the sun is at one focus)
vec3 kepler(double a, double e, double p, double t, double phase) {
    double m = Math::tau() * t / p + phase;
    double big_e = m;
    for i in 0..6 {
        big_e = big_e - (big_e - e * Math::sin(big_e) - m) / (1.0 - e * Math::cos(big_e));
    }
    vec3 pos = {a * (Math::cos(big_e) - e), 0.0, a * Math::sqrt(1.0 - e * e) * Math::sin(big_e)};
    return pos;
}

// a smooth pattern between about 0 and 1 (sums of waves): the surfaces are made of it
double wave(double x, double y) {
    return 0.5 + 0.26 * Math::sin(x * 1.7 + y * 0.6) + 0.17 * Math::sin(x * 3.9 - y * 2.3 + 1.0) + 0.1 * Math::sin(y * 5.1 + x * 0.7 + 2.0);
}

double mix(double a, double b, double f) {
    return a + (b - a) * f;
}

// the colour of a ball at a point of its surface: kind 0 Mercury, 1 Venus, 2 Earth, 3 Mars, 4 Jupiter, 5 Saturn, 6 Moon
// (lon, lat: the place on the ball; lit: 0..1 how much the sun shines there; rim: 0..1 near the edge)
int surface(int kind, double lon, double lat, double lit, double rim) {
    double r = 150.0;
    double g = 150.0;
    double b = 150.0;
    double glow_r = 0.0;
    double glow_g = 0.0;
    double glow_b = 0.0;
    if kind == 0 {
        double w = wave(lon * 3.0, lat * 4.0);
        r = 95.0 + 85.0 * w;
        g = 90.0 + 80.0 * w;
        b = 85.0 + 75.0 * w;
    } else if kind == 1 {
        double v = 0.5 + 0.5 * Math::sin(lat * 7.0 + 1.6 * Math::sin(lon * 2.0 + lat * 3.0));
        r = 214.0 + 30.0 * v;
        g = 170.0 + 35.0 * v;
        b = 100.0 + 40.0 * v;
        glow_r = 80.0 * rim;
        glow_g = 60.0 * rim;
        glow_b = 20.0 * rim;
    } else if kind == 2 {
        double land = wave(lon * 2.1, lat * 3.2);
        if land > 0.6 {
            double k = Math::clamp((land - 0.6) * 5.0, 0.0, 1.0);
            r = mix(60.0, 140.0, k);
            g = mix(125.0, 110.0, k);
            b = mix(55.0, 70.0, k);
        } else {
            r = 18.0;
            g = 62.0 + 25.0 * land;
            b = 150.0 + 40.0 * land;
        }
        if Math::abs(lat) > 0.86 {
            r = 235.0;
            g = 240.0;
            b = 245.0;
        }
        double cloud = wave(lon * 3.3 + 1.0, lat * 6.0 + 2.0);
        if cloud > 0.66 {
            double k = Math::clamp((cloud - 0.66) * 4.0, 0.0, 0.8);
            r = mix(r, 245.0, k);
            g = mix(g, 245.0, k);
            b = mix(b, 250.0, k);
        }
        glow_r = 30.0 * rim;
        glow_g = 90.0 * rim;
        glow_b = 255.0 * rim;
    } else if kind == 3 {
        double w = wave(lon * 2.7, lat * 3.7);
        r = 150.0 + 70.0 * w;
        g = 70.0 + 45.0 * w;
        b = 40.0 + 25.0 * w;
        if lat < -0.9 {
            r = 240.0;
            g = 235.0;
            b = 230.0;
        }
        glow_r = 60.0 * rim;
        glow_g = 25.0 * rim;
        glow_b = 10.0 * rim;
    } else if kind == 4 {
        double band = Math::sin(lat * 17.0 + 0.5 * Math::sin(lon * 3.0 + lat * 5.0));
        double k = 0.5 + 0.5 * band;
        r = mix(160.0, 238.0, k);
        g = mix(105.0, 214.0, k);
        b = mix(70.0, 178.0, k);
        double dl = lon - 1.2;
        double dt = (lat - 0.32) * 2.2;
        if dl * dl + dt * dt < 0.09 {
            r = 190.0;
            g = 80.0;
            b = 55.0;
        }
    } else if kind == 5 {
        double band = Math::sin(lat * 13.0 + 0.3 * Math::sin(lon * 2.0));
        double k = 0.5 + 0.5 * band;
        r = mix(196.0, 236.0, k);
        g = mix(166.0, 212.0, k);
        b = mix(112.0, 158.0, k);
    } else {
        double w = wave(lon * 5.0, lat * 6.0);
        r = 120.0 + 90.0 * w;
        g = 118.0 + 88.0 * w;
        b = 115.0 + 86.0 * w;
    }
    double f = 0.05 + 1.12 * lit;
    r = r * f + glow_r * lit;
    g = g * f + glow_g * lit;
    b = b * f + glow_b * lit * 1.0;
    return Screen::rgb(Math::min_int(255, (int)r), Math::min_int(255, (int)g), Math::min_int(255, (int)b));
}

// a ball of radius rad dots at (cx, cy); (lx, ly, lz) points to the sun; spin turns it
void ball(Screen^ s, double cx, double cy, double rad, int kind, double lx, double ly, double lz, double spin) {
    int x0 = Math::max_int(0, (int)(cx - rad) - 1);
    int x1 = Math::min_int(s^.w - 1, (int)(cx + rad) + 1);
    int y0 = Math::max_int(0, (int)(cy - rad) - 1);
    int y1 = Math::min_int(s^.h - 1, (int)(cy + rad) + 1);
    for y in y0..y1 + 1 {
        for x in x0..x1 + 1 {
            double dx = ((double)x + 0.5 - cx) / rad;
            double dy = ((double)y + 0.5 - cy) / rad;
            double d2 = dx * dx + dy * dy;
            if d2 <= 1.0 {
                double nz = 0.0 - Math::sqrt(1.0 - d2);
                double lit = dx * lx + dy * ly + nz * lz;
                lit = Math::clamp((lit + 0.04) / 1.04, 0.0, 1.0);
                double rim = Math::pow(1.0 - Math::abs(nz), 3.0);
                double lon = Math::atan2(dx, 0.0 - nz) + spin;
                int c = surface(kind, lon, dy, lit, rim);
                double cover = Math::clamp((1.0 - Math::sqrt(d2)) * rad, 0.0, 1.0);
                if cover >= 1.0 {
                    s^.set_packed(x, y, c);
                } else {
                    s^.blend(x, y, (c >> 16) & 255, (c >> 8) & 255, c & 255, cover);
                }
            }
        }
    }
}

// the sun: a hot disk, darker towards the edge, with a corona that fades out
void sun_ball(Screen^ s, double cx, double cy, double rad) {
    double reach = rad * 3.6;
    int x0 = Math::max_int(0, (int)(cx - reach));
    int x1 = Math::min_int(s^.w - 1, (int)(cx + reach));
    int y0 = Math::max_int(0, (int)(cy - reach));
    int y1 = Math::min_int(s^.h - 1, (int)(cy + reach));
    for y in y0..y1 + 1 {
        for x in x0..x1 + 1 {
            double dx = (double)x + 0.5 - cx;
            double dy = (double)y + 0.5 - cy;
            double d = Math::sqrt(dx * dx + dy * dy) / rad;
            if d <= 1.0 {
                double mu = Math::sqrt(1.0 - d * d);
                double limb = 0.55 + 0.45 * mu;
                double spots = 0.93 + 0.07 * Math::sin(dx * 1.3) * Math::sin(dy * 1.1 + 1.0);
                s^.set(x, y, Math::min_int(255, (int)(255.0 * limb * spots)), Math::min_int(255, (int)(228.0 * limb * limb * spots)), (int)(150.0 * limb * limb * limb * spots));
            } else {
                double a = 0.55 / (d * d) * Math::clamp((3.6 - d) / 2.6, 0.0, 1.0);
                if a > 0.004 {
                    s^.add(x, y, (int)(255.0 * a), (int)(170.0 * a), (int)(70.0 * a));
                }
            }
        }
    }
}

// the rings of Saturn: ellipses around the planet at (px, py), tilted; front = 0 draws the half behind the ball,
// 1 the half in front of it; rad: the radius of the ball in dots
void rings(Screen^ s, double px, double py, double rad, int front) {
    double ca = Math::cos(0.42);
    double sa = Math::sin(0.42);
    for k in 0..900 {
        double ang = (double)k * Math::tau() / 900.0;
        for rr in 0..14 {
            double radius = rad * (1.35 + (double)rr * 0.075);
            if rr != 7 {                                                             // a gap in the rings
                double ex = radius * Math::cos(ang);
                double ey = radius * Math::sin(ang) * 0.33;
                int x = (int)(px + ex * ca - ey * sa);
                int y = (int)(py + ex * sa + ey * ca);
                int is_front = 0;
                if Math::sin(ang) > 0.0 { is_front = 1; }
                if is_front == front && x >= 0 && x < s^.w && y >= 0 && y < s^.h {
                    double shade = 0.72 + 0.28 * Math::sin((double)rr * 1.9);
                    s^.set(x, y, (int)(226.0 * shade), (int)(202.0 * shade), (int)(152.0 * shade));
                }
            }
        }
    }
}

void main() {
    int frames = 0;                                   // 0: until Ctrl-C or Enter
    String[] args = Env::args();
    if args.len > 1 {
        switch Num::parse_int(args[1]) {
            Result::Ok(v): frames = v;
            Result::Err(e): {
                cout << "usage: solar [frames]\n";
                return;
            }
        }
    }
    int w = Math::min_int(Term::cols(), 120);
    int h = Math::min_int((Term::rows() - 1) * 2, 80);
    if w < 20 || h < 10 {                                     // not a terminal (a pipe): a fixed size
        w = 100;
        h = 70;
    }
    Screen s = Screen::make(w, h);
    // the planets: Mercury Venus Earth Mars Jupiter Saturn
    double axis[6] = {4.5, 7.0, 9.5, 12.5, 16.5, 20.0};      // the size of the orbit
    double ecc[6] = {0.21, 0.01, 0.02, 0.09, 0.05, 0.06};    // how far from a circle
    double size[6] = {0.42, 0.62, 0.66, 0.5, 1.25, 1.0};     // the radius of the ball
    // stars in fixed places
    int star_x[160];
    int star_y[160];
    int star_c[160];
    int seed = 12345;
    for i in 0..160 {
        seed = (seed * 1103515245 + 12345) & 2147483647;
        star_x[i] = (seed >> 8) % w;
        seed = (seed * 1103515245 + 12345) & 2147483647;
        star_y[i] = (seed >> 8) % s.h;
        seed = (seed * 1103515245 + 12345) & 2147483647;
        star_c[i] = (seed >> 8) % 3;
    }
    // the asteroid belt: between Mars and Jupiter
    double belt_r[260];
    double belt_a[260];
    for i in 0..260 {
        seed = (seed * 1103515245 + 12345) & 2147483647;
        belt_r[i] = 14.0 + (double)((seed >> 8) % 1000) / 1000.0 * 1.4;
        seed = (seed * 1103515245 + 12345) & 2147483647;
        belt_a[i] = (double)((seed >> 8) % 6283) / 1000.0;
    }
    double sc = Math::min((double)(w / 2 - 3) / 22.5, (double)(s.h / 2 - 3) / 21.0);
    double cx = (double)w / 2.0;
    double cy = (double)s.h / 2.0;
    s.begin();
    int frame = 0;
    while frames == 0 || frame < frames {
        double t = (double)frame * 0.05;
        mat3 tilt = mat3::rotate_x(1.05 + 0.18 * Math::sin(t * 0.25));       // the view nods slowly
        s.clear(2, 3, 9);
        s.gradient_v(2, 2, 10, 7, 5, 16);
        for i in 0..160 {
            double tw = 0.55 + 0.45 * Math::sin((double)frame * 0.13 + (double)i * 1.7);
            int v = (int)(150.0 * tw);
            if star_c[i] == 0 { s.set(star_x[i], star_y[i], v, v, v); }
            if star_c[i] == 1 { s.set(star_x[i], star_y[i], v * 8 / 10, v * 9 / 10, v); }
            if star_c[i] == 2 { s.set(star_x[i], star_y[i], v, v * 9 / 10, v * 7 / 10); }
        }
        // the orbits: faint lines
        for i in 0..6 {
            for k in 0..360 {
                double ang = (double)k * Math::tau() / 360.0;
                vec3 o = {axis[i] * (Math::cos(ang) - ecc[i]), 0.0, axis[i] * Math::sqrt(1.0 - ecc[i] * ecc[i]) * Math::sin(ang)};
                vec3 q = tilt.mul_vec(o);
                int px = (int)(cx + q.x * sc);
                int py = (int)(cy + q.y * sc);
                if px >= 0 && px < s.w && py >= 0 && py < s.h { s.set(px, py, 24 + i, 30 + i * 2, 52 + i * 3); }
            }
        }
        for i in 0..260 {
            double a = belt_a[i] + t * 0.9 / (belt_r[i] * Math::sqrt(belt_r[i])) * 8.0;
            vec3 b = {belt_r[i] * Math::cos(a), 0.0, belt_r[i] * Math::sin(a)};
            vec3 q = tilt.mul_vec(b);
            int px = (int)(cx + q.x * sc);
            int py = (int)(cy + q.y * sc);
            if px >= 0 && px < s.w && py >= 0 && py < s.h { s.set(px, py, 120, 108, 96); }
        }
        // the bodies: 0 the sun, 1..6 the planets, 7 the Moon, 8 and 9 two moons of Jupiter
        double bx[10];
        double by[10];
        double bz[10];
        double br[10];
        int bk[10];
        bx[0] = 0.0;
        by[0] = 0.0;
        bz[0] = 0.0;
        br[0] = Math::max(3.5, 3.0 * sc * 0.75);
        bk[0] = 100;
        vec3 ppos[6];
        for i in 0..6 {
            double period = 0.27 * axis[i] * Math::sqrt(axis[i]);
            vec3 pos = kepler(axis[i], ecc[i], period, t, (double)i * 1.3);
            ppos[i] = pos;
            vec3 q = tilt.mul_vec(pos);
            bx[i + 1] = q.x;
            by[i + 1] = q.y;
            bz[i + 1] = q.z;
            br[i + 1] = Math::max(1.5, size[i] * sc * 2.1);
            bk[i + 1] = i;
        }
        double ma = t * 3.2;
        vec3 mp = {ppos[2].x + 1.5 * Math::cos(ma), 0.0, ppos[2].z + 1.5 * Math::sin(ma)};
        vec3 mq = tilt.mul_vec(mp);
        bx[7] = mq.x;
        by[7] = mq.y;
        bz[7] = mq.z;
        br[7] = Math::max(0.9, 0.24 * sc * 2.1);
        bk[7] = 6;
        for j in 0..2 {
            double ja = t * (2.0 + (double)j * 1.3) + (double)j * 2.0;
            double jr = 2.6 + (double)j * 1.1;
            vec3 jp = {ppos[4].x + jr * Math::cos(ja), 0.0, ppos[4].z + jr * Math::sin(ja)};
            vec3 jq = tilt.mul_vec(jp);
            bx[8 + j] = jq.x;
            by[8 + j] = jq.y;
            bz[8 + j] = jq.z;
            br[8 + j] = Math::max(0.9, 0.2 * sc * 2.1);
            bk[8 + j] = 6;
        }
        // painter's order: the far ones first (a bigger z is farther)
        int order[10];
        for i in 0..10 { order[i] = i; }
        for i in 1..10 {
            int cur = order[i];
            int j = i - 1;
            while j >= 0 && bz[order[j]] < bz[cur] {
                order[j + 1] = order[j];
                j -= 1;
            }
            order[j + 1] = cur;
        }
        for oi in 0..10 {
            int i = order[oi];
            double px = cx + bx[i] * sc;
            double py = cy + by[i] * sc;
            if bk[i] == 100 {
                sun_ball(@s, px, py, br[i]);
            } else {
                double dx = 0.0 - bx[i];
                double dy = 0.0 - by[i];
                double dz = 0.0 - bz[i];
                double dn = Math::sqrt(dx * dx + dy * dy + dz * dz);
                dx = dx / dn * 0.8;
                dy = dy / dn * 0.8 - 0.1;
                dz = dz / dn * 0.8 - 0.35;                      // a little light from our side: the night side is not black
                dn = Math::sqrt(dx * dx + dy * dy + dz * dz);
                double spin = t * (1.5 + (double)bk[i] * 0.4);
                if bk[i] == 5 { rings(@s, px, py, br[i], 0); }
                ball(@s, px, py, br[i], bk[i], dx / dn, dy / dn, dz / dn, spin);
                if bk[i] == 5 { rings(@s, px, py, br[i], 1); }
            }
        }
        s.glow(0.30);
        s.vignette(0.35);
        s.show();
        cout << " Mercury Venus Earth Mars Jupiter Saturn   (Ctrl-C or Enter to stop)\n";
        if frames == 0 && Term::key_pressed() { break; }
        Time::sleep_ms(20);
        frame += 1;
    }
    s.end();
}
