// jcmp.jk -- the J2K compiler written in J2K: the four parts, joined.
// Build:  bin/jcmp jcmp/jcmp.jk -o jcmp1        (see bootstrap.sh)
// Use:    jcmp1 input.jk -o program
// the version of the compiler (also in the file VERSION; release.sh checks that they agree)
#allow syscall                         // the compiler is the layer under Sys: it calls the system by number on purpose
#define JCMP_VERSION "1.2.2.0"

#import "jc_base"
#import "jc_asm"
#import "jc_lex"
#import "jc_std"
#import "jc_expr"
#import "jc_low"
#import "jc_ast"
#import "jc_stmt"
#import "jc_gen"
#import "jc_regs"
#import "jc_ir"
#import "jc_opt"
#import "jc_lift"
#import "jc_par"
#import "jc_astlow"
#import "jc_a32"
#import "jc_vec"
#import "jc_peep"
#import "jc_cache"
#import "jc_jh"
#import "jc_logo"

// ------------------------------------------------ the program (main lives here, not in a .j part)

// the state that every pass starts again from
void reset_state(char^ in_path) {
    ft_count = 0;
    out_len = 0;
    gcount = 0;
    int gz = 0;
    while gz < 65536 { gt_tab[gz] = 0; gz += 1; }          // the hash table of the globals goes with gcount
    gl_bytes = 66432;           // 864: the file of cout, 872: the divide flag, 880: bytes in the output buffer, 888: its mode, 896: the buffer (64 KB)                      // slot 0: initial sp; 8..71: arguments 9..16 of a call; 72..863: exceptions; 864: the file of cout/cerr minus 1 (0: the standard output); 872: ARM32: 1 when the CPU has udiv / sdiv
    ginit_count = 0;
    gsi_count = 0;
    gfi_count = 0;
    label_no = 0;
    lcount = 0;
    cur_fidx = 0 - 1;
    used_fprint = 0;
    used_oob = 0;
    old_float_warned = 0;
    using_warned = 0;
    uf_n = 0;                            // the single functions opened by `using Fs::fs.read;` are opened again in each pass
    io_float_warned = 0;
    import_warned = 0;
    import_bare_warned = 0;
    using_std_seen = 0;
    io_warned = 0;
    used_divz = 0;
    used_noret = 0;
    used_uprint = 0;
    used_try = 0;
    used_thread = 0;
    lex_init(in_path);
    next();
}

// -xtime: the milliseconds since the last stage
void tm_stage(char^ name) {
    if prog_on == 1 { prog_stage(name); }
    if x_time == 0 { return; }
    int now = tm_now();
    if tm_last != 0 {
        write_err("  ");
        write_err(name);
        write_err(": ");
        write_err_int((now - tm_last) / 1000);
        write_err(" ms\n");
    }
    tm_last = now;
}

void usage() {
    write_err("usage: jcmp input.jk [-o output] [-d] [-st] [-I dir] [--emit-asm file.jasm]\n");
    write_err("       jcmp -help      (all options)      jcmp -version\n");
    syscall(93, 1);
}

// the short help (jcmp -help)
void help() {
    write_out("jcmp ");
    write_out(JCMP_VERSION);
    write_out(" - the J2K compiler (Linux ARM64)\n\n");
    write_out("usage: jcmp input.jk [-o output] [options]      (without -o the program is named like the source: test.jk -> test)\n\n");
    write_out("  -o file          write the program to file\n");
    write_out("  -d               debug build: array bounds checks, memory leak report\n");
    write_out("  -st              strict: warnings are errors\n");
    write_out("  -I dir           also look for imported files in dir\n");
    write_out("  -emit-asm file   also write the assembler text\n");
    write_out("  -l               make a shared library (.so): the functions marked  export  are its entry points\n");
    write_out("  -dyn             make a dynamic executable (it can load the libraries of the system: libvulkan.so, libEGL.so ... with the library native)\n");
    write_out("  -progress FILE   write the percent of the compile into FILE (makej shows it as a bar)\n");
    write_out("  -j N             work on N processes in the long passes (a big program; the default is the cores this process may use; -j 1 = one)\n");
    write_out("  -show name       write the code of the function name as it is in the program (ARM64) and how many instructions it has; nothing else is written\n");
    write_out("  -jh file         write the interface of a file (its declarations without the bodies); -api name: of a library\n");
    write_out("  -cache dir       keep the code of the functions that did not change in dir (J2K_CACHE=dir for every build); -nocache: not; -clean dir: delete a cache\n");
    write_out("  -update [version] replace the compiler and its library (as a pair) by the latest release, or by the given version\n");
    write_out("  -showlib name    write the source of a library that is inside the compiler (net, text, math ...) and stop\n");
    write_out("  -nofma           do not fuse a * b + c into one instruction (the last bit of the result may differ with it)\n");
    write_out("  -color           coloured messages (the default when stderr is a terminal)\n");
    write_out("  -nocolor         plain messages\n");
    write_out("  -version         print the version\n");
    write_out("  -help            this text\n\n");
    write_out("example: jcmp hello.jk -o hello && ./hello\n");
    syscall(93, 0);
}

// a long option written with one or two dashes: -version  or  --version
bool is_opt(char^ a, char^ name) {
    if a[0] != '-' { return false; }
    int k = 1;
    if a[1] == '-' { k = 2; }
    int i = 0;
    while name[i] != 0 {
        if a[k + i] != name[i] { return false; }
        i += 1;
    }
    return a[k + i] == 0;
}

char^ x_pre;
char^ x_cachestat;
char^ x_cachedir;
char cache_default[300];
int cache_auto;
int x_nocache;

// "address name" for every label of the program that was just assembled (the code starts at 0x4000B0)
char map_buf[4000000];

void write_label_map(char^ path) {
    int cap = 4000000;
    char^ buf = @map_buf;
    int n = 0;
    int sl = 0;
    while sl < as_label_count && n < cap - 200 {
        if as_laddr[sl] >= 0 {
            int a = 4194480 + as_laddr[sl];
            int k = 0;
            while k < 8 {
                int nib = (a >> (28 - k * 4)) & 15;
                if nib < 10 { buf[n] = '0' + nib; } else { buf[n] = 'a' + nib - 10; }
                n += 1;
                k += 1;
            }
            buf[n] = ' ';
            n += 1;
            k = 0;
            while k < 64 && as_lnames[sl * 64 + k] != 0 {
                buf[n] = as_lnames[sl * 64 + k];
                n += 1;
                k += 1;
            }
            buf[n] = 10;
            n += 1;
        }
        sl += 1;
    }
    write_file(path, buf, n);
}

// -show NAME: the lines of the function NAME in the final assembler text, then the number of instructions (lines that are not labels, directives or comments)
void show_function(char^ name) {
    int nl = str_len(name);
    int p = 0;
    int start = 0 - 1;
    while p < out_len {
        int e = p;
        while e < out_len && out_buf[e] != 10 { e += 1; }
        if e - p == nl + 1 && out_buf[e - 1] == ':' {
            int k = 0;
            while k < nl && out_buf[p + k] == name[k] { k += 1; }
            if k == nl {
                start = p;
                break;
            }
        }
        p = e + 1;
    }
    if start < 0 {
        write_err("jcmp: -show: there is no function ");
        write_err(name);
        write_err(" in the program (a function that nobody calls is not made; on ARM32 there is no text)\n");
        syscall(93, 1);
    }
    int count = 0;
    p = start;
    bool first = true;
    while p < out_len {
        int e2 = p;
        while e2 < out_len && out_buf[e2] != 10 { e2 += 1; }
        bool label = out_buf[e2 - 1] == ':';
        bool localab = label && out_buf[p] == 'L' && out_buf[p + 1] >= '0' && out_buf[p + 1] <= '9';
        if !first && ((label && !localab) || out_buf[p] == '.') { break; }
        first = false;
        if out_buf[p] == ';' {
            p = e2 + 1;
            continue;
        }
        syscall(64, 1, @out_buf + p, e2 - p + 1);
        if !label { count += 1; }
        p = e2 + 1;
    }
    char num[24];
    int nn = 0;
    int cv = count;
    if cv == 0 {
        num[0] = '0';
        nn = 1;
    }
    char rv[24];
    int rk = 0;
    while cv > 0 {
        rv[rk] = '0' + cv % 10;
        cv = cv / 10;
        rk += 1;
    }
    while rk > 0 {
        rk -= 1;
        num[nn] = rv[rk];
        nn += 1;
    }
    num[nn] = 0;
    write_out("// ");
    write_out(@num);
    write_out(" instructions\n");
}

// the number of instructions of the function NAME in the final assembler text (-1: it is not there: inlined everywhere, or never called)
int count_instructions(char^ name) {
    int nl = str_len(name);
    int p = 0;
    int start = 0 - 1;
    while p < out_len {
        int e = p;
        while e < out_len && out_buf[e] != 10 { e += 1; }
        if e - p == nl + 1 && out_buf[e - 1] == ':' {
            int k = 0;
            while k < nl && out_buf[p + k] == name[k] { k += 1; }
            if k == nl {
                start = p;
                break;
            }
        }
        p = e + 1;
    }
    if start < 0 { return 0 - 1; }
    int count = 0;
    p = start;
    bool first = true;
    while p < out_len {
        int e2 = p;
        while e2 < out_len && out_buf[e2] != 10 { e2 += 1; }
        bool label = out_buf[e2 - 1] == ':';
        bool localab = label && out_buf[p] == 'L' && out_buf[p + 1] >= '0' && out_buf[p + 1] <= '9';
        if !first && ((label && !localab) || out_buf[p] == '.') { break; }
        first = false;
        if out_buf[p] != ';' && !label { count += 1; }
        p = e2 + 1;
    }
    return count;
}

// #expect instructions <= N : every function that has a limit is looked at (ARM64: the text; ARM32: the code between two functions)
void check_expectations() {
    int f = 0;
    while f < fcount {
        if fexp_n[f] > 0 {
            int got = 0 - 1;
            if x_target == 32 { got = a32_instr_count(@fname + f * 64); } else { got = count_instructions(@fname + f * 64); }
            if got > fexp_n[f] {
                write_err(@fexp_file + f * 128);
                write_err(":");
                char nb[24];
                int nn = 0;
                int lv = fexp_line[f];
                char rv[24];
                int rk = 0;
                if lv == 0 { nb[0] = '0'; nn = 1; }
                while lv > 0 { rv[rk] = '0' + lv % 10; lv = lv / 10; rk += 1; }
                while rk > 0 { rk -= 1; nb[nn] = rv[rk]; nn += 1; }
                nb[nn] = 0;
                write_err(@nb);
                write_err(":1: error: the function '");
                write_err(@fname + f * 64);
                write_err("' is made of ");
                char gb[24];
                int gn = 0;
                int gv = got;
                int gk = 0;
                if gv == 0 { gb[0] = '0'; gn = 1; }
                while gv > 0 { rv[gk] = '0' + gv % 10; gv = gv / 10; gk += 1; }
                while gk > 0 { gk -= 1; gb[gn] = rv[gk]; gn += 1; }
                gb[gn] = 0;
                write_err(@gb);
                write_err(" instructions, but  #expect  allows ");
                char lb[24];
                int ln = 0;
                int lw = fexp_n[f];
                int lk = 0;
                while lw > 0 { rv[lk] = '0' + lw % 10; lw = lw / 10; lk += 1; }
                while lk > 0 { lk -= 1; lb[ln] = rv[lk]; ln += 1; }
                lb[ln] = 0;
                write_err(@lb);
                write_err(" at most\n  help: look at the code with  jcmp FILE -show NAME  (a function that is inlined into another one counts there)\n");
                err_count += 1;
            }
        }
        f += 1;
    }
    if err_count > 0 { syscall(93, 1); }
}

void main() {
    char^ in_path = null;
    char^ out_elf = null;
    char^ out_asm = null;
    int ai = 1;
    char termios[64];
    if syscall(29, 2, 21505, @termios) == 0 { use_color = 1; }       // standard error is a terminal: colours
    while ai < argc() {
        char^ a = arg(ai);
        if str_eq(a, "-o") {
            ai += 1;
            if ai >= argc() { usage(); }
            out_elf = arg(ai);
        } else if is_opt(a, "version") || str_eq(a, "-v") || str_eq(a, "-V") {
            write_out("jcmp ");
            write_out(JCMP_VERSION);
            write_out(" (J2K compiler, Linux ARM64)\n");
            syscall(93, 0);
        } else if is_opt(a, "help") || str_eq(a, "-h") || str_eq(a, "-?") {
            help();
        } else if is_opt(a, "color") {
            use_color = 1;
        } else if is_opt(a, "nocolor") {
            use_color = 0;
        } else if str_eq(a, "-space") || str_eq(a, "-spcae") || str_eq(a, "-speac") {
            // the mascot (not in -help); an optional number after it: how many times faster than real time (default 1800)
            // pixels with colour by default (ASCII if the terminal has no 24-bit colour); "ascii": always characters; "pxg": pixels in white, grey and black
            lg_px = 1;
            int lg_speed = 0;
            int lg_arg = 1;
            while lg_arg <= 2 && ai + lg_arg < argc() {
                char^ sp = arg(ai + lg_arg);
                if str_eq(sp, "px") { lg_px = 1; }
                else if str_eq(sp, "ascii") { lg_px = 0; }
                else if str_eq(sp, "pxg") { lg_px = 2; }
                else {
                    int sk = 0;
                    while sp[sk] >= '0' && sp[sk] <= '9' && sk < 8 {
                        lg_speed = lg_speed * 10 + (sp[sk] - '0');
                        sk += 1;
                    }
                }
                lg_arg += 1;
            }
            lg_run(0, lg_speed);
            syscall(93, 0);
        } else if str_eq(a, "-update") {
            char^ upv = null;
            if ai + 1 < argc() { upv = arg(ai + 1); }
            self_update(upv);
        } else if str_eq(a, "-showlib") {
            ai += 1;
            if ai >= argc() { write_err("jcmp: -showlib needs the name of a library (stdlib, core, number, text, files, system, time, data, crypto, net, math, gfx, cpu, simd, vector, matrix, quat, complex, stats, canvas, screen)\n"); syscall(93, 1); }
            lib_init(JCMP_VERSION);
            if !show_library(arg(ai)) { write_err("jcmp: there is no library inside the compiler with this name; the libraries inside are: stdlib, core, number, text, files, system, time, data, crypto, net, math, gfx, cpu, simd, vector, matrix, quat, complex, stats, canvas, screen\n"); syscall(93, 1); }
            syscall(93, 0);
        } else if str_eq(a, "-dyn") {
            x_lib = 1;                      // a dynamic executable: the layout of a shared library with an interpreter, libdl.so and libc.so, and a main
            x_dyn = 1;
        } else if str_eq(a, "-l") {
            x_lib = 1;                      // a shared library (.so); the functions marked `export` are its entry points
        } else if str_eq(a, "-d") {
            opt_debug = 1;
        } else if str_eq(a, "-irtest") {
            ir_selftest();
            syscall(93, 0);
        } else if str_eq(a, "-irstat") {
            ir_mode = 1;
        } else if str_eq(a, "-target") {
            ai += 1;
            if ai >= argc() { usage(); }
            if str_eq(arg(ai), "arm32") {
                x_target = 32;
                ir_mode = 2;
                ir_opt = 1 | 4 | 8 | 32 | 64 | 128 | 4096 | 32768 | 67108864 | 8388608 | 268435456 | 1073741824;          // the passes on the IR that do not need the ARM64 registers, with the vectorizer (NEON) and the pointers of the array loops (not the register allocator, the inlining, the hoisting of loads)
                ir_pre = 0;
                inl_off = 1;
                x_nocache = 1;
            } else if !str_eq(arg(ai), "arm64") {
                write_err("jcmp: -target takes arm64 (the default) or arm32\n");
                syscall(93, 1);
            }
        } else if str_eq(a, "-xdirect") {
            ai += 1;
            char^ dxv = arg(ai);
            int dxk = 0;
            int dxn = 0;
            while dxv[dxk] >= '0' && dxv[dxk] <= '9' {
                dxn = dxn * 10 + (dxv[dxk] - '0');
                dxk += 1;
            }
            a32_direct = dxn;             // hidden: which direct register paths of the ARM32 back end are on (to find a mistake)
        } else if str_eq(a, "-xnoireg") {
            a32_noireg = 1;               // hidden: ARM32 keeps every whole number vreg in the frame
        } else if str_eq(a, "-xnodreg") {
            a32_nodreg = 1;               // hidden: ARM32 keeps every double in the frame
        } else if str_eq(a, "-xnoelide") {
            a32_elide_off = 1;            // hidden: ARM32 keeps every store
        } else if str_eq(a, "-noir") {
            ir_mode = 0;
        } else if str_eq(a, "-irtrip") {
            ir_mode = 2;
            ir_opt = 0;
            ir_pre = 0;
        } else if str_eq(a, "-irlicm") {
            ir_mode = 2;
            ir_opt = ir_opt | 1;
        } else if str_eq(a, "-novec") {
            opt_novec = 1;
        } else if str_eq(a, "-stp") {
            fr_on = 1;
        } else if str_eq(a, "-iropt") {
            ir_mode = 2;
            ir_opt = ir_opt | 44;
            ir_pre = 1;
        } else if str_eq(a, "-irdbg") {
            ai += 1;
            char^ dv = arg(ai);
            int dk = 0;
            int dn = 0;
            while dv[dk] >= '0' && dv[dk] <= '9' {
                dn = dn * 10 + (dv[dk] - '0');
                dk += 1;
            }
            ir_opt = ir_opt | dn;
        } else if str_eq(a, "-irclr") {
            ai += 1;
            char^ cv = arg(ai);
            int ck = 0;
            int cn = 0;
            while cv[ck] >= '0' && cv[ck] <= '9' {
                cn = cn * 10 + (cv[ck] - '0');
                ck += 1;
            }
            ir_opt = ir_opt - (ir_opt & cn);
        } else if str_eq(a, "-noalign") {
            al_to = 0;
        } else if str_eq(a, "-noinl") {
            inl_off = 1;
        } else if str_eq(a, "-iralways") {
            ir_opt = ir_opt | 64;
        } else if str_eq(a, "-irpre") {
            ir_pre = 1;
        } else if str_eq(a, "-irra") {
            ir_mode = 2;
            ir_opt = ir_opt | 2;
        } else if str_eq(a, "-irmax") {
            ai += 1;
            ir_max = 0;
            char^ nv = arg(ai);
            int nk = 0;
            while nv[nk] >= '0' && nv[nk] <= '9' {
                ir_max = ir_max * 10 + (nv[nk] - '0');
                nk += 1;
            }
        } else if str_eq(a, "-irmin") {
            ai += 1;
            ir_min = 0;
            char^ nv2 = arg(ai);
            int nk2 = 0;
            while nv2[nk2] >= '0' && nv2[nk2] <= '9' {
                ir_min = ir_min * 10 + (nv2[nk2] - '0');
                nk2 += 1;
            }
        } else if str_eq(a, "-irdump") {
            ir_mode = 3;
        } else if str_eq(a, "-noregs") {
            opt_regs = 0;
        } else if is_opt(a, "nofma") {
            opt_fma = 0;
        } else if str_eq(a, "-ast2") {
            ast_lower_on = 1;
            ast_lower_report = 1;        // hidden: -ast, and a line for every function that was tried
            ow_trace = 1;
        } else if str_eq(a, "-ast") {
            ast_lower_on = 1;            // hidden: the default now (kept so that old command lines work)
        } else if str_eq(a, "-rgdbg") {
            rg_debug = 1;                // hidden: the register pass says what it thinks of the slots of main
        } else if str_eq(a, "-astmain") {
            ast_main_on = 1;             // hidden: the default now
        } else if str_eq(a, "-noastmain") {
            ast_main_on = 0;             // hidden: main from the text, the other functions from the tree
        } else if str_eq(a, "-noast") {
            ast_lower_on = 0;            // hidden: every function is made from its text (the path that the tree replaces)
        } else if str_eq(a, "-xast2") {
            ast_report = 2;              // hidden: like -xast, and every node that the tree does not understand
        } else if str_eq(a, "-xast") {
            ast_report = 1;              // hidden: say for every function whether its body is in the subset of the tree (design 10, 8.1)
        } else if str_eq(a, "-xastdump") {
            ast_report = 1;
            ast_dump = 1;                // hidden: print the tree of every body that is in the subset
        } else if str_eq(a, "-jh") {
            // jcmp -jh FILE [-o OUT] : the interface of a file (docs/syntax-design.md 80)
            ai += 1;
            if ai >= argc() { write_err("jcmp: -jh needs a file\n"); syscall(93, 1); }
            char^ jhfile = arg(ai);
            char^ jhout = null;
            if ai + 2 < argc() && str_eq(arg(ai + 1), "-o") { jhout = arg(ai + 2); }
            jh_run(jhfile, jhout);
            syscall(93, 0);
        } else if str_eq(a, "-api") {
            // jcmp -api NAME : the interface of a library (the one that comes with jcmp, or an installed one)
            ai += 1;
            if ai >= argc() { write_err("jcmp: -api needs the name of a library\n"); syscall(93, 1); }
            lib_init(JCMP_VERSION);
            char apath[300];
            if !lib_resolve(arg(ai), @apath) { write_err("jcmp: -api: there is no such library, installed or coming with jcmp\n"); syscall(93, 1); }
            jh_run(@apath, null);
            syscall(93, 0);
        } else if str_eq(a, "-clean") {
            ai += 1;
            if ai >= argc() { write_err("jcmp: -clean needs the folder of the cache\n"); syscall(93, 1); }
            cc_clean(arg(ai));
            syscall(93, 0);
        } else if str_eq(a, "-nocache") {
            x_nocache = 1;                   // do not use the cache even when J2K_CACHE is set
        } else if str_eq(a, "-cache") {
            ai += 1;
            if ai >= argc() { usage(); }
            x_cachedir = arg(ai);            // the folder of the cache of the back end (docs/design/16-separate-compilation.md)
        } else if str_eq(a, "-xmap") {
            ai += 1;
            x_map = arg(ai);                 // hidden: write the addresses of the labels of the program (for a profiler)
        } else if str_eq(a, "-xlex") {
            x_lex = 1;                       // hidden: time the lexer alone
        } else if str_eq(a, "-xall") {
            x_allreach = 1;                  // hidden: every function is reachable (to look at the whole library)
        } else if str_eq(a, "-xrepeat") {
            x_repeat = 1;                    // hidden: run the passes twice on each function and say when the result differs
        } else if str_eq(a, "-xcachecut") {
            ai += 1;
            x_cutmax = 0;
            char^ cv2 = arg(ai);
            int cp2 = 0;
            while cv2[cp2] >= '0' && cv2[cp2] <= '9' { x_cutmax = x_cutmax * 10 + (cv2[cp2] - '0'); cp2 += 1; }
            char^ nx2 = arg(ai + 1);
            if ai + 1 < argc() && nx2[0] >= '0' && nx2[0] <= '9' {
                // two numbers: MIN MAX
                x_cutmin = x_cutmax;
                x_cutmax = 0;
                ai += 1;
                cv2 = arg(ai);
                cp2 = 0;
                while cv2[cp2] >= '0' && cv2[cp2] <= '9' { x_cutmax = x_cutmax * 10 + (cv2[cp2] - '0'); cp2 += 1; }
            }
        } else if str_eq(a, "-xcachelist") {
            x_cachelist = 1;                 // hidden: with -cache and -xtime, list the functions that are in the cache
        } else if str_eq(a, "-xcachestat") {
            ai += 1;
            x_cachestat = arg(ai);           // hidden: count the functions already known in this folder (docs/design/16)
        } else if str_eq(a, "-xpre") {
            ai += 1;
            x_pre = arg(ai);                 // hidden: write the assembler text as it is after the code pass (before the back end)
        } else if str_eq(a, "-xtime") {
            x_time = 1;                  // hidden: the time of each stage
        } else if str_eq(a, "-xbadasm") {
            x_badasm = 1;                // hidden: a line the assembler cannot read (tests the message of a compiler bug)
        } else if str_eq(a, "-nopeep") {
            opt_peep = 0;
        } else if str_eq(a, "-j") {
            ai += 1;
            if ai >= argc() { write_err("jcmp: -j needs a number (the processes that share the work; 1 = one)\n"); syscall(93, 1); }
            char^ jn = arg(ai);
            par_jobs = 0;
            int jd = 0;
            while jn[jd] >= '0' && jn[jd] <= '9' { par_jobs = par_jobs * 10 + (jn[jd] - '0'); jd += 1; }
            if par_jobs < 1 { par_jobs = 1; }
        } else if str_eq(a, "-progress") {
            ai += 1;
            if ai >= argc() { write_err("jcmp: -progress needs the name of a file (it gets the percent of the compile)\n"); syscall(93, 1); }
            char^ pg = arg(ai);
            int pgi = 0;
            while pg[pgi] != 0 && pgi < 500 { prog_path[pgi] = pg[pgi]; pgi += 1; }
            prog_path[pgi] = 0;
            prog_on = 1;
        } else if str_eq(a, "-norot") {
            opt_rot = 0;
        } else if str_eq(a, "-st") {
            opt_strict = 1;
        } else if str_eq(a, "-I") {
            ai += 1;
            if ai >= argc() { usage(); }
            str_copy(@inc_dir, arg(ai), 256);
        } else if str_eq(a, "-show") {
            ai += 1;
            if ai >= argc() { usage(); }
            x_show = arg(ai);
        } else if is_opt(a, "emit-asm") {
            ai += 1;
            if ai >= argc() { usage(); }
            out_asm = arg(ai);
        } else if a[0] == '-' {
            write_err("jcmp: unknown option ");
            write_err(a);
            write_err("   (jcmp -help lists the options)\n");
            syscall(93, 1);
        } else if in_path == null {
            in_path = a;
        } else if out_asm == null && out_elf == null {
            // a second name: assembler text if it ends in .jasm (the old form), else the program
            int al = str_len(a);
            if al > 5 && a[al - 5] == '.' && a[al - 4] == 'j' && a[al - 3] == 'a' && a[al - 2] == 's' && a[al - 1] == 'm' {
                out_asm = a;
            } else {
                out_elf = a;
            }
        } else {
            usage();
        }
        ai += 1;
    }
    if in_path == null { usage(); }
    if x_target == 32 && opt_debug == 1 {
        write_err("jcmp: -d (the checks of memory and bounds) is not available for -target arm32 yet; build the program with -d for ARM64\n");
        syscall(93, 1);
    }
    lib_init(JCMP_VERSION);
    if x_cachedir == null && x_nocache == 0 {
        // the cache is on by default (from 0.9.188): J2K_CACHE=dir chooses the folder, J2K_CACHE= (empty) turns it off, else ~/.j2k/cache
        char^ ce = env_get("J2K_CACHE");
        if ce != null {
            if ce[0] != 0 { x_cachedir = ce; }
        } else {
            char^ hm = env_get("HOME");
            if hm != null && hm[0] != 0 && str_len(hm) < 200 {
                str_copy(@cache_default, hm, 200);
                append_text(@cache_default, "/.j2k/cache");
                x_cachedir = @cache_default;
                cache_auto = 1;
            }
        }
    }
    char derived[512];
    char base[256];
    // the name of the program from the source: x.jk / x.j -> x
    int last = 0;
    int bk = 0;
    while in_path[bk] != 0 {
        if in_path[bk] == '/' { last = bk + 1; }
        bk += 1;
    }
    int bn = 0;
    bk = last;
    while in_path[bk] != 0 && bn < 250 {
        base[bn] = in_path[bk];
        bn += 1;
        bk += 1;
    }
    if bn > 3 && base[bn - 3] == '.' && base[bn - 2] == 'j' && base[bn - 1] == 'k' {
        bn -= 3;
    } else if bn > 2 && base[bn - 2] == '.' && base[bn - 1] == 'j' {
        bn -= 2;
    } else {
        bn = 0;
    }
    base[bn] = 0;
    if out_elf == null && out_asm == null && x_show == null {
        // no -o: the program is named like the source, in the current folder
        if bn == 0 {
            write_err("jcmp: the source file has no .jk or .j name, so say where the program goes: -o name\n");
            syscall(93, 1);
        }
        out_elf = @base;
    } else if out_elf != null {
        // -o folder/ or -o an existing folder: the program gets the name of the source inside it
        int ol = str_len(out_elf);
        bool is_dir = ol > 0 && out_elf[ol - 1] == '/';
        if !is_dir {
            int st[18];
            if syscall(79, -100, out_elf, @st, 0) == 0 && (st[2] & 4294967295 & 61440) == 16384 { is_dir = true; }
        }
        if is_dir {
            if bn == 0 {
                write_err("jcmp: the source file has no .jk or .j name, so give the program a name: -o folder/name\n");
                syscall(93, 1);
            }
            str_copy(@derived, out_elf, 250);
            int dl = str_len(@derived);
            if dl > 0 && derived[dl - 1] != '/' {
                derived[dl] = '/';
                derived[dl + 1] = 0;
            }
            append_text(@derived, @base);
            out_elf = @derived;
        }
    }
    // pass 1 learns the functions, structs and enums (they may be used before they
    // are written); pass 2 checks everything and records which function calls which
    // (its code is thrown away); pass 3 makes the code, leaving out unused functions.
    tm_stage("start");
    if x_lex == 1 {
        pass_no = 1;
        reset_state(in_path);
        while tok_kind != T_EOF { next(); }
        tm_stage("lexing only (the main file)");
    }
    pass_no = 1;
    recover_on = 1;                      // a mistake in a statement or an item is written and the reading goes on: all of them are shown
    reset_state(in_path);
    parse_program();
    if err_count > 0 { err_summary(); syscall(93, 1); }      // errors the parser survived (a missing ';')
    tm_stage("parse pass 1 (names)");
    pass_no = 2;
    reset_state(in_path);
    parse_program();
    recover_on = 0;
    if err_count > 0 { err_summary(); syscall(93, 1); }
    tm_stage("parse passes 1+2");
    if find_func("main") < 0 && bare_mode == 0 && (x_lib == 0 || x_dyn == 1) { die_no_main(in_path); }
    compute_reach();
    pass_no = 3;
    reset_state(in_path);
    if bare_mode == 0 {
        if x_lib == 0 || x_dyn == 1 { emit_line("b j2k_start"); }
        emit_print_helpers();
        emit_copy_helper();
    }
    parse_program();
    if bare_mode == 0 {
        emit_free_thunks();
        if used_fprint == 1 { emit_fprint_helper(); }
        if used_oob == 1 { emit_oob_helper(); }
        if used_uprint == 1 { emit_uprint_helper(); }
        if used_divz == 1 { emit_divzero_helper(); }
        if used_noret == 1 { emit_noret_helper(); }
        emit_segv_handler();
        if used_try == 1 { emit_exc_helper(); }
        if used_thread == 1 { emit_thread_helper(); }
        if x_lib == 1 && x_dyn == 0 { emit_lib_stub(); } else { emit_start_stub(); }
    }
    tm_stage("parse pass 3 (the code)");
    if x_pre != null { write_file(x_pre, @out_buf, out_len); }
    if x_cachestat != null { cc_stat(x_cachestat); }
    if x_cachedir != null {
        // chosen by default: only for a program big enough to gain (a small one is faster without the files)
        if cache_auto == 1 && out_len < 262144 { } else { cc_dir = x_cachedir; cc_prepare(); }
    }
    nr_run();
    if ir_mode > 0 && opt_peep == 1 && ir_pre == 1 { peep_run(); }
    tm_stage("nr + first peephole");
    if ir_mode > 0 { ir_run(); }
    if x_target == 32 { a32_finish(out_elf); }
    tm_stage("ir");
    if x_time == 1 { write_err("    (expressions out of loops: "); write_err_int(lc_us / 1000); write_err(" ms, "); write_err_int(lc_calls); write_err(" functions, "); write_err_int(lc_moved); write_err(" instructions moved)\n"); }
    if opt_peep == 1 { peep_run(); }
    tm_stage("peephole");
    regs_run();
    tm_stage("register pass");
    if opt_peep == 1 && opt_regs != 0 { peep_run(); }
    if opt_rot == 1 && opt_peep == 1 { rot_run(); }
    if fr_on == 1 { fr_run(); }
    al_run();
    if cc_dir != null {
        cc_finish();
        if cc_stored > 0 && (cc_stored > 200 || (unix_now_cc() & 15) == 0) { cc_trim(); }
    }
    tm_stage("peephole + alignment");
    if x_target != 32 { check_expectations(); }          // ARM32 has no register allocation yet: its counts are not comparable, so the limits are not checked there
    if x_show != null {
        show_function(x_show);
        syscall(93, 0);
    }
    if out_asm != null {
        if write_file(out_asm, @out_buf, out_len) != 0 {
            write_err("jcmp: cannot write the output file\n");
            syscall(93, 1);
        }
    }
    if out_elf != null {
        // the assembler is part of jcmp: the text goes straight to it
        int k = 0;
        while k < out_len {
            as_src[k] = out_buf[k];
            k += 1;
        }
        if x_badasm == 1 {
            char bad[24] = "\nfrobnicate x1, x2\n";
            int bk = 0;
            while bad[bk] != 0 {
                as_src[out_len] = bad[bk];
                out_len += 1;
                bk += 1;
            }
        }
        as_embedded = 1;
        as_lib = x_lib;
        as_dyn = x_dyn;
        as_assemble(out_len);
        if x_map != null { write_label_map(x_map); }
        tm_stage("assembler");
        if x_lib == 1 { as_write_so(out_elf); } else { as_write_elf(out_elf); }
    }
    if warn_count > 0 {
        msg_kind = 2;
        kind_color();
        write_err_int(warn_count);
        write_err(" warning(s) generated.");
        color_reset();
        write_err("\n");
    }
}
