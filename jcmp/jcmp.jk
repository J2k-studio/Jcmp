// jcmp.jk -- the J2K compiler written in J2K: the four parts, joined.
// Build:  bin/jcmp jcmp/jcmp.jk -o jcmp1        (see bootstrap.sh)
// Use:    jcmp1 input.jk -o program
// the version of the compiler (also in the file VERSION; release.sh checks that they agree)
#define JCMP_VERSION "0.9.81"

#import "jc_base"
#import "jc_asm"
#import "jc_lex"
#import "jc_std"
#import "jc_expr"
#import "jc_low"
#import "jc_stmt"
#import "jc_gen"
#import "jc_regs"
#import "jc_ir"
#import "jc_opt"
#import "jc_lift"
#import "jc_peep"
#import "jc_logo"

// ------------------------------------------------ the program (main lives here, not in a .j part)

// the state that every pass starts again from
void reset_state(char^ in_path) {
    ft_count = 0;
    out_len = 0;
    gcount = 0;
    gl_bytes = 864;                      // slot 0: initial sp; 8..71: arguments 9..16 of a call; 72..863: exceptions
    ginit_count = 0;
    gsi_count = 0;
    gfi_count = 0;
    label_no = 0;
    lcount = 0;
    cur_fidx = 0 - 1;
    used_fprint = 0;
    used_oob = 0;
    old_float_warned = 0;
    using_warned = 0;
    io_float_warned = 0;
    import_warned = 0;
    import_bare_warned = 0;
    using_std_seen = 0;
    io_warned = 0;
    used_divz = 0;
    used_noret = 0;
    used_uprint = 0;
    used_try = 0;
    used_thread = 0;
    lex_init(in_path);
    next();
}

void usage() {
    write_err("usage: jcmp input.jk [-o output] [-d] [-st] [-I dir] [--emit-asm file.jasm]\n");
    write_err("       jcmp -help      (all options)      jcmp -version\n");
    syscall(93, 1);
}

// the short help (jcmp -help)
void help() {
    write_out("jcmp ");
    write_out(JCMP_VERSION);
    write_out(" - the J2K compiler (Linux ARM64)\n\n");
    write_out("usage: jcmp input.jk [-o output] [options]      (without -o the program is named like the source: test.jk -> test)\n\n");
    write_out("  -o file          write the program to file\n");
    write_out("  -d               debug build: array bounds checks, memory leak report\n");
    write_out("  -st              strict: warnings are errors\n");
    write_out("  -I dir           also look for imported files in dir\n");
    write_out("  -emit-asm file   also write the assembler text\n");
    write_out("  -color           coloured messages (the default when stderr is a terminal)\n");
    write_out("  -nocolor         plain messages\n");
    write_out("  -version         print the version\n");
    write_out("  -help            this text\n\n");
    write_out("example: jcmp hello.jk -o hello && ./hello\n");
    syscall(93, 0);
}

// a long option written with one or two dashes: -version  or  --version
bool is_opt(char^ a, char^ name) {
    if a[0] != '-' { return false; }
    int k = 1;
    if a[1] == '-' { k = 2; }
    int i = 0;
    while name[i] != 0 {
        if a[k + i] != name[i] { return false; }
        i += 1;
    }
    return a[k + i] == 0;
}

void main() {
    char^ in_path = null;
    char^ out_elf = null;
    char^ out_asm = null;
    int ai = 1;
    char termios[64];
    if syscall(29, 2, 21505, @termios) == 0 { use_color = 1; }       // standard error is a terminal: colours
    while ai < argc() {
        char^ a = arg(ai);
        if str_eq(a, "-o") {
            ai += 1;
            if ai >= argc() { usage(); }
            out_elf = arg(ai);
        } else if is_opt(a, "version") || str_eq(a, "-v") || str_eq(a, "-V") {
            write_out("jcmp ");
            write_out(JCMP_VERSION);
            write_out(" (J2K compiler, Linux ARM64)\n");
            syscall(93, 0);
        } else if is_opt(a, "help") || str_eq(a, "-h") || str_eq(a, "-?") {
            help();
        } else if is_opt(a, "color") {
            use_color = 1;
        } else if is_opt(a, "nocolor") {
            use_color = 0;
        } else if str_eq(a, "-space") || str_eq(a, "-spcae") || str_eq(a, "-speac") {
            // the mascot (not in -help); an optional number after it: how many times faster than real time (default 1800)
            // pixels with colour by default (ASCII if the terminal has no 24-bit colour); "ascii": always characters; "pxg": pixels in white, grey and black
            lg_px = 1;
            int lg_speed = 0;
            int lg_arg = 1;
            while lg_arg <= 2 && ai + lg_arg < argc() {
                char^ sp = arg(ai + lg_arg);
                if str_eq(sp, "px") { lg_px = 1; }
                else if str_eq(sp, "ascii") { lg_px = 0; }
                else if str_eq(sp, "pxg") { lg_px = 2; }
                else {
                    int sk = 0;
                    while sp[sk] >= '0' && sp[sk] <= '9' && sk < 8 {
                        lg_speed = lg_speed * 10 + (sp[sk] - '0');
                        sk += 1;
                    }
                }
                lg_arg += 1;
            }
            lg_run(0, lg_speed);
            syscall(93, 0);
        } else if str_eq(a, "-d") {
            opt_debug = 1;
        } else if str_eq(a, "-irtest") {
            ir_selftest();
            syscall(93, 0);
        } else if str_eq(a, "-irstat") {
            ir_mode = 1;
        } else if str_eq(a, "-noir") {
            ir_mode = 0;
        } else if str_eq(a, "-irtrip") {
            ir_mode = 2;
            ir_opt = 0;
            ir_pre = 0;
        } else if str_eq(a, "-irlicm") {
            ir_mode = 2;
            ir_opt = ir_opt | 1;
        } else if str_eq(a, "-stp") {
            fr_on = 1;
        } else if str_eq(a, "-iropt") {
            ir_mode = 2;
            ir_opt = ir_opt | 44;
            ir_pre = 1;
        } else if str_eq(a, "-irdbg") {
            ai += 1;
            char^ dv = arg(ai);
            int dk = 0;
            int dn = 0;
            while dv[dk] >= '0' && dv[dk] <= '9' {
                dn = dn * 10 + (dv[dk] - '0');
                dk += 1;
            }
            ir_opt = ir_opt | dn;
        } else if str_eq(a, "-irclr") {
            ai += 1;
            char^ cv = arg(ai);
            int ck = 0;
            int cn = 0;
            while cv[ck] >= '0' && cv[ck] <= '9' {
                cn = cn * 10 + (cv[ck] - '0');
                ck += 1;
            }
            ir_opt = ir_opt - (ir_opt & cn);
        } else if str_eq(a, "-noalign") {
            al_to = 0;
        } else if str_eq(a, "-noinl") {
            inl_off = 1;
        } else if str_eq(a, "-iralways") {
            ir_opt = ir_opt | 64;
        } else if str_eq(a, "-irpre") {
            ir_pre = 1;
        } else if str_eq(a, "-irra") {
            ir_mode = 2;
            ir_opt = ir_opt | 2;
        } else if str_eq(a, "-irmax") {
            ai += 1;
            ir_max = 0;
            char^ nv = arg(ai);
            int nk = 0;
            while nv[nk] >= '0' && nv[nk] <= '9' {
                ir_max = ir_max * 10 + (nv[nk] - '0');
                nk += 1;
            }
        } else if str_eq(a, "-irmin") {
            ai += 1;
            ir_min = 0;
            char^ nv2 = arg(ai);
            int nk2 = 0;
            while nv2[nk2] >= '0' && nv2[nk2] <= '9' {
                ir_min = ir_min * 10 + (nv2[nk2] - '0');
                nk2 += 1;
            }
        } else if str_eq(a, "-irdump") {
            ir_mode = 3;
        } else if str_eq(a, "-noregs") {
            opt_regs = 0;
        } else if str_eq(a, "-nopeep") {
            opt_peep = 0;
        } else if str_eq(a, "-st") {
            opt_strict = 1;
        } else if str_eq(a, "-I") {
            ai += 1;
            if ai >= argc() { usage(); }
            str_copy(@inc_dir, arg(ai), 256);
        } else if is_opt(a, "emit-asm") {
            ai += 1;
            if ai >= argc() { usage(); }
            out_asm = arg(ai);
        } else if a[0] == '-' {
            write_err("jcmp: unknown option ");
            write_err(a);
            write_err("   (jcmp -help lists the options)\n");
            syscall(93, 1);
        } else if in_path == null {
            in_path = a;
        } else if out_asm == null && out_elf == null {
            // a second name: assembler text if it ends in .jasm (the old form), else the program
            int al = str_len(a);
            if al > 5 && a[al - 5] == '.' && a[al - 4] == 'j' && a[al - 3] == 'a' && a[al - 2] == 's' && a[al - 1] == 'm' {
                out_asm = a;
            } else {
                out_elf = a;
            }
        } else {
            usage();
        }
        ai += 1;
    }
    if in_path == null { usage(); }
    char derived[512];
    char base[256];
    // the name of the program from the source: x.jk / x.j -> x
    int last = 0;
    int bk = 0;
    while in_path[bk] != 0 {
        if in_path[bk] == '/' { last = bk + 1; }
        bk += 1;
    }
    int bn = 0;
    bk = last;
    while in_path[bk] != 0 && bn < 250 {
        base[bn] = in_path[bk];
        bn += 1;
        bk += 1;
    }
    if bn > 3 && base[bn - 3] == '.' && base[bn - 2] == 'j' && base[bn - 1] == 'k' {
        bn -= 3;
    } else if bn > 2 && base[bn - 2] == '.' && base[bn - 1] == 'j' {
        bn -= 2;
    } else {
        bn = 0;
    }
    base[bn] = 0;
    if out_elf == null && out_asm == null {
        // no -o: the program is named like the source, in the current folder
        if bn == 0 {
            write_err("jcmp: the source file has no .jk or .j name, so say where the program goes: -o name\n");
            syscall(93, 1);
        }
        out_elf = @base;
    } else if out_elf != null {
        // -o folder/ or -o an existing folder: the program gets the name of the source inside it
        int ol = str_len(out_elf);
        bool is_dir = ol > 0 && out_elf[ol - 1] == '/';
        if !is_dir {
            int st[18];
            if syscall(79, -100, out_elf, @st, 0) == 0 && (st[2] & 4294967295 & 61440) == 16384 { is_dir = true; }
        }
        if is_dir {
            if bn == 0 {
                write_err("jcmp: the source file has no .jk or .j name, so give the program a name: -o folder/name\n");
                syscall(93, 1);
            }
            str_copy(@derived, out_elf, 250);
            int dl = str_len(@derived);
            if dl > 0 && derived[dl - 1] != '/' {
                derived[dl] = '/';
                derived[dl + 1] = 0;
            }
            append_text(@derived, @base);
            out_elf = @derived;
        }
    }
    // pass 1 learns the functions, structs and enums (they may be used before they
    // are written); pass 2 checks everything and records which function calls which
    // (its code is thrown away); pass 3 makes the code, leaving out unused functions.
    pass_no = 1;
    reset_state(in_path);
    parse_program();
    pass_no = 2;
    reset_state(in_path);
    parse_program();
    compute_reach();
    pass_no = 3;
    reset_state(in_path);
    emit_line("b j2k_start");
    emit_print_helpers();
    emit_copy_helper();
    parse_program();
    emit_free_thunks();
    if used_fprint == 1 { emit_fprint_helper(); }
    if used_oob == 1 { emit_oob_helper(); }
    if used_uprint == 1 { emit_uprint_helper(); }
    if used_divz == 1 { emit_divzero_helper(); }
    if used_noret == 1 { emit_noret_helper(); }
    emit_segv_handler();
    if used_try == 1 { emit_exc_helper(); }
    if used_thread == 1 { emit_thread_helper(); }
    emit_start_stub();
    if ir_mode > 0 && opt_peep == 1 && ir_pre == 1 { peep_run(); }
    if ir_mode > 0 { ir_run(); }
    if opt_peep == 1 { peep_run(); }
    regs_run();
    if opt_peep == 1 && opt_regs != 0 { peep_run(); }
    if fr_on == 1 { fr_run(); }
    al_run();
    if out_asm != null {
        if write_file(out_asm, @out_buf, out_len) != 0 {
            write_err("jcmp: cannot write the output file\n");
            syscall(93, 1);
        }
    }
    if out_elf != null {
        // the assembler is part of jcmp: the text goes straight to it
        int k = 0;
        while k < out_len {
            as_src[k] = out_buf[k];
            k += 1;
        }
        as_assemble(out_len);
        as_write_elf(out_elf);
    }
    if warn_count > 0 {
        msg_kind = 2;
        kind_color();
        write_err_int(warn_count);
        write_err(" warning(s) generated.");
        color_reset();
        write_err("\n");
    }
}
