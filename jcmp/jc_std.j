    put("//   Option<int> a = Option<int>::Some(5);   Option<int> b = Option<int>::None;");
    put("//   Result<int, Error> r = parse(text);     int n = parse(text)?;      (? returns the error to the caller)");
    put("// switch takes a value apart:  switch r { Result::Ok(v): ...; Result::Err(e): ...; }");
    put("");
    put("enum class ErrorKind { Other, NotFound, Denied, Invalid, Parse, Io };");
    put("");
    put("// the usual error: what went wrong (kind) and a message");
    put("struct Error {");
    put("    ErrorKind kind;");
    put("    String message;");
    put("    static Error make(ErrorKind kind, String message) {");
    put("        Error e;");
    put("        e.kind = kind;");
    put("        e.message = message;");
    put("        return e;");
    put("    }");
    put("    void free(self) {");
    put("        self.message.free();");
    put("    }");
    put("};");
    put("");
    put("enum class Option<T> { Some(T value), None;");
    put("    bool is_some(self) { return self.__tag == 0; }");
    put("    bool is_none(self) { return self.__tag == 1; }");
    put("    // the value (throws if there is none)");
    put("    T unwrap(self) {");
    put("        switch self^ {");
    put("            Option::Some(v): return v;");
    put("            Option::None: __panic(\"unwrap of a None\");");
    put("        }");
    put("        __panic(\"unwrap of a None\");");
    put("    }");
    put("    // the value, or fallback");
    put("    T or(self, T fallback) {");
    put("        switch self^ {");
    put("            Option::Some(v): return v;");
    put("            Option::None: return fallback;");
    put("        }");
    put("        return fallback;");
    put("    }");
    put("};");
    put("");
    put("enum class Result<T, E> { Ok(T value), Err(E error);");
    put("    bool is_ok(self) { return self.__tag == 0; }");
    put("    bool is_err(self) { return self.__tag == 1; }");
    put("    // the value (throws if it is an error)");
    put("    T unwrap(self) {");
    put("        switch self^ {");
    put("            Result::Ok(v): return v;");
    put("            Result::Err(e): __panic(\"unwrap of an Err\");");
    put("        }");
    put("        __panic(\"unwrap of an Err\");");
    put("    }");
    put("    // the value, or fallback");
    put("    T or(self, T fallback) {");
    put("        switch self^ {");
    put("            Result::Ok(v): return v;");
    put("            Result::Err(e): return fallback;");
    put("        }");
    put("        return fallback;");
    put("    }");
    put("};");
    put("");
    put("// Map<K,V> and Set<T>: hash tables (open addressing, linear probing). K and T can be int, char, double,");
    put("// pointers or String. Both have a free(self) method, so a local one is freed at the end of its block.");
    put("");
    put("struct Map<K, V> {");
    put("    K[] keys;");
    put("    V[] vals;");
    put("    int[] st;                  // 0 empty, 1 used, 2 deleted");
    put("    int len;                   // how many keys");
    put("    int used;                  // used + deleted places");
    put("");
    put("    // the place of key k, or -1");
    put("    int find(self, K k) {");
    put("        if self.st == null { return -1; }");
    put("        int mask = self.st.len - 1;");
    put("        int i = __hash(k) & mask;");
    put("        while true {");
    put("            int s = self.st[i];");
    put("            if s == 0 { return -1; }");
    put("            if s == 1 && self.keys[i] == k { return i; }");
    put("            i = (i + 1) & mask;");
    put("        }");
    put("        return -1;");
    put("    }");
    put("    bool has(self, K k) {");
    put("        return self.find(k) >= 0;");
    put("    }");
    put("    // the value of key k (throws \"key not found\")");
    put("    V get(self, K k) {");
    put("        int i = self.find(k);");
    put("        if i < 0 { throw \"key not found\"; }");
    put("        return self.vals[i];");
    put("    }");
    put("    // the value of key k as an Option: Some(value) or None");
    put("    Option<V> try_get(self, K k) {");
    put("        int i = self.find(k);");
    put("        if i < 0 { return Option<V>::None; }");
    put("        return Option<V>::Some(self.vals[i]);");
    put("    }");
    put("    void put(self, K k, V v) {");
    put("        if self.st == null { self.rehash(8); }");
    put("        if (self.used + 1) * 4 > self.st.len * 3 { self.rehash(self.st.len * 2); }");
    put("        int mask = self.st.len - 1;");
    put("        int i = __hash(k) & mask;");
    put("        int tomb = -1;");
    put("        while true {");
    put("            int s = self.st[i];");
    put("            if s == 0 { break; }");
    put("            if s == 2 && tomb < 0 { tomb = i; }");
    put("            if s == 1 && self.keys[i] == k {");
    put("                self.vals[i] = v;");
    put("                return;");
    put("            }");
    put("            i = (i + 1) & mask;");
    put("        }");
    put("        if tomb >= 0 {");
    put("            i = tomb;");
    put("        } else {");
    put("            self.used += 1;");
    put("        }");
    put("        self.keys[i] = k;");
    put("        self.vals[i] = v;");
    put("        self.st[i] = 1;");
    put("        self.len += 1;");
    put("    }");
    put("    // true if key k was there");
    put("    bool remove(self, K k) {");
    put("        int i = self.find(k);");
    put("        if i < 0 { return false; }");
    put("        self.st[i] = 2;");
    put("        self.len -= 1;");
    put("        return true;");
    put("    }");
    put("    void rehash(self, int cap) {");
    put("        K[] ok = self.keys;");
    put("        V[] ov = self.vals;");
    put("        int[] os = self.st;");
    put("        self.keys = arr(cap);");
    put("        self.keys.resize(cap);");
    put("        self.vals = arr(cap);");
    put("        self.vals.resize(cap);");
    put("        self.st = arr(cap);");
    put("        self.st.resize(cap);");
    put("        self.len = 0;");
    put("        self.used = 0;");
    put("        if os != null {");
    put("            for i in 0..os.len {");
    put("                if os[i] == 1 { self.put(ok[i], ov[i]); }");
    put("            }");
    put("            ok.free();");
    put("            ov.free();");
    put("            os.free();");
    put("        }");
    put("    }");
    put("    // a new array with the keys (in table order)");
    put("    K[] keys_list(self) {");
    put("        K[] r = arr(self.len + 1);");
    put("        if self.st != null {");
    put("            for i in 0..self.st.len {");
    put("                if self.st[i] == 1 { r.push(self.keys[i]); }");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    V[] values_list(self) {");
    put("        V[] r = arr(self.len + 1);");
    put("        if self.st != null {");
    put("            for i in 0..self.st.len {");
    put("                if self.st[i] == 1 { r.push(self.vals[i]); }");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    void free(self) {");
    put("        self.keys.free();");
    put("        self.vals.free();");
    put("        self.st.free();");
    put("        self.len = 0;");
    put("        self.used = 0;");
    put("    }");
    put("}");
    put("");
    put("struct Set<T> {");
    put("    T[] items;");
    put("    int[] st;");
    put("    int len;");
    put("    int used;");
    put("");
    put("    int find(self, T x) {");
    put("        if self.st == null { return -1; }");
    put("        int mask = self.st.len - 1;");
    put("        int i = __hash(x) & mask;");
    put("        while true {");
    put("            int s = self.st[i];");
    put("            if s == 0 { return -1; }");
    put("            if s == 1 && self.items[i] == x { return i; }");
    put("            i = (i + 1) & mask;");
    put("        }");
    put("        return -1;");
    put("    }");
    put("    bool has(self, T x) {");
    put("        return self.find(x) >= 0;");
    put("    }");
    put("    // true if x was new");
    put("    bool add(self, T x) {");
    put("        if self.find(x) >= 0 { return false; }");
    put("        if self.st == null { self.rehash(8); }");
    put("        if (self.used + 1) * 4 > self.st.len * 3 { self.rehash(self.st.len * 2); }");
    put("        int mask = self.st.len - 1;");
    put("        int i = __hash(x) & mask;");
    put("        while self.st[i] == 1 { i = (i + 1) & mask; }");
    put("        if self.st[i] == 0 { self.used += 1; }");
    put("        self.items[i] = x;");
    put("        self.st[i] = 1;");
    put("        self.len += 1;");
    put("        return true;");
    put("    }");
    put("    bool remove(self, T x) {");
    put("        int i = self.find(x);");
    put("        if i < 0 { return false; }");
    put("        self.st[i] = 2;");
    put("        self.len -= 1;");
    put("        return true;");
    put("    }");
    put("    void rehash(self, int cap) {");
    put("        T[] oi = self.items;");
    put("        int[] os = self.st;");
    put("        self.items = arr(cap);");
    put("        self.items.resize(cap);");
    put("        self.st = arr(cap);");
    put("        self.st.resize(cap);");
    put("        self.len = 0;");
    put("        self.used = 0;");
    put("        if os != null {");
    put("            for i in 0..os.len {");
    put("                if os[i] == 1 { self.add(oi[i]); }");
    put("            }");
    put("            oi.free();");
    put("            os.free();");
    put("        }");
    put("    }");
    put("    T[] items_list(self) {");
    put("        T[] r = arr(self.len + 1);");
    put("        if self.st != null {");
    put("            for i in 0..self.st.len {");
    put("                if self.st[i] == 1 { r.push(self.items[i]); }");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    void free(self) {");
    put("        self.items.free();");
    put("        self.st.free();");
    put("        self.len = 0;");
    put("        self.used = 0;");
    put("    }");
    put("}");
    put("");
    put("// Files, folders, the environment, time and random numbers. A name is a String (a text in the program is fine).");
    put("// Things that can fail for outside reasons give a Result<T, Error>; check it with switch or use ? .");
    put("");
    put("// an Error for the system error number e (a negative number from a system call is fine) and what was being done");
    put("struct Fs {");
    put("    static Error error(int e, String what, String path) {");
    put("        if e < 0 { e = 0 - e; }");
    put("        ErrorKind k = ErrorKind::Io;");
    put("        if e == 2 || e == 20 { k = ErrorKind::NotFound; }");
    put("        if e == 13 || e == 1 { k = ErrorKind::Denied; }");
    put("        if e == 22 || e == 21 || e == 36 { k = ErrorKind::Invalid; }");
    put("        String m = what + path;");
    put("        m += \" (error \";");
    put("        m += (char)('0' + e / 100 % 10);");
    put("        m += (char)('0' + e / 10 % 10);");
    put("        m += (char)('0' + e % 10);");
    put("        m += \")\";");
    put("        return Error::make(k, m);");
    put("    }");
    put("    // the whole file as a String");
    put("    static Result<String, Error> read_text(String path) {");
    put("        int fd = syscall(56, -100, path.c(), 0, 0);");
    put("        if fd < 0 { return Result<String, Error>::Err(Fs::error(fd, \"cannot open \", path)); }");
    put("        String text = \"\";");
    put("        char buf[4096];");
    put("        int n = syscall(63, fd, @buf, 4095);");
    put("        while n > 0 {");
    put("            buf[n] = 0;");
    put("            text.append((char^)@buf);");
    put("            n = syscall(63, fd, @buf, 4095);");
    put("        }");
    put("        syscall(57, fd);");
    put("        if n < 0 { return Result<String, Error>::Err(Fs::error(n, \"cannot read \", path)); }");
    put("        return Result<String, Error>::Ok(text);");
    put("    }");
    put("    // the lines of a file (without the line ends)");
    put("    static Result<String[], Error> read_lines(String path) {");
    put("        String text = Fs::read_text(path)?;");
    put("        String[] parts = text.split(\"\\n\");");
    put("        String[] lines = arr(parts.len + 1);");
    put("        for i in 0..parts.len {");
    put("            String line = parts[i];");
    put("            int n = line.len;");
    put("            if n > 0 {");
    put("                char last = line[n - 1];");
    put("                if last == 13 { line = line.slice(0, n - 1); }");
    put("            }");
    put("            if i < parts.len - 1 || line.len > 0 { lines.push(line); }");
    put("        }");
    put("        parts.free();");
    put("        return Result<String[], Error>::Ok(lines);");
    put("    }");
    put("    // write the text to the file (made or emptied); Ok(the number of bytes)");
    put("    static Result<int, Error> write_text(String path, String text) {");
    put("        return Fs::put(path, text, 577);");
    put("    }");
    put("    // add the text at the end of the file (made if needed)");
    put("    static Result<int, Error> append_text(String path, String text) {");
    put("        return Fs::put(path, text, 1089);");
    put("    }");
    put("    static Result<int, Error> put(String path, String text, int flags) {");
    put("        int fd = syscall(56, -100, path.c(), flags, 420);");
    put("        if fd < 0 { return Result<int, Error>::Err(Fs::error(fd, \"cannot write \", path)); }");
    put("        int done = 0;");
    put("        char^ p = text.c();");
    put("        while done < text.len {");
    put("            int n = syscall(64, fd, p + done, text.len - done);");
    put("            if n <= 0 {");
    put("                syscall(57, fd);");
    put("                return Result<int, Error>::Err(Fs::error(n, \"cannot write \", path));");
    put("            }");
    put("            done += n;");
    put("        }");
    put("        syscall(57, fd);");
    put("        return Result<int, Error>::Ok(done);");
    put("    }");
    put("    static bool exists(String path) {");
    put("        return syscall(48, -100, path.c(), 0, 0) == 0;");
    put("    }");
    put("    // the size of a file in bytes");
    put("    static Result<int, Error> size(String path) {");
    put("        int fd = syscall(56, -100, path.c(), 0, 0);");
    put("        if fd < 0 { return Result<int, Error>::Err(Fs::error(fd, \"cannot open \", path)); }");
    put("        int n = syscall(62, fd, 0, 2);");
    put("        syscall(57, fd);");
    put("        if n < 0 { return Result<int, Error>::Err(Fs::error(n, \"cannot size \", path)); }");
    put("        return Result<int, Error>::Ok(n);");
    put("    }");
    put("    static Result<int, Error> remove(String path) {");
    put("        int r = syscall(35, -100, path.c(), 0);");
    put("        if r < 0 { return Result<int, Error>::Err(Fs::error(r, \"cannot remove \", path)); }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("    static Result<int, Error> rename(String from, String to) {");
    put("        int r = syscall(38, -100, from.c(), -100, to.c());");
    put("        if r < 0 { return Result<int, Error>::Err(Fs::error(r, \"cannot rename \", from)); }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("}");
    put("");
    put("struct Dir {");
    put("    static bool exists(String path) {");
    put("        int st[18];");
    put("        if syscall(79, -100, path.c(), @st, 0) != 0 { return false; }       // newfstatat");
    put("        return (st[2] & 4294967295 & 61440) == 16384;                          // st_mode is a folder");
    put("    }");
    put("    static Result<int, Error> make(String path) {");
    put("        int r = syscall(34, -100, path.c(), 493);");
    put("        if r < 0 { return Result<int, Error>::Err(Fs::error(r, \"cannot make the folder \", path)); }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("    // the folder and the ones above it (like mkdir -p)");
    put("    static Result<int, Error> make_all(String path) {");
    put("        String part = \"\";");
    put("        for ch in path {");
    put("            if ch == '/' && part.len > 0 {");
    put("                if !Dir::exists(part) {");
    put("                    int r1 = syscall(34, -100, part.c(), 493);");
    put("                    if r1 < 0 { return Result<int, Error>::Err(Fs::error(r1, \"cannot make the folder \", part)); }");
    put("                }");
    put("            }");
    put("            part.push(ch);");
    put("        }");
    put("        if part.len > 0 && !Dir::exists(part) {");
    put("            int r2 = syscall(34, -100, part.c(), 493);");
    put("            if r2 < 0 { return Result<int, Error>::Err(Fs::error(r2, \"cannot make the folder \", part)); }");
    put("        }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("    // remove an empty folder");
    put("    static Result<int, Error> remove(String path) {");
    put("        int r = syscall(35, -100, path.c(), 512);                // AT_REMOVEDIR");
    put("        if r < 0 { return Result<int, Error>::Err(Fs::error(r, \"cannot remove the folder \", path)); }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("    // the names in a folder (not . and ..), in order");
    put("    static Result<String[], Error> list(String path) {");
    put("        int fd = syscall(56, -100, path.c(), 16384, 0);");
    put("        if fd < 0 { return Result<String[], Error>::Err(Fs::error(fd, \"cannot read the folder \", path)); }");
    put("        String[] names = arr(8);");
    put("        char buf[4096];");
    put("        int n = syscall(61, fd, @buf, 4096);                     // getdents64");
    put("        while n > 0 {");
    put("            int at = 0;");
    put("            while at < n {");
    put("                int reclen = buf[at + 16] + buf[at + 17] * 256;");
    put("                String name = \"\";");
    put("                int k = at + 19;");
    put("                while buf[k] != 0 {");
    put("                    name.push(buf[k]);");
    put("                    k += 1;");
    put("                }");
    put("                if !(name == \".\") && !(name == \"..\") { names.push(name); }");
    put("                at += reclen;");
    put("            }");
    put("            n = syscall(61, fd, @buf, 4096);");
    put("        }");
    put("        syscall(57, fd);");
    put("        names.sort();");
    put("        return Result<String[], Error>::Ok(names);");
    put("    }");
    put("    static Result<String, Error> current() {");
    put("        char buf[1024];");
    put("        int n = syscall(17, @buf, 1024);");
    put("        if n < 0 { return Result<String, Error>::Err(Fs::error(n, \"cannot get the folder\", \"\")); }");
    put("        String s = \"\";");
    put("        s.append((char^)@buf);");
    put("        return Result<String, Error>::Ok(s);");
    put("    }");
    put("}");
    put("");
    put("struct Env {");
    put("    // the value of an environment variable");
    put("    static Option<String> get(String name) {");
    put("        int i = argc() + 1;");
    put("        int nl = name.len;");
    put("        char^ nm = name.c();");
    put("        while arg(i) != null {");
    put("            char^ e = arg(i);");
    put("            int k = 0;");
    put("            while k < nl && e[k] == nm[k] { k += 1; }");
    put("            if k == nl && e[k] == '=' {");
    put("                String v = \"\";");
    put("                v.append((char^)(e + nl + 1));");
    put("                return Option<String>::Some(v);");
    put("            }");
    put("            i += 1;");
    put("        }");
    put("        return Option<String>::None;");
    put("    }");
    put("    // the arguments of the program (the first one is the program itself)");
    put("    static String[] args() {");
    put("        String[] r = arr(argc() + 1);");
    put("        for i in 0..argc() {");
    put("            String a = \"\";");
    put("            a.append((char^)arg(i));");
    put("            r.push(a);");
    put("        }");
    put("        return r;");
    put("    }");
    put("}");
    put("");
    put("struct Time {");
    put("    // milliseconds since 1970 (the clock of the computer)");
    put("    static int now_ms() {");
    put("        int ts[2];");
    put("        syscall(113, 0, @ts);");
    put("        return ts[0] * 1000 + ts[1] / 1000000;");
    put("    }");
    put("    // a clock that only goes forward, in nanoseconds: for measuring how long something takes");
    put("    static int mono_ns() {");
    put("        int ts[2];");
    put("        syscall(113, 1, @ts);");
    put("        return ts[0] * 1000000000 + ts[1];");
    put("    }");
    put("    static void sleep_ms(int ms) {");
    put("        int ts[2];");
    put("        ts[0] = ms / 1000;");
    put("        ts[1] = ms % 1000 * 1000000;");
    put("        syscall(101, @ts, 0);");
    put("    }");
    put("}");
    put("");
    put("u64 std_rand_state;");
    put("");
    put("struct Random {");
    put("    // start the series from a number (the same number gives the same series)");
    put("    static void seed(int s) {");
    put("        std_rand_state = (u64)s;");
    put("        if std_rand_state == 0 { std_rand_state = 88172645463325252; }");
    put("    }");
    put("    // the next number: 0 or more (xorshift64)");
    put("    static int next() {");
    put("        if std_rand_state == 0 { Random::seed(Time::mono_ns() + Time::now_ms()); }");
    put("        u64 x = std_rand_state;");
    put("        x = x xor (x shl 13);");
    put("        x = x xor (x shr 7);");
    put("        x = x xor (x shl 17);");
    put("        std_rand_state = x;");
    put("        return (int)(x shr 1);");
    put("    }");
    put("    // a number from lo up to (not including) hi");
    put("    static int range(int lo, int hi) {");
    put("        if hi <= lo { return lo; }");
    put("        return lo + Random::next() % (hi - lo);");
    put("    }");
    put("    // a decimal number from 0 up to (not including) 1");
    put("    static double unit() {");
    put("        return (double)(Random::next() shr 10) / 9.007199254740992e15;");
    put("    }");
    put("}");
    put("");
    put("// text to numbers, as a Result (String.to_int() / to_double() throw instead)");
    put("struct Num {");
    put("    static Result<int, Error> parse_int(String s) {");
    put("        int v = 0;");
    put("        try { v = s.to_int(); } catch (e) {");
    put("            return Result<int, Error>::Err(Error::make(ErrorKind::Parse, \"not a whole number: \" + s));");
    put("        }");
    put("        return Result<int, Error>::Ok(v);");
    put("    }");
    put("    static Result<double, Error> parse_double(String s) {");
    put("        double v = 0.0;");
    put("        try { v = s.to_double(); } catch (e) {");
    put("            return Result<double, Error>::Err(Error::make(ErrorKind::Parse, \"not a number: \" + s));");
    put("        }");
    put("        return Result<double, Error>::Ok(v);");
    put("    }");
    put("}");
    put("");
    put("// running other programs. The program is looked for in the folders of PATH unless its name has a /.");
    put("//   int code = Proc::run(\"ls\", args)?;            (the output goes where the program's own goes)");
    put("//   String text = Proc::output(\"echo\", args)?;    (the output is returned as text)");
    put("struct Proc {");
    put("    // starts a child (stdout to wfd when wfd >= 0); returns its id, or a negative error number");
    put("    static int launch(String cmd, String[] args, int wfd) {");
    put("        int na = args.len;");
    put("        int^ argv = (int^)Mem::alloc(8 * (na + 2));");
    put("        argv[0] = (int)cmd.c();");
    put("        for i in 0..na { argv[i + 1] = (int)args[i].c(); }");
    put("        argv[na + 1] = 0;");
    put("        int ne = 0;");
    put("        while arg(argc() + 1 + ne) != null { ne += 1; }");
    put("        int^ envp = (int^)Mem::alloc(8 * (ne + 1));");
    put("        for i in 0..ne { envp[i] = (int)arg(argc() + 1 + i); }");
    put("        envp[ne] = 0;");
    put("        int pid = syscall(220, 17, 0, 0, 0, 0);");
    put("        if pid == 0 {");
    put("            if wfd >= 0 { syscall(24, wfd, 1, 0); }");
    put("            bool slash = false;");
    put("            for i in 0..cmd.len { if cmd[i] == '/' { slash = true; } }");
    put("            if slash {");
    put("                syscall(221, cmd.c(), argv, envp);");
    put("            } else {");
    put("                String path = \"\";");
    put("                switch Env::get(\"PATH\") {");
    put("                    Option::Some(p): path.append(p.c());");
    put("                    Option::None: path.append(\"/usr/bin:/bin\");");
    put("                }");
    put("                int start = 0;");
    put("                for i in 0..path.len + 1 {");
    put("                    if i == path.len || path[i] == ':' {");
    put("                        String full = path.slice(start, i) + \"/\" + cmd;");
    put("                        syscall(221, full.c(), argv, envp);");
    put("                        start = i + 1;");
    put("                    }");
    put("                }");
    put("            }");
    put("            syscall(93, 127);");
    put("        }");
    put("        Mem::free(argv);");
    put("        Mem::free(envp);");
    put("        return pid;");
    put("    }");
    put("    // waits for the child; its exit code (128 + the signal if it was killed)");
    put("    static int finish(int pid) {");
    put("        int status = 0;");
    put("        syscall(260, pid, @status, 0, 0);");
    put("        int sig = status & 127;");
    put("        if sig != 0 { return 128 + sig; }");
    put("        return (status >> 8) & 255;");
    put("    }");
    put("    // runs a program and waits for it; its exit code (127 if it could not be started)");
    put("    static Result<int, Error> run(String cmd, String[] args) {");
    put("        int pid = Proc::launch(cmd, args, -1);");
    put("        if pid < 0 { return Result<int, Error>::Err(Error::make(ErrorKind::Other, \"cannot start \" + cmd)); }");
    put("        return Result<int, Error>::Ok(Proc::finish(pid));");
    put("    }");
    put("    // runs a program, waits for it and returns what it wrote to its output");
    put("    static Result<String, Error> output(String cmd, String[] args) {");
    put("        int fds[1];");
    put("        int rc = syscall(59, @fds, 0);");
    put("        if rc < 0 { return Result<String, Error>::Err(Error::make(ErrorKind::Io, \"cannot make a pipe\")); }");
    put("        int rfd = fds[0] & 4294967295;");
    put("        int wfd = fds[0] >> 32;");
    put("        int pid = Proc::launch(cmd, args, wfd);");
    put("        syscall(57, wfd);");
    put("        if pid < 0 {");
    put("            syscall(57, rfd);");
    put("            return Result<String, Error>::Err(Error::make(ErrorKind::Other, \"cannot start \" + cmd));");
    put("        }");
    put("        String text = \"\";");
    put("        char buf[4096];");
    put("        int n = syscall(63, rfd, @buf, 4095);");
    put("        while n > 0 {");
    put("            buf[n] = 0;");
    put("            text.append((char^)@buf);");
    put("            n = syscall(63, rfd, @buf, 4095);");
    put("        }");
    put("        syscall(57, rfd);");
    put("        Proc::finish(pid);");
    put("        return Result<String, Error>::Ok(text);");
    put("    }");
    put("}");
    put("");
    put("// SHA-256 (FIPS 180-4): a 256-bit fingerprint of data, as 64 hex digits.");
    put("//   String h = Sha256::hex(\"abc\");            // ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
    put("//   String f = Sha256::file(\"jcmp\")?;         // the same for a file (any bytes)");
    put("struct Sha256 {");
    put("    static void init(int^ st) {");
    put("        st[0] = 0x6a09e667;");
    put("        st[1] = 0xbb67ae85;");
    put("        st[2] = 0x3c6ef372;");
    put("        st[3] = 0xa54ff53a;");
    put("        st[4] = 0x510e527f;");
    put("        st[5] = 0x9b05688c;");
    put("        st[6] = 0x1f83d9ab;");
    put("        st[7] = 0x5be0cd19;");
    put("    }");
    put("    static void constants(int^ st) {");
    put("        st[8] = 0x428a2f98;");
    put("        st[9] = 0x71374491;");
    put("        st[10] = 0xb5c0fbcf;");
    put("        st[11] = 0xe9b5dba5;");
    put("        st[12] = 0x3956c25b;");
    put("        st[13] = 0x59f111f1;");
    put("        st[14] = 0x923f82a4;");
    put("        st[15] = 0xab1c5ed5;");
    put("        st[16] = 0xd807aa98;");
    put("        st[17] = 0x12835b01;");
    put("        st[18] = 0x243185be;");
    put("        st[19] = 0x550c7dc3;");
    put("        st[20] = 0x72be5d74;");
    put("        st[21] = 0x80deb1fe;");
    put("        st[22] = 0x9bdc06a7;");
    put("        st[23] = 0xc19bf174;");
    put("        st[24] = 0xe49b69c1;");
    put("        st[25] = 0xefbe4786;");
    put("        st[26] = 0x0fc19dc6;");
    put("        st[27] = 0x240ca1cc;");
    put("        st[28] = 0x2de92c6f;");
    put("        st[29] = 0x4a7484aa;");
    put("        st[30] = 0x5cb0a9dc;");
    put("        st[31] = 0x76f988da;");
    put("        st[32] = 0x983e5152;");
    put("        st[33] = 0xa831c66d;");
    put("        st[34] = 0xb00327c8;");
    put("        st[35] = 0xbf597fc7;");
    put("        st[36] = 0xc6e00bf3;");
    put("        st[37] = 0xd5a79147;");
    put("        st[38] = 0x06ca6351;");
    put("        st[39] = 0x14292967;");
    put("        st[40] = 0x27b70a85;");
    put("        st[41] = 0x2e1b2138;");
    put("        st[42] = 0x4d2c6dfc;");
    put("        st[43] = 0x53380d13;");
    put("        st[44] = 0x650a7354;");
    put("        st[45] = 0x766a0abb;");
    put("        st[46] = 0x81c2c92e;");
    put("        st[47] = 0x92722c85;");
    put("        st[48] = 0xa2bfe8a1;");
    put("        st[49] = 0xa81a664b;");
    put("        st[50] = 0xc24b8b70;");
    put("        st[51] = 0xc76c51a3;");
    put("        st[52] = 0xd192e819;");
    put("        st[53] = 0xd6990624;");
    put("        st[54] = 0xf40e3585;");
    put("        st[55] = 0x106aa070;");
    put("        st[56] = 0x19a4c116;");
    put("        st[57] = 0x1e376c08;");
    put("        st[58] = 0x2748774c;");
    put("        st[59] = 0x34b0bcb5;");
    put("        st[60] = 0x391c0cb3;");
    put("        st[61] = 0x4ed8aa4a;");
    put("        st[62] = 0x5b9cca4f;");
    put("        st[63] = 0x682e6ff3;");
    put("        st[64] = 0x748f82ee;");
    put("        st[65] = 0x78a5636f;");
    put("        st[66] = 0x84c87814;");
    put("        st[67] = 0x8cc70208;");
    put("        st[68] = 0x90befffa;");
    put("        st[69] = 0xa4506ceb;");
    put("        st[70] = 0xbef9a3f7;");
    put("        st[71] = 0xc67178f2;");
    put("    }");
    put("    static int rotr(int x, int n) {");
    put("        return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF;");
    put("    }");
    put("    // one block of 64 bytes at p");
    put("    static void block(int^ st, char^ p) {");
    put("        for i in 0..16 {");
    put("            st[72 + i] = ((p[i * 4] & 255) << 24) | ((p[i * 4 + 1] & 255) << 16) | ((p[i * 4 + 2] & 255) << 8) | (p[i * 4 + 3] & 255);");
    put("        }");
    put("        for i in 16..64 {");
    put("            int s0 = Sha256::rotr(st[72 + i - 15], 7) xor Sha256::rotr(st[72 + i - 15], 18) xor (st[72 + i - 15] >> 3);");
    put("            int s1 = Sha256::rotr(st[72 + i - 2], 17) xor Sha256::rotr(st[72 + i - 2], 19) xor (st[72 + i - 2] >> 10);");
    put("            st[72 + i] = (st[72 + i - 16] + s0 + st[72 + i - 7] + s1) & 0xFFFFFFFF;");
    put("        }");
    put("        int a = st[0];");
    put("        int b = st[1];");
    put("        int c = st[2];");
    put("        int d = st[3];");
    put("        int e = st[4];");
    put("        int f = st[5];");
    put("        int g = st[6];");
    put("        int hh = st[7];");
    put("        for i in 0..64 {");
    put("            int s1 = Sha256::rotr(e, 6) xor Sha256::rotr(e, 11) xor Sha256::rotr(e, 25);");
    put("            int ch = (e & f) xor ((e xor 0xFFFFFFFF) & g);");
    put("            int t1 = (hh + s1 + ch + st[8 + i] + st[72 + i]) & 0xFFFFFFFF;");
    put("            int s0 = Sha256::rotr(a, 2) xor Sha256::rotr(a, 13) xor Sha256::rotr(a, 22);");
    put("            int maj = (a & b) xor (a & c) xor (b & c);");
    put("            int t2 = (s0 + maj) & 0xFFFFFFFF;");
    put("            hh = g;");
    put("            g = f;");
    put("            f = e;");
    put("            e = (d + t1) & 0xFFFFFFFF;");
    put("            d = c;");
    put("            c = b;");
    put("            b = a;");
    put("            a = (t1 + t2) & 0xFFFFFFFF;");
    put("        }");
    put("        st[0] = (st[0] + a) & 0xFFFFFFFF;");
    put("        st[1] = (st[1] + b) & 0xFFFFFFFF;");
    put("        st[2] = (st[2] + c) & 0xFFFFFFFF;");
    put("        st[3] = (st[3] + d) & 0xFFFFFFFF;");
    put("        st[4] = (st[4] + e) & 0xFFFFFFFF;");
    put("        st[5] = (st[5] + f) & 0xFFFFFFFF;");
    put("        st[6] = (st[6] + g) & 0xFFFFFFFF;");
    put("        st[7] = (st[7] + hh) & 0xFFFFFFFF;");
    put("    }");
    put("    // the last bytes (tn < 64) of a message of total bytes, padded; then the digest as hex");
    put("    static String finish(int^ st, char^ tail, int tn, int total) {");
    put("        char buf[128];");
    put("        for i in 0..128 { buf[i] = 0; }");
    put("        for i in 0..tn { buf[i] = tail[i]; }");
    put("        buf[tn] = (char)128;");
    put("        int n = 64;");
    put("        if tn >= 56 { n = 128; }");
    put("        int bits = total * 8;");
    put("        for i in 0..8 { buf[n - 1 - i] = (char)((bits >> (i * 8)) & 255); }");
    put("        Sha256::block(st, (char^)@buf);");
    put("        if n == 128 { Sha256::block(st, (char^)@buf + 64); }");
    put("        String digits = \"0123456789abcdef\";");
    put("        String r = \"\";");
    put("        for i in 0..8 {");
    put("            for j in 0..8 {");
    put("                int nib = (st[i] >> (28 - j * 4)) & 15;");
    put("                r.push(digits[nib]);");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    // the digest of the bytes of a String");
    put("    static String hex(String s) {");
    put("        int st[136];                 // h (8), k (64), w (64)");
    put("        Sha256::init((int^)@st);");
    put("        Sha256::constants((int^)@st);");
    put("        char^ p = s.c();");
    put("        int n = s.len;");
    put("        int pos = 0;");
    put("        while n - pos >= 64 {");
    put("            Sha256::block((int^)@st, p + pos);");
    put("            pos += 64;");
    put("        }");
    put("        return Sha256::finish((int^)@st, p + pos, n - pos, n);");
    put("    }");
    put("    // the digest of the bytes of a file");
    put("    static Result<String, Error> file(String path) {");
    put("        int fd = syscall(56, -100, path.c(), 0, 0);");
    put("        if fd < 0 { return Result<String, Error>::Err(Fs::error(fd, \"cannot open \", path)); }");
    put("        int st[136];                 // h (8), k (64), w (64)");
    put("        Sha256::init((int^)@st);");
    put("        Sha256::constants((int^)@st);");
    put("        char buf[4096];");
    put("        int total = 0;");
    put("        int have = 0;");
    put("        bool more = true;");
    put("        while more {");
    put("            // fill the buffer (a read may give less than asked)");
    put("            have = 0;");
    put("            while have < 4096 {");
    put("                int n = syscall(63, fd, (char^)@buf + have, 4096 - have);");
    put("                if n < 0 {");
    put("                    syscall(57, fd);");
    put("                    return Result<String, Error>::Err(Fs::error(n, \"cannot read \", path));");
    put("                }");
    put("                if n == 0 {");
    put("                    more = false;");
    put("                    break;");
    put("                }");
    put("                have += n;");
    put("            }");
    put("            total += have;");
    put("            int pos = 0;");
    put("            while have - pos >= 64 {");
    put("                Sha256::block((int^)@st, (char^)@buf + pos);");
    put("                pos += 64;");
    put("            }");
    put("            if !more {");
    put("                syscall(57, fd);");
    put("                return Result<String, Error>::Ok(Sha256::finish((int^)@st, (char^)@buf + pos, have - pos, total));");
    put("            }");
    put("        }");
    put("        return Result<String, Error>::Ok(\"\");");
    put("    }");
    put("}");
    put("");
    put("");
    put("// JSON: Json::parse(text) gives a document, a table of nodes; a node is a number (-1 means \"none\").");
    put("//   JsonDoc doc = Json::parse(text)?;");
    put("//   int name = doc.get(doc.root(), \"name\");          String s = doc.text(name);");
    put("//   int first = doc.at(doc.get(doc.root(), \"list\"), 0);    double d = doc.number(first);");
    put("//   String out = doc.dump(doc.root());               // back to (compact) JSON text");
    put("// json_quote(s) makes a JSON string literal; json_num_text(x) is a number as text.");
    put("// helpers (also reachable as Json::quote and Json::num_text)");
    put("String json_int_text(int v) {");
    put("    String r = \"\";");
    put("    if v < 0 {");
    put("        r.push('-');");
    put("        v = 0 - v;");
    put("    }");
    put("    char buf[24];");
    put("    int n = 0;");
    put("    if v == 0 {");
    put("        buf[0] = '0';");
    put("        n = 1;");
    put("    }");
    put("    while v > 0 {");
    put("        buf[n] = (char)('0' + v % 10);");
    put("        n += 1;");
    put("        v = v / 10;");
    put("    }");
    put("    while n > 0 {");
    put("        n -= 1;");
    put("        r.push(buf[n]);");
    put("    }");
    put("    return r;");
    put("}");
    put("// a number as the shortest text that reads back the same (up to 15 digits); nan and inf are null");
    put("String json_num_text(double x) {");
    put("    if x != x || x > 1.0e22 || x < -1.0e22 { return \"null\"; }");
    put("    String r = \"\";");
    put("    if x < 0.0 {");
    put("        r.push('-');");
    put("        x = 0.0 - x;");
    put("    }");
    put("    if x < 9.0e15 {");
    put("        int ip = (int)x;");
    put("        r.append(json_int_text(ip));");
    put("        double fp = x - (double)ip;");
    put("        if fp > 0.0 {");
    put("            String f = \"\";");
    put("            int k = 0;");
    put("            while k < 15 && fp > 0.0 {");
    put("                fp = fp * 10.0;");
    put("                int d = (int)fp;");
    put("                f.push((char)('0' + d));");
    put("                fp = fp - (double)d;");
    put("                k += 1;");
    put("            }");
    put("            // drop zeros at the end");
    put("            int cut = f.len;");
    put("            while cut > 0 && f[cut - 1] == '0' { cut -= 1; }");
    put("            if cut > 0 {");
    put("                r.push('.');");
    put("                r.append(f.slice(0, cut));");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    // very large numbers: whole digits only");
    put("    r.append(json_int_text((int)(x / 1.0e10)));");
    put("    r.append(\"0000000000\");");
    put("    return r;");
    put("}");
    put("// a JSON string literal for s (with the quotes)");
    put("String json_quote(String s) {");
    put("    String r = \"\\\"\";");
    put("    String hex = \"0123456789abcdef\";");
    put("    for i in 0..s.len {");
    put("        char c = s[i];");
    put("        if c == '\"' {");
    put("            r.append(\"\\\\\\\"\");");
    put("        } else if c == 92 {");
    put("            r.append(\"\\\\\\\\\");");
    put("        } else if c == 10 {");
    put("            r.append(\"\\\\n\");");
    put("        } else if c == 13 {");
    put("            r.append(\"\\\\r\");");
    put("        } else if c == 9 {");
    put("            r.append(\"\\\\t\");");
    put("        } else if c < 32 {");
    put("            r.append(\"\\\\u00\");");
    put("            r.push(hex[c / 16]);");
    put("            r.push(hex[c % 16]);");
    put("        } else {");
    put("            r.push(c);");
    put("        }");
    put("    }");
    put("    r.push('\"');");
    put("    return r;");
    put("}");
    put("");
    put("struct JsonDoc {");
    put("    String src;");
    put("    int pos;");
    put("    String err;");
    put("    int[] kind;                  // 0 null, 1 false, 2 true, 3 number, 4 string, 5 array, 6 object");
    put("    double[] num;");
    put("    String[] txt;                // the value of a string node");
    put("    String[] key;                // the name of a node that is a member of an object");
    put("    int[] first;                 // the first child (array, object)");
    put("    int[] last;");
    put("    int[] next;                  // the next brother");
    put("    void free(self) {");
    put("        self.src.free();");
    put("        self.err.free();");
    put("        self.kind.free();");
    put("        self.num.free();");
    put("        self.txt.free();");
    put("        self.key.free();");
    put("        self.first.free();");
    put("        self.last.free();");
    put("        self.next.free();");
    put("    }");
    put("    // ---- reading (JsonDoc is made by Json::parse)");
    put("    int fail(self, String m) {");
    put("        if self.err.len == 0 {");
    put("            String t = m;");
    put("            t.append(\" at byte \");");
    put("            t.append(json_int_text(self.pos));");
    put("            self.err = t;");
    put("        }");
    put("        return -1;");
    put("    }");
    put("    void skip_ws(self) {");
    put("        while self.pos < self.src.len {");
    put("            char c = self.src[self.pos];");
    put("            if c == 32 || c == 10 || c == 13 || c == 9 {");
    put("                self.pos += 1;");
    put("            } else {");
    put("                return;");
    put("            }");
    put("        }");
    put("    }");
    put("    // a new node; its text and name are stored with it");
    put("    int add(self, int k, String t, String name) {");
    put("        self.kind.push(k);");
    put("        self.num.push(0.0);");
    put("        self.txt.push(t);");
    put("        self.key.push(name);");
    put("        self.first.push(-1);");
    put("        self.last.push(-1);");
    put("        self.next.push(-1);");
    put("        return self.kind.len - 1;");
    put("    }");
    put("    // puts node c at the end of the children of node p");
    put("    void link(self, int p, int c) {");
    put("        if self.first[p] < 0 {");
    put("            self.first[p] = c;");
    put("        } else {");
    put("            self.next[self.last[p]] = c;");
    put("        }");
    put("        self.last[p] = c;");
    put("    }");
    put("    bool word(self, String w) {");
    put("        if self.pos + w.len > self.src.len { return false; }");
    put("        for i in 0..w.len {");
    put("            if self.src[self.pos + i] != w[i] { return false; }");
    put("        }");
    put("        self.pos += w.len;");
    put("        return true;");
    put("    }");
    put("    int value(self, String name) {");
    put("        self.skip_ws();");
    put("        if self.pos >= self.src.len { return self.fail(\"unexpected end of the text\"); }");
    put("        char c = self.src[self.pos];");
    put("        if c == '{' { return self.object(name); }");
    put("        if c == '[' { return self.array(name); }");
    put("        if c == '\"' {");
    put("            String s = self.string_lit();");
    put("            if self.err.len > 0 { return -1; }");
    put("            return self.add(4, s, name);");
    put("        }");
    put("        if self.word(\"true\") { return self.add(2, \"\", name); }");
    put("        if self.word(\"false\") { return self.add(1, \"\", name); }");
    put("        if self.word(\"null\") { return self.add(0, \"\", name); }");
    put("        if c == '-' || (c >= '0' && c <= '9') { return self.number_lit(name); }");
    put("        return self.fail(\"unexpected character\");");
    put("    }");
    put("    int number_lit(self, String name) {");
    put("        int a = self.pos;");
    put("        if self.src[self.pos] == '-' { self.pos += 1; }");
    put("        while self.pos < self.src.len {");
    put("            char c = self.src[self.pos];");
    put("            if (c >= '0' && c <= '9') || c == '.' || c == 'e' || c == 'E' || c == '+' || c == '-' {");
    put("                self.pos += 1;");
    put("            } else {");
    put("                break;");
    put("            }");
    put("        }");
    put("        double v = 0.0;");
    put("        try { v = self.src.slice(a, self.pos).to_double(); } catch (e) {");
    put("            return self.fail(\"bad number\");");
    put("        }");
    put("        int n = self.add(3, \"\", name);");
    put("        self.num[n] = v;");
    put("        return n;");
    put("    }");
    put("    int hex4(self) {");
    put("        if self.pos + 4 > self.src.len { return -1; }");
    put("        int v = 0;");
    put("        for i in 0..4 {");
    put("            char c = self.src[self.pos + i];");
    put("            int d = -1;");
    put("            if c >= '0' && c <= '9' { d = c - '0'; }");
    put("            if c >= 'a' && c <= 'f' { d = c - 'a' + 10; }");
    put("            if c >= 'A' && c <= 'F' { d = c - 'A' + 10; }");
    put("            if d < 0 { return -1; }");
    put("            v = v * 16 + d;");
    put("        }");
    put("        self.pos += 4;");
    put("        return v;");
    put("    }");
    put("    // the string at pos (which is the opening quote); the text is decoded; err is set on a mistake");
    put("    String string_lit(self) {");
    put("        String r = \"\";");
    put("        self.pos += 1;");
    put("        while true {");
    put("            if self.pos >= self.src.len {");
    put("                self.fail(\"the string is not closed\");");
    put("                return r;");
    put("            }");
    put("            char c = self.src[self.pos];");
    put("            self.pos += 1;");
    put("            if c == '\"' { return r; }");
    put("            if c < 32 {");
    put("                self.fail(\"a control character in a string\");");
    put("                return r;");
    put("            }");
    put("            if c != 92 {");
    put("                r.push(c);");
    put("            } else {");
    put("                if self.pos >= self.src.len {");
    put("                    self.fail(\"the string is not closed\");");
    put("                    return r;");
    put("                }");
    put("                char e = self.src[self.pos];");
    put("                self.pos += 1;");
    put("                if e == 'n' { r.push((char)10); }");
    put("                else if e == 't' { r.push((char)9); }");
    put("                else if e == 'r' { r.push((char)13); }");
    put("                else if e == 'b' { r.push((char)8); }");
    put("                else if e == 'f' { r.push((char)12); }");
    put("                else if e == '\"' || e == 92 || e == '/' { r.push(e); }");
    put("                else if e == 'u' {");
    put("                    int cp = self.hex4();");
    put("                    if cp < 0 {");
    put("                        self.fail(\"bad \\\\u escape\");");
    put("                        return r;");
    put("                    }");
    put("                    if cp >= 0xD800 && cp <= 0xDBFF && self.pos + 1 < self.src.len && self.src[self.pos] == 92 && self.src[self.pos + 1] == 'u' {");
    put("                        int save = self.pos;");
    put("                        self.pos += 2;");
    put("                        int lo = self.hex4();");
    put("                        if lo >= 0xDC00 && lo <= 0xDFFF {");
    put("                            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);");
    put("                        } else {");
    put("                            self.pos = save;");
    put("                        }");
    put("                    }");
    put("                    if cp < 0x80 {");
    put("                        r.push((char)cp);");
    put("                    } else if cp < 0x800 {");
    put("                        r.push((char)(0xC0 | (cp >> 6)));");
    put("                        r.push((char)(0x80 | (cp & 63)));");
    put("                    } else if cp < 0x10000 {");
    put("                        r.push((char)(0xE0 | (cp >> 12)));");
    put("                        r.push((char)(0x80 | ((cp >> 6) & 63)));");
    put("                        r.push((char)(0x80 | (cp & 63)));");
    put("                    } else {");
    put("                        r.push((char)(0xF0 | (cp >> 18)));");
    put("                        r.push((char)(0x80 | ((cp >> 12) & 63)));");
    put("                        r.push((char)(0x80 | ((cp >> 6) & 63)));");
    put("                        r.push((char)(0x80 | (cp & 63)));");
    put("                    }");
    put("                } else {");
    put("                    self.fail(\"unknown escape\");");
    put("                    return r;");
    put("                }");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    int array(self, String name) {");
    put("        int me = self.add(5, \"\", name);");
    put("        self.pos += 1;");
    put("        self.skip_ws();");
    put("        if self.pos < self.src.len && self.src[self.pos] == ']' {");
    put("            self.pos += 1;");
    put("            return me;");
    put("        }");
    put("        while true {");
    put("            int c = self.value(\"\");");
    put("            if c < 0 { return -1; }");
    put("            self.link(me, c);");
    put("            self.skip_ws();");
    put("            if self.pos >= self.src.len { return self.fail(\"the array is not closed\"); }");
    put("            char d = self.src[self.pos];");
    put("            self.pos += 1;");
    put("            if d == ']' { return me; }");
    put("            if d != ',' { return self.fail(\"a , or ] was expected\"); }");
    put("        }");
    put("        return me;");
    put("    }");
    put("    int object(self, String name) {");
    put("        int me = self.add(6, \"\", name);");
    put("        self.pos += 1;");
    put("        self.skip_ws();");
    put("        if self.pos < self.src.len && self.src[self.pos] == '}' {");
    put("            self.pos += 1;");
    put("            return me;");
    put("        }");
    put("        while true {");
    put("            self.skip_ws();");
    put("            if self.pos >= self.src.len || self.src[self.pos] != '\"' { return self.fail(\"a name in quotes was expected\"); }");
    put("            String k = self.string_lit();");
    put("            if self.err.len > 0 { return -1; }");
    put("            self.skip_ws();");
    put("            if self.pos >= self.src.len || self.src[self.pos] != ':' { return self.fail(\"a : was expected\"); }");
    put("            self.pos += 1;");
    put("            int c = self.value(k);");
    put("            if c < 0 { return -1; }");
    put("            self.link(me, c);");
    put("            self.skip_ws();");
    put("            if self.pos >= self.src.len { return self.fail(\"the object is not closed\"); }");
    put("            char d = self.src[self.pos];");
    put("            self.pos += 1;");
    put("            if d == '}' { return me; }");
    put("            if d != ',' { return self.fail(\"a , or } was expected\"); }");
    put("        }");
    put("        return me;");
    put("    }");
    put("");
    put("    // ---- looking at a document (n is a node; -1 or a wrong kind gives an empty answer)");
    put("    int root(self) { return 0; }");
    put("    // 0 null, 1 false, 2 true, 3 number, 4 string, 5 array, 6 object; -1 for no node");
    put("    int kind_of(self, int n) {");
    put("        if n < 0 || n >= self.kind.len { return -1; }");
    put("        return self.kind[n];");
    put("    }");
    put("    int len(self, int n) {");
    put("        int k = self.kind_of(n);");
    put("        if k != 5 && k != 6 { return 0; }");
    put("        int c = self.first[n];");
    put("        int count = 0;");
    put("        while c >= 0 {");
    put("            count += 1;");
    put("            c = self.next[c];");
    put("        }");
    put("        return count;");
    put("    }");
    put("    // the i-th element of an array or member of an object (counted from 0), or -1");
    put("    int at(self, int n, int i) {");
    put("        int k = self.kind_of(n);");
    put("        if k != 5 && k != 6 { return -1; }");
    put("        int c = self.first[n];");
    put("        while c >= 0 && i > 0 {");
    put("            c = self.next[c];");
    put("            i -= 1;");
    put("        }");
    put("        return c;");
    put("    }");
    put("    // the member of an object with this name, or -1");
    put("    int get(self, int n, String name) {");
    put("        if self.kind_of(n) != 6 { return -1; }");
    put("        int c = self.first[n];");
    put("        while c >= 0 {");
    put("            if self.key[c] == name { return c; }");
    put("            c = self.next[c];");
    put("        }");
    put("        return -1;");
    put("    }");
    put("    bool has(self, int n, String name) { return self.get(n, name) >= 0; }");
    put("    // the name of a node that is a member of an object");
    put("    String name_of(self, int n) {");
    put("        if n < 0 || n >= self.kind.len { return \"\"; }");
    put("        String r = \"\";");
    put("        r.append(self.key[n]);");
    put("        return r;");
    put("    }");
    put("    String text(self, int n) {");
    put("        if self.kind_of(n) != 4 { return \"\"; }");
    put("        String r = \"\";");
    put("        r.append(self.txt[n]);");
    put("        return r;");
    put("    }");
    put("    double number(self, int n) {");
    put("        if self.kind_of(n) != 3 { return 0.0; }");
    put("        return self.num[n];");
    put("    }");
    put("    int integer(self, int n) { return (int)self.number(n); }");
    put("    bool boolean(self, int n) { return self.kind_of(n) == 2; }");
    put("    bool is_null(self, int n) { return self.kind_of(n) == 0; }");
    put("");
    put("    // ---- writing: the node and what is below it as compact JSON text");
    put("    String dump(self, int n) {");
    put("        String r = \"\";");
    put("        int k = self.kind_of(n);");
    put("        if k <= 0 {");
    put("            r.append(\"null\");");
    put("        } else if k == 1 {");
    put("            r.append(\"false\");");
    put("        } else if k == 2 {");
    put("            r.append(\"true\");");
    put("        } else if k == 3 {");
    put("            r.append(json_num_text(self.num[n]));");
    put("        } else if k == 4 {");
    put("            r.append(json_quote(self.txt[n]));");
    put("        } else if k == 5 {");
    put("            r.push('[');");
    put("            int c = self.first[n];");
    put("            while c >= 0 {");
    put("                if c != self.first[n] { r.push(','); }");
    put("                r.append(self.dump(c));");
    put("                c = self.next[c];");
    put("            }");
    put("            r.push(']');");
    put("        } else {");
    put("            r.push('{');");
    put("            int c = self.first[n];");
    put("            while c >= 0 {");
    put("                if c != self.first[n] { r.push(','); }");
    put("                r.append(json_quote(self.key[c]));");
    put("                r.push(':');");
    put("                r.append(self.dump(c));");
    put("                c = self.next[c];");
    put("            }");
    put("            r.push('}');");
    put("        }");
    put("        return r;");
    put("    }");
    put("}");
    put("");
    put("// the entry points: Json::parse(text), Json::quote(s), Json::num_text(x)");
    put("struct Json {");
    put("    static String quote(String s) { return json_quote(s); }");
    put("    static String num_text(double x) { return json_num_text(x); }");
    put("    static Result<JsonDoc, Error> parse(String text) {");
    put("        JsonDoc j;");
    put("        j.src = text;");
    put("        j.pos = 0;");
    put("        j.err = \"\";");
    put("        j.kind = arr(16);");
    put("        j.num = arr(16);");
    put("        j.txt = arr(16);");
    put("        j.key = arr(16);");
    put("        j.first = arr(16);");
    put("        j.last = arr(16);");
    put("        j.next = arr(16);");
    put("        int root = j.value(\"\");");
    put("        if root >= 0 {");
    put("            j.skip_ws();");
    put("            if j.pos < j.src.len { root = j.fail(\"extra text after the value\"); }");
    put("        }");
    put("        if root < 0 {");
    put("            return Result<JsonDoc, Error>::Err(Error::make(ErrorKind::Parse, j.err));");
    put("        }");
    put("        return Result<JsonDoc, Error>::Ok(j);");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}

// push_cpu(): `import cpu` -- threads and locks.
void push_cpu() {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    lvl_lib[lx_depth] = 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    put("// cpu: threads and locks.   import cpu    using cpu::thread    using cpu::mutex");
    put("//");
    put("//   void work(void^ arg) { ... }");
    put("//   Thread t = create(work, @data);   t.join();      or  t.detach();");
    put("//   Mutex m;   m.lock();  ...  m.unlock();");
    put("//");
    put("// A Thread value is a handle: copies of it refer to the same thread. The thread runs on its own");
    put("// 1 MB stack (taken from the system); join() gives the stack back. A detached thread cannot free its");
    put("// own stack, so that memory stays until the program ends.");
    put("");
    put("struct Mutex {");
    put("    int state;                         // 0 free, 1 taken, 2 taken and somebody waits");
    put("");
    put("    void init(self) {");
    put("        self.state = 0;");
    put("    }");
    put("    void lock(self) {");
    put("        int^ w = @self.state;");
    put("        int c = __cas(w, 0, 1);");
    put("        if c == 0 { return; }");
    put("        if c != 2 { c = __xchg(w, 2); }");
    put("        while c != 0 {");
    put("            syscall(98, w, 128, 2, 0, 0, 0);           // futex wait: sleep while the word is 2");
    put("            c = __xchg(w, 2);");
    put("        }");
    put("    }");
    put("    void unlock(self) {");
    put("        int^ w = @self.state;");
    put("        int old = __xchg(w, 0);");
    put("        if old == 2 { syscall(98, w, 129, 1, 0, 0, 0); }     // futex wake: one waiter");
    put("    }");
    put("    // true if the lock was free and is now yours");
    put("    bool try_lock(self) {");
    put("        int^ w = @self.state;");
    put("        return __cas(w, 0, 1) == 0;");
    put("    }");
    put("}");
    put("");
    put("struct Thread {");
    put("    int^ cb;                           // [0] thread id (the kernel makes it 0 when the thread ends), [1] stack, [2] size, [3] detached");
    put("");
    put("    // start function(arg) in a new thread");
    put("    static Thread create(void(void^)^ f, void^ arg) {");
    put("        int size = 1048576;");
    put("        int base = syscall(222, 0, size, 3, 34, -1, 0);       // mmap: the stack (zeroed)");
    put("        if base < 0 { throw \"cannot create the thread: no memory for its stack\"; }");
    put("        int^ cb = (int^)Mem::alloc(32);");
    put("        if (int)cb == 0 { throw \"cannot create the thread: out of memory\"; }");
    put("        cb[1] = base;");
    put("        cb[2] = size;");
    put("        cb[3] = 0;");
    put("        int block = base + size - 1024;                        // the thread's own block (try/catch state) at the top");
    put("        int tid = __thread_start(f, arg, block, (int)cb, block);");
    put("        if tid < 0 {");
    put("            syscall(215, base, size);");
    put("            Mem::free(cb);");
    put("            throw \"cannot create the thread\";");
    put("        }");
    put("        Thread t;");
    put("        t.cb = cb;");
    put("        return t;");
    put("    }");
    put("    // wait until the thread has ended");
    put("    void join(self) {");
    put("        int^ cb = self.cb;");
    put("        if (int)cb == 0 { throw \"join: this is not a running or finished thread\"; }");
    put("        if cb[3] != 0 { throw \"cannot join a detached thread\"; }");
    put("        while cb[0] != 0 {");
    put("            syscall(98, cb, 0, cb[0], 0, 0, 0);                // futex wait (not the private kind: the kernel wakes the shared one at thread exit)");
    put("        }");
    put("        syscall(215, cb[1], cb[2]);                            // give the stack back");
    put("        Mem::free(cb);");
    put("        self.cb = null;");
    put("    }");
    put("    // let the thread run on its own; it cannot be joined any more");
    put("    void detach(self) {");
    put("        int^ cb = self.cb;");
    put("        if (int)cb == 0 { throw \"detach: this is not a thread\"; }");
    put("        if cb[3] != 0 { throw \"the thread is already detached\"; }");
    put("        cb[3] = 1;");
    put("    }");
    put("    bool is_running(self) {");
    put("        int^ cb = self.cb;");
    put("        if (int)cb == 0 { return false; }");
    put("        return cb[0] != 0;");
    put("    }");
    put("    // pause the calling thread for ms milliseconds");
    put("    static void sleep(int ms) {");
    put("        int ts[2];");
    put("        ts[0] = ms / 1000;");
    put("        ts[1] = ms % 1000 * 1000000;");
    put("        syscall(101, @ts, 0);");
    put("    }");
    put("    static void yield() {");
    put("        syscall(124);");
    put("    }");
    put("    static int id() {");
    put("        return syscall(178);");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}

// push_vector(): `import <vector>` -- Vec2, Vec3, Vec4.
void push_vector() {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    lvl_lib[lx_depth] = 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    put("// vec2, vec3, vec4: vectors of doubles.   #import <math>   using math::vector;");
    put("//   vec3 p = {1.0, 2.0, 3.0};   p += v * dt;   double l = p.normalize().dot(light);");
    put("// operators: a + b, a - b, a * k, a / k, a == b, a != b and a += b (methods declared with the word operator)");
    put("");
    put("struct vec2 {");
    put("    double x;");
    put("    double y;");
    put("    static vec2 make(double x, double y) {");
    put("        vec2 r;");
    put("        r.x = x;");
    put("        r.y = y;");
    put("        return r;");
    put("    }");
    put("    static vec2 zero() { return vec2::make(0.0, 0.0); }");
    put("    static vec2 splat(double v) { return vec2::make(v, v); }");
    put("    operator vec2 add(self, vec2 o) { return vec2::make(self.x + o.x, self.y + o.y); }");
    put("    operator vec2 sub(self, vec2 o) { return vec2::make(self.x - o.x, self.y - o.y); }");
    put("    vec2 mulv(self, vec2 o) { return vec2::make(self.x * o.x, self.y * o.y); }");
    put("    vec2 divv(self, vec2 o) { return vec2::make(self.x / o.x, self.y / o.y); }");
    put("    operator vec2 mul(self, double k) { return vec2::make(self.x * k, self.y * k); }");
    put("    operator vec2 div(self, double k) { return vec2::make(self.x / k, self.y / k); }");
    put("    vec2 neg(self) { return vec2::make(0.0 - self.x, 0.0 - self.y); }");
    put("    double dot(self, vec2 o) { return self.x * o.x + self.y * o.y; }");
    put("    double length_sq(self) { return self.x * self.x + self.y * self.y; }");
    put("    double length(self) { return Math::sqrt(self.length_sq()); }");
    put("    double distance(self, vec2 o) { return self.sub(o).length(); }");
    put("    // the same direction with length 1 (the zero vector stays zero)");
    put("    vec2 normalize(self) {");
    put("        double l = self.length();");
    put("        if l == 0.0 { return self.mul(1.0); }");
    put("        return self.div(l);");
    put("    }");
    put("    vec2 lerp(self, vec2 o, double t) { return vec2::make(self.x + (o.x - self.x) * t, self.y + (o.y - self.y) * t); }");
    put("    vec2 min(self, vec2 o) { return vec2::make(Math::min(self.x, o.x), Math::min(self.y, o.y)); }");
    put("    vec2 max(self, vec2 o) { return vec2::make(Math::max(self.x, o.x), Math::max(self.y, o.y)); }");
    put("    vec2 abs(self) { return vec2::make(Math::abs(self.x), Math::abs(self.y)); }");
    put("    vec2 reflect(self, vec2 n) { return self.sub(n.mul(2.0 * self.dot(n))); }");
    put("    operator bool eq(self, vec2 o) { return self.x == o.x && self.y == o.y; }");
    put("    // the z of the 3D cross product");
    put("    double cross(self, vec2 o) { return self.x * o.y - self.y * o.x; }");
    put("    vec2 perp(self) { return vec2::make(0.0 - self.y, self.x); }");
    put("}");
    put("");
    put("struct vec3 {");
    put("    double x;");
    put("    double y;");
    put("    double z;");
    put("    static vec3 make(double x, double y, double z) {");
    put("        vec3 r;");
    put("        r.x = x;");
    put("        r.y = y;");
    put("        r.z = z;");
    put("        return r;");
    put("    }");
    put("    static vec3 zero() { return vec3::make(0.0, 0.0, 0.0); }");
    put("    static vec3 splat(double v) { return vec3::make(v, v, v); }");
    put("    operator vec3 add(self, vec3 o) { return vec3::make(self.x + o.x, self.y + o.y, self.z + o.z); }");
    put("    operator vec3 sub(self, vec3 o) { return vec3::make(self.x - o.x, self.y - o.y, self.z - o.z); }");
    put("    vec3 mulv(self, vec3 o) { return vec3::make(self.x * o.x, self.y * o.y, self.z * o.z); }");
    put("    vec3 divv(self, vec3 o) { return vec3::make(self.x / o.x, self.y / o.y, self.z / o.z); }");
    put("    operator vec3 mul(self, double k) { return vec3::make(self.x * k, self.y * k, self.z * k); }");
    put("    operator vec3 div(self, double k) { return vec3::make(self.x / k, self.y / k, self.z / k); }");
    put("    vec3 neg(self) { return vec3::make(0.0 - self.x, 0.0 - self.y, 0.0 - self.z); }");
    put("    double dot(self, vec3 o) { return self.x * o.x + self.y * o.y + self.z * o.z; }");
    put("    double length_sq(self) { return self.x * self.x + self.y * self.y + self.z * self.z; }");
    put("    double length(self) { return Math::sqrt(self.length_sq()); }");
    put("    double distance(self, vec3 o) { return self.sub(o).length(); }");
    put("    // the same direction with length 1 (the zero vector stays zero)");
    put("    vec3 normalize(self) {");
    put("        double l = self.length();");
    put("        if l == 0.0 { return self.mul(1.0); }");
    put("        return self.div(l);");
    put("    }");
    put("    vec3 lerp(self, vec3 o, double t) { return vec3::make(self.x + (o.x - self.x) * t, self.y + (o.y - self.y) * t, self.z + (o.z - self.z) * t); }");
    put("    vec3 min(self, vec3 o) { return vec3::make(Math::min(self.x, o.x), Math::min(self.y, o.y), Math::min(self.z, o.z)); }");
    put("    vec3 max(self, vec3 o) { return vec3::make(Math::max(self.x, o.x), Math::max(self.y, o.y), Math::max(self.z, o.z)); }");
    put("    vec3 abs(self) { return vec3::make(Math::abs(self.x), Math::abs(self.y), Math::abs(self.z)); }");
    put("    vec3 reflect(self, vec3 n) { return self.sub(n.mul(2.0 * self.dot(n))); }");
    put("    operator bool eq(self, vec3 o) { return self.x == o.x && self.y == o.y && self.z == o.z; }");
    put("    vec3 cross(self, vec3 o) { return vec3::make(self.y * o.z - self.z * o.y, self.z * o.x - self.x * o.z, self.x * o.y - self.y * o.x); }");
    put("}");
    put("");
    put("struct vec4 {");
    put("    double x;");
    put("    double y;");
    put("    double z;");
    put("    double w;");
    put("    static vec4 make(double x, double y, double z, double w) {");
    put("        vec4 r;");
    put("        r.x = x;");
    put("        r.y = y;");
    put("        r.z = z;");
    put("        r.w = w;");
    put("        return r;");
    put("    }");
    put("    static vec4 zero() { return vec4::make(0.0, 0.0, 0.0, 0.0); }");
    put("    static vec4 splat(double v) { return vec4::make(v, v, v, v); }");
    put("    operator vec4 add(self, vec4 o) { return vec4::make(self.x + o.x, self.y + o.y, self.z + o.z, self.w + o.w); }");
    put("    operator vec4 sub(self, vec4 o) { return vec4::make(self.x - o.x, self.y - o.y, self.z - o.z, self.w - o.w); }");
    put("    vec4 mulv(self, vec4 o) { return vec4::make(self.x * o.x, self.y * o.y, self.z * o.z, self.w * o.w); }");
    put("    vec4 divv(self, vec4 o) { return vec4::make(self.x / o.x, self.y / o.y, self.z / o.z, self.w / o.w); }");
    put("    operator vec4 mul(self, double k) { return vec4::make(self.x * k, self.y * k, self.z * k, self.w * k); }");
    put("    operator vec4 div(self, double k) { return vec4::make(self.x / k, self.y / k, self.z / k, self.w / k); }");
    put("    vec4 neg(self) { return vec4::make(0.0 - self.x, 0.0 - self.y, 0.0 - self.z, 0.0 - self.w); }");
    put("    double dot(self, vec4 o) { return self.x * o.x + self.y * o.y + self.z * o.z + self.w * o.w; }");
    put("    double length_sq(self) { return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w; }");
    put("    double length(self) { return Math::sqrt(self.length_sq()); }");
    put("    double distance(self, vec4 o) { return self.sub(o).length(); }");
    put("    // the same direction with length 1 (the zero vector stays zero)");
    put("    vec4 normalize(self) {");
    put("        double l = self.length();");
    put("        if l == 0.0 { return self.mul(1.0); }");
    put("        return self.div(l);");
    put("    }");
    put("    vec4 lerp(self, vec4 o, double t) { return vec4::make(self.x + (o.x - self.x) * t, self.y + (o.y - self.y) * t, self.z + (o.z - self.z) * t, self.w + (o.w - self.w) * t); }");
    put("    vec4 min(self, vec4 o) { return vec4::make(Math::min(self.x, o.x), Math::min(self.y, o.y), Math::min(self.z, o.z), Math::min(self.w, o.w)); }");
    put("    vec4 max(self, vec4 o) { return vec4::make(Math::max(self.x, o.x), Math::max(self.y, o.y), Math::max(self.z, o.z), Math::max(self.w, o.w)); }");
    put("    vec4 abs(self) { return vec4::make(Math::abs(self.x), Math::abs(self.y), Math::abs(self.z), Math::abs(self.w)); }");
    put("    vec4 reflect(self, vec4 n) { return self.sub(n.mul(2.0 * self.dot(n))); }");
    put("    operator bool eq(self, vec4 o) { return self.x == o.x && self.y == o.y && self.z == o.z && self.w == o.w; }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}

// push_matrix(): `import <matrix>` -- Mat3, Mat4.
void push_matrix() {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    lvl_lib[lx_depth] = 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    put("// mat3, mat4: square matrices of doubles, row by row; a vector is a column: v' = M.mul_vec(v), and M.mul(N) applies N first.   #import <math>   using math::matrix;");
    put("");
    put("struct mat3 {");
    put("    double m[9];                 // row by row: m[row * 3 + column]");
    put("    static mat3 identity() {");
    put("        mat3 r;");
    put("        for i in 0..9 { r.m[i] = 0.0; }");
    put("        r.m[0] = 1.0;");
    put("        r.m[4] = 1.0;");
    put("        r.m[8] = 1.0;");
    put("        return r;");
    put("    }");
    put("    static mat3 zero() {");
    put("        mat3 r;");
    put("        for i in 0..9 { r.m[i] = 0.0; }");
    put("        return r;");
    put("    }");
    put("    double get(self, int row, int col) { return self.m[row * 3 + col]; }");
    put("    operator mat3 mul(self, mat3 o) {");
    put("        mat3 r;");
    put("        for i in 0..3 {");
    put("            for j in 0..3 {");
    put("                double s = 0.0;");
    put("                for k in 0..3 { s += self.m[i * 3 + k] * o.m[k * 3 + j]; }");
    put("                r.m[i * 3 + j] = s;");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    vec3 mul_vec(self, vec3 v) {");
    put("        vec3 r;");
    put("        r.x = self.m[0] * v.x + self.m[1] * v.y + self.m[2] * v.z;");
    put("        r.y = self.m[3] * v.x + self.m[4] * v.y + self.m[5] * v.z;");
    put("        r.z = self.m[6] * v.x + self.m[7] * v.y + self.m[8] * v.z;");
    put("        return r;");
    put("    }");
    put("    mat3 transpose(self) {");
    put("        mat3 r;");
    put("        for i in 0..3 { for j in 0..3 { r.m[j * 3 + i] = self.m[i * 3 + j]; } }");
    put("        return r;");
    put("    }");
    put("");
    put("    static mat3 scale(double x, double y, double z) {");
    put("        mat3 r = mat3::identity();");
    put("        r.m[0] = x;");
    put("        r.m[4] = y;");
    put("        r.m[8] = z;");
    put("        return r;");
    put("    }");
    put("    // rotation about the X axis, the angle in radians (counter-clockwise looking against the axis)");
    put("    static mat3 rotate_x(double a) {");
    put("        mat3 r = mat3::identity();");
    put("        double c = Math::cos(a);");
    put("        double s = Math::sin(a);");
    put("        r.m[4] = c;");
    put("        r.m[5] = 0.0 - s;");
    put("        r.m[7] = s;");
    put("        r.m[8] = c;");
    put("        return r;");
    put("    }");
    put("    // rotation about the Y axis, the angle in radians (counter-clockwise looking against the axis)");
    put("    static mat3 rotate_y(double a) {");
    put("        mat3 r = mat3::identity();");
    put("        double c = Math::cos(a);");
    put("        double s = Math::sin(a);");
    put("        r.m[8] = c;");
    put("        r.m[6] = 0.0 - s;");
    put("        r.m[2] = s;");
    put("        r.m[0] = c;");
    put("        return r;");
    put("    }");
    put("    // rotation about the Z axis, the angle in radians (counter-clockwise looking against the axis)");
    put("    static mat3 rotate_z(double a) {");
    put("        mat3 r = mat3::identity();");
    put("        double c = Math::cos(a);");
    put("        double s = Math::sin(a);");
    put("        r.m[0] = c;");
    put("        r.m[1] = 0.0 - s;");
    put("        r.m[3] = s;");
    put("        r.m[4] = c;");
    put("        return r;");
    put("    }");
    put("    double determinant(self) {");
    put("        return self.m[0] * (self.m[4] * self.m[8] - self.m[5] * self.m[7])");
    put("             - self.m[1] * (self.m[3] * self.m[8] - self.m[5] * self.m[6])");
    put("             + self.m[2] * (self.m[3] * self.m[7] - self.m[4] * self.m[6]);");
    put("    }");
    put("}");
    put("");
    put("struct mat4 {");
    put("    double m[16];                 // row by row: m[row * 4 + column]");
    put("    static mat4 identity() {");
    put("        mat4 r;");
    put("        for i in 0..16 { r.m[i] = 0.0; }");
    put("        r.m[0] = 1.0;");
    put("        r.m[5] = 1.0;");
    put("        r.m[10] = 1.0;");
    put("        r.m[15] = 1.0;");
    put("        return r;");
    put("    }");
    put("    static mat4 zero() {");
    put("        mat4 r;");
    put("        for i in 0..16 { r.m[i] = 0.0; }");
    put("        return r;");
    put("    }");
    put("    double get(self, int row, int col) { return self.m[row * 4 + col]; }");
    put("    operator mat4 mul(self, mat4 o) {");
    put("        mat4 r;");
    put("        for i in 0..4 {");
    put("            for j in 0..4 {");
    put("                double s = 0.0;");
    put("                for k in 0..4 { s += self.m[i * 4 + k] * o.m[k * 4 + j]; }");
    put("                r.m[i * 4 + j] = s;");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    vec4 mul_vec(self, vec4 v) {");
    put("        vec4 r;");
    put("        r.x = self.m[0] * v.x + self.m[1] * v.y + self.m[2] * v.z + self.m[3] * v.w;");
    put("        r.y = self.m[4] * v.x + self.m[5] * v.y + self.m[6] * v.z + self.m[7] * v.w;");
    put("        r.z = self.m[8] * v.x + self.m[9] * v.y + self.m[10] * v.z + self.m[11] * v.w;");
    put("        r.w = self.m[12] * v.x + self.m[13] * v.y + self.m[14] * v.z + self.m[15] * v.w;");
    put("        return r;");
    put("    }");
    put("    mat4 transpose(self) {");
    put("        mat4 r;");
    put("        for i in 0..4 { for j in 0..4 { r.m[j * 4 + i] = self.m[i * 4 + j]; } }");
    put("        return r;");
    put("    }");
    put("");
    put("    static mat4 scale(double x, double y, double z) {");
    put("        mat4 r = mat4::identity();");
    put("        r.m[0] = x;");
    put("        r.m[5] = y;");
    put("        r.m[10] = z;");
    put("        return r;");
    put("    }");
    put("    // rotation about the X axis, the angle in radians (counter-clockwise looking against the axis)");
    put("    static mat4 rotate_x(double a) {");
    put("        mat4 r = mat4::identity();");
    put("        double c = Math::cos(a);");
    put("        double s = Math::sin(a);");
    put("        r.m[5] = c;");
    put("        r.m[6] = 0.0 - s;");
    put("        r.m[9] = s;");
    put("        r.m[10] = c;");
    put("        return r;");
    put("    }");
    put("    // rotation about the Y axis, the angle in radians (counter-clockwise looking against the axis)");
    put("    static mat4 rotate_y(double a) {");
    put("        mat4 r = mat4::identity();");
    put("        double c = Math::cos(a);");
    put("        double s = Math::sin(a);");
    put("        r.m[10] = c;");
    put("        r.m[8] = 0.0 - s;");
    put("        r.m[2] = s;");
    put("        r.m[0] = c;");
    put("        return r;");
    put("    }");
    put("    // rotation about the Z axis, the angle in radians (counter-clockwise looking against the axis)");
    put("    static mat4 rotate_z(double a) {");
    put("        mat4 r = mat4::identity();");
    put("        double c = Math::cos(a);");
    put("        double s = Math::sin(a);");
    put("        r.m[0] = c;");
    put("        r.m[1] = 0.0 - s;");
    put("        r.m[4] = s;");
    put("        r.m[5] = c;");
    put("        return r;");
    put("    }");
    put("    static mat4 translate(double x, double y, double z) {");
    put("        mat4 r = mat4::identity();");
    put("        r.m[3] = x;");
    put("        r.m[7] = y;");
    put("        r.m[11] = z;");
    put("        return r;");
    put("    }");
    put("    // a point (w = 1): moved, rotated and scaled; the w is left as it is");
    put("    vec3 point(self, vec3 p) {");
    put("        return vec3::make(self.m[0] * p.x + self.m[1] * p.y + self.m[2] * p.z + self.m[3], self.m[4] * p.x + self.m[5] * p.y + self.m[6] * p.z + self.m[7], self.m[8] * p.x + self.m[9] * p.y + self.m[10] * p.z + self.m[11]);");
    put("    }");
    put("    // a direction (w = 0): not moved");
    put("    vec3 direction(self, vec3 d) {");
    put("        return vec3::make(self.m[0] * d.x + self.m[1] * d.y + self.m[2] * d.z, self.m[4] * d.x + self.m[5] * d.y + self.m[6] * d.z, self.m[8] * d.x + self.m[9] * d.y + self.m[10] * d.z);");
    put("    }");
    put("    // a point through a projection: divided by w (x, y, z in -1..1 are inside the view)");
    put("    vec3 project(self, vec3 p) {");
    put("        vec4 q = self.mul_vec(vec4::make(p.x, p.y, p.z, 1.0));");
    put("        if q.w == 0.0 { return vec3::make(q.x, q.y, q.z); }");
    put("        return vec3::make(q.x / q.w, q.y / q.w, q.z / q.w);");
    put("    }");
    put("    // perspective: fov_y in radians, aspect = width / height, the view looks down -z, z in -1..1 (like OpenGL)");
    put("    static mat4 perspective(double fov_y, double aspect, double near, double far) {");
    put("        mat4 r = mat4::zero();");
    put("        double f = 1.0 / Math::tan(fov_y / 2.0);");
    put("        r.m[0] = f / aspect;");
    put("        r.m[5] = f;");
    put("        r.m[10] = (far + near) / (near - far);");
    put("        r.m[11] = 2.0 * far * near / (near - far);");
    put("        r.m[14] = 0.0 - 1.0;");
    put("        return r;");
    put("    }");
    put("    // the camera at eye looks at center, up says where up is");
    put("    static mat4 look_at(vec3 eye, vec3 center, vec3 up) {");
    put("        vec3 f = center.sub(eye).normalize();");
    put("        vec3 s = f.cross(up).normalize();");
    put("        vec3 u = s.cross(f);");
    put("        mat4 r = mat4::identity();");
    put("        r.m[0] = s.x;");
    put("        r.m[1] = s.y;");
    put("        r.m[2] = s.z;");
    put("        r.m[4] = u.x;");
    put("        r.m[5] = u.y;");
    put("        r.m[6] = u.z;");
    put("        r.m[8] = 0.0 - f.x;");
    put("        r.m[9] = 0.0 - f.y;");
    put("        r.m[10] = 0.0 - f.z;");
    put("        r.m[3] = 0.0 - s.dot(eye);");
    put("        r.m[7] = 0.0 - u.dot(eye);");
    put("        r.m[11] = f.dot(eye);");
    put("        return r;");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}

// push_canvas(): `using gfx::canvas` -- Canvas.
void push_canvas() {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    lvl_lib[lx_depth] = 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    put("// Canvas: a grid of characters to draw on, with a depth buffer (the nearest thing drawn in a place wins).");
    put("//   #import <gfx>   using gfx::canvas;");
    put("//   Canvas c = Canvas::make(100, 37);");
    put("//   c.clear();   c.ball(p, 2.0, \".:-=+*#%@\");   c.plot(q, 'E');   c.text(2, 1, \"hello\");   c.show();");
    put("// Points are vec3: x to the right, y down, z away from the viewer; plot() looks at them in perspective.");
    put("struct Canvas {");
    put("    int w;");
    put("    int h;");
    put("    double view;                 // the distance of the eye: bigger = flatter (default 60)");
    put("    double wide;                 // a character is about twice as high as wide: x is scaled by this (default 2)");
    put("    char[] cells;");
    put("    double[] depth;");
    put("    static Canvas make(int w, int h) {");
    put("        Canvas c;");
    put("        c.w = w;");
    put("        c.h = h;");
    put("        c.view = 60.0;");
    put("        c.wide = 2.0;");
    put("        c.cells = arr(w * h);");
    put("        c.cells.resize(w * h);");
    put("        c.depth = arr(w * h);");
    put("        c.depth.resize(w * h);");
    put("        c.clear();");
    put("        return c;");
    put("    }");
    put("    void free(self) {");
    put("        self.cells.free();");
    put("        self.depth.free();");
    put("    }");
    put("    // empties the canvas");
    put("    void clear(self) {");
    put("        for i in 0..self.w * self.h {");
    put("            self.cells[i] = ' ';");
    put("            self.depth[i] = 1.0e9;");
    put("        }");
    put("    }");
    put("    // a character in a place of the grid (no depth)");
    put("    void put(self, int x, int y, char c) {");
    put("        if x < 0 || x >= self.w || y < 0 || y >= self.h { return; }");
    put("        self.cells[y * self.w + x] = c;");
    put("    }");
    put("    char get(self, int x, int y) {");
    put("        if x < 0 || x >= self.w || y < 0 || y >= self.h { return ' '; }");
    put("        return self.cells[y * self.w + x];");
    put("    }");
    put("    // text from (x, y) to the right");
    put("    void text(self, int x, int y, String s) {");
    put("        for i in 0..s.len { self.put(x + i, y, s[i]); }");
    put("    }");
    put("    // a point in 3D (the middle of the canvas is x = 0, y = 0)");
    put("    void plot(self, vec3 p, char c) {");
    put("        double persp = self.view / (self.view + p.z);");
    put("        int sx = (int)((double)self.w / 2.0 + p.x * persp * self.wide);");
    put("        int sy = (int)((double)self.h / 2.0 + p.y * persp);");
    put("        if sx < 0 || sx >= self.w || sy < 0 || sy >= self.h { return; }");
    put("        int at = sy * self.w + sx;");
    put("        if p.z < self.depth[at] {");
    put("            self.depth[at] = p.z;");
    put("            self.cells[at] = c;");
    put("        }");
    put("    }");
    put("    // a line of points from a to b");
    put("    void line(self, vec3 a, vec3 b, char c) {");
    put("        vec3 d = b - a;");
    put("        int n = (int)(d.length() * 2.0) + 1;");
    put("        for i in 0..n + 1 {");
    put("            vec3 q = a + d * ((double)i / (double)n);");
    put("            self.plot(q, c);");
    put("        }");
    put("    }");
    put("    // a ball of radius r (in rows), lit from the upper left: the brighter, the later in ramp");
    put("    void ball(self, vec3 p, double r, String ramp) {");
    put("        int n = ramp.len;");
    put("        double dy = 0.0 - r;");
    put("        while dy <= r {");
    put("            double dx = 0.0 - r * self.wide;");
    put("            while dx <= r * self.wide {");
    put("                double nx = dx / (r * self.wide);");
    put("                double ny = dy / r;");
    put("                double d2 = nx * nx + ny * ny;");
    put("                if d2 <= 1.0 {");
    put("                    double nz = Math::sqrt(1.0 - d2);");
    put("                    vec3 normal = {nx, ny, nz};");
    put("                    vec3 light = {-0.5, -0.5, 0.7};");
    put("                    double lit = Math::max(normal.dot(light), 0.0);");
    put("                    int k = (int)(lit * (double)(n - 1));");
    put("                    if k > n - 1 { k = n - 1; }");
    put("                    vec3 q = {p.x + dx / self.wide, p.y + dy, p.z - nz};");
    put("                    self.plot(q, ramp[k]);");
    put("                }");
    put("                dx += 0.5;");
    put("            }");
    put("            dy += 0.5;");
    put("        }");
    put("    }");
    put("    // the whole picture as text, starting with \"back to the top left\" (so that frames overwrite each other)");
    put("    String frame(self) {");
    put("        String out = \"\";");
    put("        out.push((char)27);");
    put("        out.append(\"[H\");");
    put("        for y in 0..self.h {");
    put("            for x in 0..self.w { out.push(self.cells[y * self.w + x]); }");
    put("            out.push((char)10);");
    put("        }");
    put("        return out;");
    put("    }");
    put("    // clears the screen once (call it before the first show)");
    put("    void clear_screen(self) {");
    put("        String s = \"\";");
    put("        s.push((char)27);");
    put("        s.append(\"[2J\");");
    put("        cout << s;");
    put("    }");
    put("    void show(self) {");
    put("        cout << self.frame();");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}

// push_prelude(): read in front of every program (Mem and the dynamic array routines).
void push_prelude() {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    lvl_lib[lx_depth] = 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    put("// The prelude: read in front of every program (unused functions are left out).");
    put("// Mem: a small heap. Every block has a 16-byte header: [size, next-free].");
    put("int std_heap_cur;");
    put("int std_heap_end;");
    put("int std_free_list;");
    put("int std_mem_lock;                 // 0 free, 1 taken (threads share the heap)");
    put("int std_alloc_n;                  // blocks given out / given back (the -d build reports the difference at the end)");
    put("int std_free_n;");
    put("");
    put("// a bug in the program (a null array, a position out of range, ...): say so and stop; try/catch cannot catch it");
    put("void __panic(char^ msg) {");
    put("    int n = 0;");
    put("    while msg[n] != 0 { n += 1; }");
    put("    syscall(64, 2, \"panic: \", 7);");
    put("    syscall(64, 2, msg, n);");
    put("    syscall(64, 2, \"\\n\", 1);");
    put("    // the functions that were running, innermost first (the frames are linked: [fp] = caller's fp, [fp + 8] = return address)");
    put("    int^ fp = (int^)__fp();");
    put("    int^ tab = (int^)__fntab();");
    put("    int depth = 0;");
    put("    while (int)fp > 4096 && depth < 24 {");
    put("        int ret = fp[1];");
    put("        int best = 0 - 1;");
    put("        int k = 0;");
    put("        while tab[k * 2] != 0 {");
    put("            if tab[k * 2] < ret { best = k; }");
    put("            k += 1;");
    put("        }");
    put("        if best < 0 { break; }");
    put("        char^ name = (char^)tab[best * 2 + 1];");
    put("        syscall(64, 2, \"  at \", 5);");
    put("        int i = 0;");
    put("        while name[i] != 0 {");
    put("            if name[i] == '_' && name[i + 1] == '_' {");
    put("                syscall(64, 2, \"::\", 2);");
    put("                i += 2;");
    put("            } else {");
    put("                syscall(64, 2, @name[i], 1);");
    put("                i += 1;");
    put("            }");
    put("        }");
    put("        syscall(64, 2, \"\\n\", 1);");
    put("        fp = (int^)fp[0];");
    put("        depth += 1;");
    put("    }");
    put("    syscall(94, 134);");
    put("}");
    put("");
    put("struct Mem {");
    put("    static void lock_heap() {");
    put("        while __cas(@std_mem_lock, 0, 1) != 0 {");
    put("            syscall(124);                  // sched_yield: let the thread that holds the heap finish");
    put("        }");
    put("    }");
    put("    static void unlock_heap() {");
    put("        __xchg(@std_mem_lock, 0);");
    put("    }");
    put("    // n bytes, not cleared (null if the system has no memory left)");
    put("    static void^ alloc(int n) {");
    put("        Mem::lock_heap();");
    put("        void^ r = Mem::alloc_raw(n);");
    put("        Mem::unlock_heap();");
    put("        return r;");
    put("    }");
    put("    static void^ alloc_raw(int n) {");
    put("        if n <= 0 { return null; }");
    put("        int need = (n + 15) / 16 * 16 + 16;");
    put("        int prev = 0;");
    put("        int cur = std_free_list;");
    put("        while cur != 0 {");
    put("            int^ hdr = (int^)cur;");
    put("            if hdr[0] >= need {");
    put("                if prev == 0 {");
    put("                    std_free_list = hdr[1];");
    put("                } else {");
    put("                    int^ before = (int^)prev;");
    put("                    before[1] = hdr[1];");
    put("                }");
    put("                std_alloc_n += 1;");
    put("                return (void^)(cur + 16);");
    put("            }");
    put("            prev = cur;");
    put("            cur = hdr[1];");
    put("        }");
    put("        if std_heap_cur + need > std_heap_end {");
    put("            int chunk = 1048576;");
    put("            if need > chunk { chunk = (need + 4095) / 4096 * 4096; }");
    put("            int base = syscall(222, 0, chunk, 3, 34, -1, 0);      // mmap: anonymous, read + write");
    put("            if base < 0 { return null; }");
    put("            std_heap_cur = base;");
    put("            std_heap_end = base + chunk;");
    put("        }");
    put("        int blk = std_heap_cur;");
    put("        std_heap_cur = std_heap_cur + need;");
    put("        std_alloc_n += 1;");
    put("        int^ head = (int^)blk;");
    put("        head[0] = need;");
    put("        return (void^)(blk + 16);");
    put("    }");
    put("    // give a block from alloc back (null is ignored)");
    put("    static void free(void^ p) {");
    put("        Mem::lock_heap();");
    put("        Mem::free_raw(p);");
    put("        Mem::unlock_heap();");
    put("    }");
    put("    static void free_raw(void^ p) {");
    put("        if (int)p == 0 { return; }");
    put("        int blk = (int)p - 16;");
    put("        int^ head = (int^)blk;");
    put("        head[1] = std_free_list;");
    put("        std_free_list = blk;");
    put("        std_free_n += 1;");
    put("    }");
    put("    // -d : at the end of main, say how many blocks were never given back");
    put("    static void report() {");
    put("        int n = std_alloc_n - std_free_n;");
    put("        if n <= 0 { return; }");
    put("        char d[24];");
    put("        int k = 23;");
    put("        d[k] = 10;");
    put("        while n > 0 {");
    put("            k -= 1;");
    put("            d[k] = '0' + n % 10;");
    put("            n = n / 10;");
    put("        }");
    put("        syscall(64, 2, \"debug: memory blocks never freed: \", 34);");
    put("        syscall(64, 2, @d + k, 24 - k);");
    put("    }");
    put("    static void set(void^ p, int value, int n) {");
    put("        char^ q = (char^)p;");
    put("        int i = 0;");
    put("        while i < n {");
    put("            q[i] = value;");
    put("            i += 1;");
    put("        }");
    put("    }");
    put("    static void copy(void^ dst, void^ src, int n) {");
    put("        char^ d = (char^)dst;");
    put("        char^ s = (char^)src;");
    put("        int i = 0;");
    put("        while i < n {");
    put("            d[i] = s[i];");
    put("            i += 1;");
    put("        }");
    put("    }");
    put("}");
    put("");
    put("// Dynamic arrays (T[] x = arr(n)): a header [length, capacity, data, element size]");
    put("// points to the elements. The header stays where it is, so every copy of the");
    put("// variable sees the same array; only the data block moves when it grows.");
    put("struct __Arr {");
    put("    static void nullerr() {");
    put("        __panic(\"the dynamic array is null\");");
    put("    }");
    put("    static void^ make(int esize, int cap) {");
    put("        int^ h = (int^)Mem::alloc(32);");
    put("        if (int)h == 0 { __panic(\"out of memory\"); }");
    put("        int c = cap;");
    put("        if c < 4 { c = 4; }");
    put("        h[0] = 0;");
    put("        h[1] = c;");
    put("        h[2] = (int)Mem::alloc(c * esize);");
    put("        h[3] = esize;");
    put("        if h[2] == 0 { __panic(\"out of memory\"); }");
    put("        return (void^)h;");
    put("    }");
    put("    // room for at least `need` elements");
    put("    static void grow(int^ h, int need) {");
    put("        if need <= h[1] { return; }");
    put("        int c = h[1] * 2;");
    put("        if c < need { c = need; }");
    put("        int nd = (int)Mem::alloc(c * h[3]);");
    put("        if nd == 0 { __panic(\"out of memory\"); }");
    put("        Mem::copy((void^)nd, (void^)h[2], h[0] * h[3]);");
    put("        Mem::free((void^)h[2]);");
    put("        h[2] = nd;");
    put("        h[1] = c;");
    put("    }");
    put("    // append one element: returns the address of its (new) place");
    put("    static void^ slot(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { __panic(\"the dynamic array is null\"); }");
    put("        __Arr::grow(h, h[0] + 1);");
    put("        int at = h[2] + h[0] * h[3];");
    put("        h[0] += 1;");
    put("        return (void^)at;");
    put("    }");
    put("    // remove the last element: returns the address where it still is");
    put("    static void^ pop(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { __panic(\"the dynamic array is null\"); }");
    put("        if h[0] == 0 { __panic(\"pop from an empty array\"); }");
    put("        h[0] -= 1;");
    put("        return (void^)(h[2] + h[0] * h[3]);");
    put("    }");
    put("    static void resize(void^ hv, int n) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { __panic(\"the dynamic array is null\"); }");
    put("        if n < 0 { __panic(\"negative array size\"); }");
    put("        __Arr::grow(h, n);");
    put("        if n > h[0] { Mem::set((void^)(h[2] + h[0] * h[3]), 0, (n - h[0]) * h[3]); }");
    put("        h[0] = n;");
    put("    }");
    put("    // ---- numbers in an array: kind 0 signed, 1 unsigned (also pointers), 2 float, 3 double");
    put("    // the bits of element i as a whole number (sign or zero extended; the IEEE bits for a float)");
    put("    static int get(int^ h, int i, int kind) {");
    put("        char^ d = (char^)(h[2] + i * h[3]);");
    put("        int es = h[3];");
    put("        int v = 0;");
    put("        int k = es - 1;");
    put("        while k >= 0 {");
    put("            v = v * 256 + d[k];");
    put("            k -= 1;");
    put("        }");
    put("        if kind == 0 && es < 8 {");
    put("            int sh = 64 - es * 8;");
    put("            v = (v shl sh) shr sh;");
    put("        }");
    put("        return v;");
    put("    }");
    put("    static void put(int^ h, int i, int bits) {");
    put("        char^ d = (char^)(h[2] + i * h[3]);");
    put("        int k = 0;");
    put("        while k < h[3] {");
    put("            d[k] = bits & 255;");
    put("            bits = bits shr 8;");
    put("            k += 1;");
    put("        }");
    put("    }");
    put("    // a before b ?");
    put("    static bool less(int a, int b, int kind) {");
    put("        if kind == 0 { return a < b; }");
    put("        if kind == 1 { return (a xor -9223372036854775807 - 1) < (b xor -9223372036854775807 - 1); }");
    put("        if kind == 2 {");
    put("            int x = a;");
    put("            int y = b;");
    put("            float^ fx = (float^)@x;");
    put("            float^ fy = (float^)@y;");
    put("            return fx[0] < fy[0];");
    put("        }");
    put("        int x2 = a;");
    put("        int y2 = b;");
    put("        double^ dx = (double^)@x2;");
    put("        double^ dy = (double^)@y2;");
    put("        return dx[0] < dy[0];");
    put("    }");
    put("    static void insert(void^ hv, int i, int bits) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        if i < 0 || i > h[0] { __panic(\"insert position out of range\"); }");
    put("        __Arr::grow(h, h[0] + 1);");
    put("        int k = h[0];");
    put("        while k > i {");
    put("            __Arr::put(h, k, __Arr::get(h, k - 1, 1));");
    put("            k -= 1;");
    put("        }");
    put("        __Arr::put(h, i, bits);");
    put("        h[0] += 1;");
    put("    }");
    put("    static void remove(void^ hv, int i) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        if i < 0 || i >= h[0] { __panic(\"remove position out of range\"); }");
    put("        int k = i;");
    put("        while k + 1 < h[0] {");
    put("            __Arr::put(h, k, __Arr::get(h, k + 1, 1));");
    put("            k += 1;");
    put("        }");
    put("        h[0] -= 1;");
    put("    }");
    put("    // the place of the first element equal to bits, or -1");
    put("    static int index(void^ hv, int bits, int kind) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            int e = __Arr::get(h, i, kind);");
    put("            if !__Arr::less(e, bits, kind) && !__Arr::less(bits, e, kind) { return i; }");
    put("            i += 1;");
    put("        }");
    put("        return 0 - 1;");
    put("    }");
    put("    static void sort(void^ hv, int kind) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        int n = h[0];");
    put("        int start = n / 2 - 1;");
    put("        while start >= 0 {");
    put("            __Arr::sift(h, start, n, kind);");
    put("            start -= 1;");
    put("        }");
    put("        int end = n - 1;");
    put("        while end > 0 {");
    put("            int t = __Arr::get(h, 0, kind);");
    put("            __Arr::put(h, 0, __Arr::get(h, end, kind));");
    put("            __Arr::put(h, end, t);");
    put("            __Arr::sift(h, 0, end, kind);");
    put("            end -= 1;");
    put("        }");
    put("    }");
    put("    static void sift(int^ h, int root, int n, int kind) {");
    put("        while true {");
    put("            int child = root * 2 + 1;");
    put("            if child >= n { return; }");
    put("            if child + 1 < n && __Arr::less(__Arr::get(h, child, kind), __Arr::get(h, child + 1, kind), kind) { child += 1; }");
    put("            int a = __Arr::get(h, root, kind);");
    put("            int b = __Arr::get(h, child, kind);");
    put("            if !__Arr::less(a, b, kind) { return; }");
    put("            __Arr::put(h, root, b);");
    put("            __Arr::put(h, child, a);");
    put("            root = child;");
    put("        }");
    put("    }");
    put("    // a copy of an array of numbers / pointers");
    put("    static void^ clone(void^ hv) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        int^ r = (int^)__Arr::make(h[3], h[0]);");
    put("        Mem::copy((void^)r[2], (void^)h[2], h[0] * h[3]);");
    put("        r[0] = h[0];");
    put("        return (void^)r;");
    put("    }");
    put("    // give the elements and the header back (null is ignored)");
    put("    static void free(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { return; }");
    put("        Mem::free((void^)h[2]);");
    put("        Mem::free(hv);");
    put("    }");
    put("}");
    put("");
    put("// String: a dynamic array of char (header [length, capacity, data, 1]) whose data always ends");
    put("// in a 0 byte after the length, so that the data is also a C-style text (cout, c()).");
    put("// An operand is a text (kind 0), another String (kind 1) or one character (kind 2).");
    put("char std_str_ch[16];");
    put("struct __Str {");
    put("    static void^ make(int cap) {");
    put("        int^ h = (int^)__Arr::make(1, cap + 1);");
    put("        char^ d = (char^)h[2];");
    put("        d[0] = 0;");
    put("        return (void^)h;");
    put("    }");
    put("    static int textlen(char^ t) {");
    put("        int n = 0;");
    put("        while t[n] != 0 { n += 1; }");
    put("        return n;");
    put("    }");
    put("    static void check(void^ hv) {");
    put("        if (int)hv == 0 { __panic(\"the String is null\"); }");
    put("    }");
    put("    // the characters of an operand");
    put("    static char^ ptr(void^ x, int k, int slot) {");
    put("        if k == 1 {");
    put("            __Str::check(x);");
    put("            int^ h = (int^)x;");
    put("            return (char^)h[2];");
    put("        }");
    put("        if k == 2 {");
    put("            std_str_ch[slot * 8] = (int)x;");
    put("            std_str_ch[slot * 8 + 1] = 0;");
    put("            return @std_str_ch + slot * 8;");
    put("        }");
    put("        return (char^)x;");
    put("    }");
    put("    static int len(void^ x, int k) {");
    put("        if k == 1 {");
    put("            __Str::check(x);");
    put("            int^ h = (int^)x;");
    put("            return h[0];");
    put("        }");
    put("        if k == 2 { return 1; }");
    put("        return __Str::textlen((char^)x);");
    put("    }");
    put("    // a new String holding a copy of the text");
    put("    static void^ from(char^ t) {");
    put("        int n = __Str::textlen(t);");
    put("        int^ h = (int^)__Str::make(n);");
    put("        Mem::copy((void^)h[2], (void^)t, n);");
    put("        char^ d = (char^)h[2];");
    put("        d[n] = 0;");
    put("        h[0] = n;");
    put("        return (void^)h;");
    put("    }");
    put("    // a copy of a String");
    put("    static void^ clone(void^ x) {");
    put("        return __Str::cat(x, 1, (void^)\"\", 0);");
    put("    }");
    put("    // a new String: a followed by b");
    put("    static void^ cat(void^ a, int ka, void^ b, int kb) {");
    put("        int na = __Str::len(a, ka);");
    put("        int nb = __Str::len(b, kb);");
    put("        int^ h = (int^)__Str::make(na + nb);");
    put("        char^ d = (char^)h[2];");
    put("        Mem::copy((void^)d, (void^)__Str::ptr(a, ka, 0), na);");
    put("        Mem::copy((void^)(d + na), (void^)__Str::ptr(b, kb, 1), nb);");
    put("        d[na + nb] = 0;");
    put("        h[0] = na + nb;");
    put("        return (void^)h;");
    put("    }");
    put("    // a followed by b, in a (returns a)");
    put("    static void^ append(void^ a, void^ b, int kb) {");
    put("        __Str::check(a);");
    put("        if kb == 1 && (int)b == (int)a {                 // s.append(s): the data may move");
    put("            void^ same = __Str::clone(a);");
    put("            __Str::append(a, same, 1);");
    put("            __Arr::free(same);");
    put("            return a;");
    put("        }");
    put("        int^ h = (int^)a;");
    put("        int nb = __Str::len(b, kb);");
    put("        char^ src = __Str::ptr(b, kb, 1);");
    put("        __Arr::grow(h, h[0] + nb + 1);");
    put("        Mem::copy((void^)(h[2] + h[0]), (void^)src, nb);");
    put("        h[0] += nb;");
    put("        char^ d = (char^)h[2];");
    put("        d[h[0]] = 0;");
    put("        return a;");
    put("    }");
    put("    static void push(void^ a, int c) {");
    put("        __Str::check(a);");
    put("        int^ h = (int^)a;");
    put("        __Arr::grow(h, h[0] + 2);");
    put("        char^ d = (char^)h[2];");
    put("        d[h[0]] = c;");
    put("        h[0] += 1;");
    put("        d[h[0]] = 0;");
    put("    }");
    put("    static int pop(void^ a) {");
    put("        __Str::check(a);");
    put("        int^ h = (int^)a;");
    put("        if h[0] == 0 { __panic(\"pop from an empty String\"); }");
    put("        h[0] -= 1;");
    put("        char^ d = (char^)h[2];");
    put("        int c = d[h[0]];");
    put("        d[h[0]] = 0;");
    put("        return c;");
    put("    }");
    put("    static void clear(void^ a) {");
    put("        __Str::check(a);");
    put("        int^ h = (int^)a;");
    put("        h[0] = 0;");
    put("        char^ d = (char^)h[2];");
    put("        d[0] = 0;");
    put("    }");
    put("    // 1 if the two operands hold the same characters");
    put("    static int eq(void^ a, int ka, void^ b, int kb) {");
    put("        int na = __Str::len(a, ka);");
    put("        int nb = __Str::len(b, kb);");
    put("        if na != nb { return 0; }");
    put("        char^ pa = __Str::ptr(a, ka, 0);");
    put("        char^ pb = __Str::ptr(b, kb, 1);");
    put("        int i = 0;");
    put("        while i < na {");
    put("            if pa[i] != pb[i] { return 0; }");
    put("            i += 1;");
    put("        }");
    put("        return 1;");
    put("    }");
    put("    // the first place of t in s at or after `from`, or -1");
    put("    static int find(void^ s, void^ t, int kt) {");
    put("        int ns = __Str::len(s, 1);");
    put("        int nt = __Str::len(t, kt);");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ pt = __Str::ptr(t, kt, 1);");
    put("        int i = 0;");
    put("        while i + nt <= ns {");
    put("            int j = 0;");
    put("            while j < nt && ps[i + j] == pt[j] { j += 1; }");
    put("            if j == nt { return i; }");
    put("            i += 1;");
    put("        }");
    put("        return 0 - 1;");
    put("    }");
    put("    // a new String: the characters a .. b - 1");
    put("    static void^ slice(void^ s, int a, int b) {");
    put("        int n = __Str::len(s, 1);");
    put("        if a < 0 || b > n || a > b { __panic(\"String slice out of range\"); }");
    put("        int^ h = (int^)__Str::make(b - a);");
    put("        char^ d = (char^)h[2];");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        Mem::copy((void^)d, (void^)(ps + a), b - a);");
    put("        d[b - a] = 0;");
    put("        h[0] = b - a;");
    put("        return (void^)h;");
    put("    }");
    put("    static char^ c(void^ s) {");
    put("        return __Str::ptr(s, 1, 0);");
    put("    }");
    put("    // hash of a whole number / of a String (FNV-1a over the bytes)");
    put("    static int hashint(int x) {");
    put("        int h = x * -7046029254386353131;");
    put("        return h xor (h shr 29);");
    put("    }");
    put("    static int hash(void^ s) {");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int h = -3750763034362895579;");
    put("        int i = 0;");
    put("        while p[i] != 0 {");
    put("            h = (h xor p[i]) * 1099511628211;");
    put("            i += 1;");
    put("        }");
    put("        return h xor (h shr 29);");
    put("    }");
    put("    // String[]: n places (new ones are null, cut ones are freed)");
    put("    static void aresize(void^ hv, int n) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        if n < 0 { __panic(\"negative array size\"); }");
    put("        int^ el = (int^)h[2];");
    put("        int i = n;");
    put("        while i < h[0] {");
    put("            __Arr::free((void^)el[i]);");
    put("            i += 1;");
    put("        }");
    put("        __Arr::grow(h, n);");
    put("        el = (int^)h[2];");
    put("        i = h[0];");
    put("        while i < n {");
    put("            el[i] = 0;");
    put("            i += 1;");
    put("        }");
    put("        h[0] = n;");
    put("    }");
    put("    // -1, 0, 1: a before, equal to, after b (bytes)");
    put("    static int cmp(void^ a, void^ b) {");
    put("        char^ pa = __Str::ptr(a, 1, 0);");
    put("        char^ pb = __Str::ptr(b, 1, 1);");
    put("        int i = 0;");
    put("        while pa[i] != 0 && pa[i] == pb[i] { i += 1; }");
    put("        if pa[i] == pb[i] { return 0; }");
    put("        if pa[i] < pb[i] { return 0 - 1; }");
    put("        return 1;");
    put("    }");
    put("");
    put("    // ---- more String functions (the bytes are treated as ASCII where case matters)");
    put("    static bool isspace(int c) {");
    put("        return c == 32 || c == 9 || c == 10 || c == 13;");
    put("    }");
    put("    // a new String: s without the white space at both ends");
    put("    static void^ trim(void^ s) {");
    put("        int n = __Str::len(s, 1);");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int a = 0;");
    put("        int b = n;");
    put("        while a < b && __Str::isspace(p[a]) { a += 1; }");
    put("        while b > a && __Str::isspace(p[b - 1]) { b -= 1; }");
    put("        return __Str::slice(s, a, b);");
    put("    }");
    put("    // ---- UTF-8: len counts bytes; these work on characters (code points)");
    put("    // the upper case of a code point (ASCII, Latin-1, Latin Extended-A, Greek, Cyrillic); others stay");
    put("    static int cp_upper(int c) {");
    put("        if c < 128 {");
    put("            if c >= 'a' && c <= 'z' { return c - 32; }");
    put("            return c;");
    put("        }");
    put("        if c >= 0xE0 && c <= 0xFE && c != 0xF7 { return c - 32; }");
    put("        if c == 0xFF { return 0x178; }");
    put("        if c >= 0x100 && c <= 0x137 && c != 0x130 && c != 0x131 && c % 2 == 1 { return c - 1; }");
    put("        if c >= 0x139 && c <= 0x148 && c % 2 == 0 { return c - 1; }");
    put("        if c >= 0x14A && c <= 0x177 && c % 2 == 1 { return c - 1; }");
    put("        if c >= 0x17A && c <= 0x17E && c % 2 == 0 { return c - 1; }");
    put("        if c == 0x3C2 { return 0x3A3; }");
    put("        if c >= 0x3B1 && c <= 0x3C9 { return c - 32; }");
    put("        if c >= 0x430 && c <= 0x44F { return c - 32; }");
    put("        if c >= 0x450 && c <= 0x45F { return c - 80; }");
    put("        return c;");
    put("    }");
    put("    static int cp_lower(int c) {");
    put("        if c < 128 {");
    put("            if c >= 'A' && c <= 'Z' { return c + 32; }");
    put("            return c;");
    put("        }");
    put("        if c >= 0xC0 && c <= 0xDE && c != 0xD7 { return c + 32; }");
    put("        if c == 0x178 { return 0xFF; }");
    put("        if c >= 0x100 && c <= 0x137 && c != 0x130 && c != 0x131 && c % 2 == 0 { return c + 1; }");
    put("        if c >= 0x139 && c <= 0x148 && c % 2 == 1 { return c + 1; }");
    put("        if c >= 0x14A && c <= 0x177 && c % 2 == 0 { return c + 1; }");
    put("        if c >= 0x179 && c <= 0x17D && c % 2 == 1 { return c + 1; }");
    put("        if c >= 0x391 && c <= 0x3A9 && c != 0x3A2 { return c + 32; }");
    put("        if c >= 0x410 && c <= 0x42F { return c + 32; }");
    put("        if c >= 0x400 && c <= 0x40F { return c + 80; }");
    put("        return c;");
    put("    }");
    put("    // r (a fresh copy) changed in place to upper (up = 1) or lower case; every mapped letter keeps its size");
    put("    static void map_case(void^ r, int up) {");
    put("        char^ p = __Str::ptr(r, 1, 0);");
    put("        int i = 0;");
    put("        while p[i] != 0 {");
    put("            int b = p[i] & 255;");
    put("            if b < 128 {");
    put("                if up == 1 { p[i] = (char)__Str::cp_upper(b); } else { p[i] = (char)__Str::cp_lower(b); }");
    put("                i += 1;");
    put("            } else if b >= 0xC2 && b <= 0xDF && (p[i + 1] & 0xC0) == 0x80 {");
    put("                int c = ((b & 0x1F) << 6) | (p[i + 1] & 0x3F);");
    put("                if up == 1 { c = __Str::cp_upper(c); } else { c = __Str::cp_lower(c); }");
    put("                p[i] = (char)(0xC0 | (c >> 6));");
    put("                p[i + 1] = (char)(0x80 | (c & 0x3F));");
    put("                i += 2;");
    put("            } else {");
    put("                i += 1;");
    put("            }");
    put("        }");
    put("    }");
    put("    static void^ upper(void^ s) {");
    put("        void^ r = __Str::clone(s);");
    put("        __Str::map_case(r, 1);");
    put("        return r;");
    put("    }");
    put("    static void^ lower(void^ s) {");
    put("        void^ r = __Str::clone(s);");
    put("        __Str::map_case(r, 0);");
    put("        return r;");
    put("    }");
    put("    // the number of characters (code points)");
    put("    static int count(void^ s) {");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int n = __Str::len(s, 1);");
    put("        int k = 0;");
    put("        int i = 0;");
    put("        while i < n {");
    put("            if (p[i] & 0xC0) != 0x80 { k += 1; }");
    put("            i += 1;");
    put("        }");
    put("        return k;");
    put("    }");
    put("    // the size in bytes of the character that starts at byte i");
    put("    static int cp_size(char^ p, int i, int n) {");
    put("        int b = p[i] & 255;");
    put("        int k = 1;");
    put("        if b >= 0xF0 { k = 4; } else if b >= 0xE0 { k = 3; } else if b >= 0xC0 { k = 2; }");
    put("        if i + k > n { k = n - i; }");
    put("        return k;");
    put("    }");
    put("    // a String[] with every character as a String of its own");
    put("    static void^ chars(void^ s) {");
    put("        void^ r = __Arr::make(8, 4);");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int n = __Str::len(s, 1);");
    put("        int i = 0;");
    put("        while i < n {");
    put("            int k = __Str::cp_size(p, i, n);");
    put("            __Str::apush(r, __Str::slice(s, i, i + k));");
    put("            i += k;");
    put("        }");
    put("        return r;");
    put("    }");
    put("    // the character number idx (counted from 0) as a String");
    put("    static void^ char_at(void^ s, int idx) {");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int n = __Str::len(s, 1);");
    put("        int i = 0;");
    put("        int k = 0;");
    put("        while i < n {");
    put("            int sz = __Str::cp_size(p, i, n);");
    put("            if k == idx { return __Str::slice(s, i, i + sz); }");
    put("            i += sz;");
    put("            k += 1;");
    put("        }");
    put("        __panic(\"char_at: the position is out of range\");");
    put("        return __Str::make(1);");
    put("    }");
    put("    static int starts_with(void^ s, void^ x, int kx) {");
    put("        int ns = __Str::len(s, 1);");
    put("        int nx = __Str::len(x, kx);");
    put("        if nx > ns { return 0; }");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ px = __Str::ptr(x, kx, 1);");
    put("        int i = 0;");
    put("        while i < nx {");
    put("            if ps[i] != px[i] { return 0; }");
    put("            i += 1;");
    put("        }");
    put("        return 1;");
    put("    }");
    put("    static int ends_with(void^ s, void^ x, int kx) {");
    put("        int ns = __Str::len(s, 1);");
    put("        int nx = __Str::len(x, kx);");
    put("        if nx > ns { return 0; }");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ px = __Str::ptr(x, kx, 1);");
    put("        int i = 0;");
    put("        while i < nx {");
    put("            if ps[ns - nx + i] != px[i] { return 0; }");
    put("            i += 1;");
    put("        }");
    put("        return 1;");
    put("    }");
    put("    // a new String: every a in s replaced by b");
    put("    static void^ replace(void^ s, void^ a, int ka, void^ b, int kb) {");
    put("        int na = __Str::len(a, ka);");
    put("        if na == 0 { __panic(\"replace: the text to look for is empty\"); }");
    put("        void^ r = __Str::make(__Str::len(s, 1));");
    put("        int ns = __Str::len(s, 1);");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ pa = __Str::ptr(a, ka, 1);");
    put("        int i = 0;");
    put("        while i < ns {");
    put("            int j = 0;");
    put("            while j < na && i + j < ns && ps[i + j] == pa[j] { j += 1; }");
    put("            if j == na {");
    put("                __Str::append(r, b, kb);");
    put("                i += na;");
    put("            } else {");
    put("                __Str::push(r, ps[i]);");
    put("                i += 1;");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    // a new String: s repeated n times");
    put("    static void^ repeat(void^ s, int n) {");
    put("        void^ r = __Str::make(__Str::len(s, 1) * (n + 1));");
    put("        int i = 0;");
    put("        while i < n {");
    put("            __Str::append(r, s, 1);");
    put("            i += 1;");
    put("        }");
    put("        return r;");
    put("    }");
    put("    // the whole String as a number (an optional sign and digits); throws \"not a number\"");
    put("    static int to_int(void^ s) {");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int n = __Str::len(s, 1);");
    put("        int i = 0;");
    put("        while i < n && __Str::isspace(p[i]) { i += 1; }");
    put("        int neg = 0;");
    put("        if i < n && (p[i] == '-' || p[i] == '+') {");
    put("            if p[i] == '-' { neg = 1; }");
    put("            i += 1;");
    put("        }");
    put("        if i >= n || p[i] < '0' || p[i] > '9' { throw \"not a number\"; }");
    put("        int v = 0;");
    put("        while i < n && p[i] >= '0' && p[i] <= '9' {");
    put("            v = v * 10 + (p[i] - '0');");
    put("            i += 1;");
    put("        }");
    put("        while i < n && __Str::isspace(p[i]) { i += 1; }");
    put("        if i != n { throw \"not a number\"; }");
    put("        if neg == 1 { return 0 - v; }");
    put("        return v;");
    put("    }");
    put("    // the whole String as a decimal number (sign, digits, a point, digits, e and an exponent); throws \"not a number\"");
    put("    static double to_double(void^ s) {");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int n = __Str::len(s, 1);");
    put("        int i = 0;");
    put("        while i < n && __Str::isspace(p[i]) { i += 1; }");
    put("        int neg = 0;");
    put("        if i < n && (p[i] == '-' || p[i] == '+') {");
    put("            if p[i] == '-' { neg = 1; }");
    put("            i += 1;");
    put("        }");
    put("        double v = 0.0;");
    put("        int any = 0;");
    put("        while i < n && p[i] >= '0' && p[i] <= '9' {");
    put("            v = v * 10.0 + (double)(p[i] - '0');");
    put("            any = 1;");
    put("            i += 1;");
    put("        }");
    put("        if i < n && p[i] == '.' {");
    put("            i += 1;");
    put("            double scale = 0.1;");
    put("            while i < n && p[i] >= '0' && p[i] <= '9' {");
    put("                v = v + (double)(p[i] - '0') * scale;");
    put("                scale = scale / 10.0;");
    put("                any = 1;");
    put("                i += 1;");
    put("            }");
    put("        }");
    put("        if any == 0 { throw \"not a number\"; }");
    put("        if i < n && (p[i] == 'e' || p[i] == 'E') {");
    put("            i += 1;");
    put("            int eneg = 0;");
    put("            if i < n && (p[i] == '-' || p[i] == '+') {");
    put("                if p[i] == '-' { eneg = 1; }");
    put("                i += 1;");
    put("            }");
    put("            if i >= n || p[i] < '0' || p[i] > '9' { throw \"not a number\"; }");
    put("            int e = 0;");
    put("            while i < n && p[i] >= '0' && p[i] <= '9' {");
    put("                e = e * 10 + (p[i] - '0');");
    put("                i += 1;");
    put("            }");
    put("            while e > 0 {");
    put("                if eneg == 1 { v = v / 10.0; } else { v = v * 10.0; }");
    put("                e -= 1;");
    put("            }");
    put("        }");
    put("        while i < n && __Str::isspace(p[i]) { i += 1; }");
    put("        if i != n { throw \"not a number\"; }");
    put("        if neg == 1 { return 0.0 - v; }");
    put("        return v;");
    put("    }");
    put("    // a String[] with the pieces of s between the separators (an empty separator throws)");
    put("    static void^ split(void^ s, void^ sep, int ksep) {");
    put("        int nsep = __Str::len(sep, ksep);");
    put("        if nsep == 0 { __panic(\"split: the separator is empty\"); }");
    put("        void^ r = __Arr::make(8, 4);");
    put("        int ns = __Str::len(s, 1);");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ pp = __Str::ptr(sep, ksep, 1);");
    put("        int start = 0;");
    put("        int i = 0;");
    put("        while i + nsep <= ns {");
    put("            int j = 0;");
    put("            while j < nsep && ps[i + j] == pp[j] { j += 1; }");
    put("            if j == nsep {");
    put("                __Str::apush(r, __Str::slice(s, start, i));");
    put("                i += nsep;");
    put("                start = i;");
    put("            } else {");
    put("                i += 1;");
    put("            }");
    put("        }");
    put("        __Str::apush(r, __Str::slice(s, start, ns));");
    put("        return r;");
    put("    }");
    put("    // a new String: the elements of a String[] with sep between them");
    put("    static void^ ajoin(void^ hv, void^ sep, int ksep) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        int^ el = (int^)h[2];");
    put("        void^ r = __Str::make(16);");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            if i > 0 { __Str::append(r, sep, ksep); }");
    put("            __Str::append(r, (void^)el[i], 1);");
    put("            i += 1;");
    put("        }");
    put("        return r;");
    put("    }");
    put("");
    put("    // ---- String[] : an array whose elements are String headers owned by the array");
    put("    // a deep copy of a String[] (every String is copied)");
    put("    static void^ aclone(void^ hv) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        void^ rv = __Arr::make(8, h[0]);");
    put("        int^ el = (int^)h[2];");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            if el[i] == 0 {");
    put("                int^ slot = (int^)__Arr::slot(rv);");
    put("                slot[0] = 0;");
    put("            } else {");
    put("                __Str::apush(rv, __Str::clone((void^)el[i]));");
    put("            }");
    put("            i += 1;");
    put("        }");
    put("        return rv;");
    put("    }");
    put("    static void aprep(void^ hv) {");
    put("        if (int)hv == 0 { __panic(\"the array is null\"); }");
    put("    }");
    put("    // the elements and the array are given back");
    put("    static void free_all(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { return; }");
    put("        int^ el = (int^)h[2];");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            __Arr::free((void^)el[i]);");
    put("            i += 1;");
    put("        }");
    put("        __Arr::free(hv);");
    put("    }");
    put("    static void clear_all(void^ hv) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        int^ el = (int^)h[2];");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            __Arr::free((void^)el[i]);");
    put("            i += 1;");
    put("        }");
    put("        h[0] = 0;");
    put("    }");
    put("    // append s (the array takes it over)");
    put("    static void apush(void^ hv, void^ s) {");
    put("        __Str::aprep(hv);");
    put("        int^ slot = (int^)__Arr::slot(hv);");
    put("        slot[0] = (int)s;");
    put("    }");
    put("    // remove the last one and give it to the caller");
    put("    static void^ apop(void^ hv) {");
    put("        __Str::aprep(hv);");
    put("        int^ slot = (int^)__Arr::pop(hv);");
    put("        return (void^)slot[0];");
    put("    }");
    put("    // put s (taken over) at place i");
    put("    static void ainsert(void^ hv, int i, void^ s) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        if i < 0 || i > h[0] { __panic(\"insert position out of range\"); }");
    put("        __Arr::grow(h, h[0] + 1);");
    put("        int^ el = (int^)h[2];");
    put("        int k = h[0];");
    put("        while k > i {");
    put("            el[k] = el[k - 1];");
    put("            k -= 1;");
    put("        }");
    put("        el[i] = (int)s;");
    put("        h[0] += 1;");
    put("    }");
    put("    // remove the one at place i (it is freed)");
    put("    static void aremove(void^ hv, int i) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        if i < 0 || i >= h[0] { __panic(\"remove position out of range\"); }");
    put("        int^ el = (int^)h[2];");
    put("        __Arr::free((void^)el[i]);");
    put("        int k = i;");
    put("        while k + 1 < h[0] {");
    put("            el[k] = el[k + 1];");
    put("            k += 1;");
    put("        }");
    put("        h[0] -= 1;");
    put("    }");
    put("    // the place of the first element equal to the operand, or -1");
    put("    static int aindex(void^ hv, void^ x, int kx) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        int^ el = (int^)h[2];");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            if __Str::eq((void^)el[i], 1, x, kx) == 1 { return i; }");
    put("            i += 1;");
    put("        }");
    put("        return 0 - 1;");
    put("    }");
    put("    // sort ascending (heap sort, no extra memory)");
    put("    static void asort(void^ hv) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        int^ el = (int^)h[2];");
    put("        int n = h[0];");
    put("        int start = n / 2 - 1;");
    put("        while start >= 0 {");
    put("            __Str::asift(el, start, n);");
    put("            start -= 1;");
    put("        }");
    put("        int end = n - 1;");
    put("        while end > 0 {");
    put("            int t = el[0];");
    put("            el[0] = el[end];");
    put("            el[end] = t;");
    put("            __Str::asift(el, 0, end);");
    put("            end -= 1;");
    put("        }");
    put("    }");
    put("    static void asift(int^ el, int root, int n) {");
    put("        while true {");
    put("            int child = root * 2 + 1;");
    put("            if child >= n { return; }");
    put("            if child + 1 < n && __Str::cmp((void^)el[child], (void^)el[child + 1]) < 0 { child += 1; }");
    put("            if __Str::cmp((void^)el[root], (void^)el[child]) >= 0 { return; }");
    put("            int t = el[root];");
    put("            el[root] = el[child];");
    put("            el[child] = t;");
    put("            root = child;");
    put("        }");
    put("    }");
    put("}");
    put("");
    put("// Reading the keyboard (cin >> x, cinf >> x): a buffer over file descriptor 0.");
    put("char std_in_buf[4096];");
    put("int std_in_pos;");
    put("int std_in_len;");
    put("");
    put("struct __In {");
    put("    // the next byte without taking it, or -1 at the end of the input");
    put("    static int peek() {");
    put("        if std_in_pos >= std_in_len {");
    put("            int n = syscall(63, 0, @std_in_buf, 4096);");
    put("            if n <= 0 { return -1; }");
    put("            std_in_len = n;");
    put("            std_in_pos = 0;");
    put("        }");
    put("        return std_in_buf[std_in_pos];");
    put("    }");
    put("    static bool space(int c) {");
    put("        return c == 32 || c == 9 || c == 10 || c == 13;");
    put("    }");
    put("    // skip white space: the first character of the next word, or -1");
    put("    static int start() {");
    put("        int c = __In::peek();");
    put("        while c >= 0 && __In::space(c) {");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        return c;");
    put("    }");
    put("    // a word into a String");
    put("    static void str(void^ h) {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        __Str::clear(h);");
    put("        while c >= 0 && !__In::space(c) {");
    put("            __Str::push(h, c);");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("    }");
    put("    // a whole number (an error unless lo <= value <= hi; no limits when lo > hi; uns = 1: no minus sign)");
    put("    static int num(int lo, int hi, int uns) {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        int neg = 0;");
    put("        if c == '-' || c == '+' {");
    put("            if c == '-' { neg = 1; }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        if c < '0' || c > '9' { throw \"invalid input\"; }");
    put("        if neg == 1 && uns == 1 { throw \"invalid input\"; }");
    put("        int v = 0;");
    put("        while c >= '0' && c <= '9' {");
    put("            v = v * 10 + (c - '0');");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        if c >= 0 && !__In::space(c) { throw \"invalid input\"; }");
    put("        if neg == 1 { v = 0 - v; }");
    put("        if lo <= hi && (v < lo || v > hi) { throw \"number out of range\"; }");
    put("        return v;");
    put("    }");
    put("    // a decimal number: 12  -3.5  .5  2e-3");
    put("    static double fnum() {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        int neg = 0;");
    put("        if c == '-' || c == '+' {");
    put("            if c == '-' { neg = 1; }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        int mant = 0;");
    put("        int exp = 0;");
    put("        int seen = 0;");
    put("        while c >= '0' && c <= '9' {");
    put("            seen = 1;");
    put("            if mant < 100000000000000000 { mant = mant * 10 + (c - '0'); } else { exp += 1; }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        if c == '.' {");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("            while c >= '0' && c <= '9' {");
    put("                seen = 1;");
    put("                if mant < 100000000000000000 {");
    put("                    mant = mant * 10 + (c - '0');");
    put("                    exp -= 1;");
    put("                }");
    put("                std_in_pos += 1;");
    put("                c = __In::peek();");
    put("            }");
    put("        }");
    put("        if seen == 0 { throw \"invalid input\"; }");
    put("        if c == 'e' || c == 'E' {");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("            int eneg = 0;");
    put("            if c == '-' || c == '+' {");
    put("                if c == '-' { eneg = 1; }");
    put("                std_in_pos += 1;");
    put("                c = __In::peek();");
    put("            }");
    put("            if c < '0' || c > '9' { throw \"invalid input\"; }");
    put("            int ev = 0;");
    put("            while c >= '0' && c <= '9' {");
    put("                if ev < 10000 { ev = ev * 10 + (c - '0'); }");
    put("                std_in_pos += 1;");
    put("                c = __In::peek();");
    put("            }");
    put("            if eneg == 1 { exp -= ev; } else { exp += ev; }");
    put("        }");
    put("        if c >= 0 && !__In::space(c) { throw \"invalid input\"; }");
    put("        double v = (double)mant;");
    put("        while exp > 0 {");
    put("            v = v * 10.0;");
    put("            exp -= 1;");
    put("        }");
    put("        while exp < 0 {");
    put("            v = v / 10.0;");
    put("            exp += 1;");
    put("        }");
    put("        if neg == 1 { v = -v; }");
    put("        return v;");
    put("    }");
    put("    // one character");
    put("    static int ch() {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        std_in_pos += 1;");
    put("        return c;");
    put("    }");
    put("    static int put(char^ buf, int at, char^ s) {");
    put("        int i = 0;");
    put("        while s[i] != 0 {");
    put("            buf[at] = s[i];");
    put("            at += 1;");
    put("            i += 1;");
    put("        }");
    put("        return at;");
    put("    }");
    put("    static int putnum(char^ buf, int at, int v) {");
    put("        char d[24];");
    put("        int n = 0;");
    put("        if v == 0 {");
    put("            d[0] = '0';");
    put("            n = 1;");
    put("        }");
    put("        while v > 0 {");
    put("            d[n] = '0' + v % 10;");
    put("            v = v / 10;");
    put("            n += 1;");
    put("        }");
    put("        while n > 0 {");
    put("            n -= 1;");
    put("            buf[at] = d[n];");
    put("            at += 1;");
    put("        }");
    put("        return at;");
    put("    }");
    put("    // a word into dst (room for cap characters including the 0): longer words are cut");
    put("    static int word(char^ dst, int cap, char^ name) {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        int n = 0;");
    put("        int cut = 0;");
    put("        while c >= 0 && !__In::space(c) {");
    put("            if n < cap - 1 {");
    put("                dst[n] = c;");
    put("                n += 1;");
    put("            } else {");
    put("                cut = 1;");
    put("            }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        dst[n] = 0;");
    put("        if cut == 1 {");
    put("            char m[200];");
    put("            int at = __In::put(@m, 0, \"warning: input truncated — '\");");
    put("            at = __In::put(@m, at, name);");
    put("            at = __In::put(@m, at, \"' accepts max \");");
    put("            at = __In::putnum(@m, at, cap - 1);");
    put("            at = __In::put(@m, at, \" characters (char[\");");
    put("            at = __In::putnum(@m, at, cap);");
    put("            at = __In::put(@m, at, \"] - 1 for \\\\0)\\n\");");
    put("            syscall(64, 2, @m, at);");
    put("        }");
    put("        return n;");
    put("    }");
    put("}");
    put("");
    put("// #multithread for i in a..b { ... }: the iterations are shared among several threads.");
    put("struct __Mt {");
    put("    // how many threads the machine can run at once (1 .. 16)");
    put("    static int cores() {");
    put("        char mask[128];");
    put("        int n = syscall(123, 0, 128, @mask);               // sched_getaffinity");
    put("        if n <= 0 { return 4; }");
    put("        int c = 0;");
    put("        for i in 0..n {");
    put("            int b = mask[i];");
    put("            while b != 0 {");
    put("                c += b & 1;");
    put("                b = b >> 1;");
    put("            }");
    put("        }");
    put("        if c < 1 { c = 1; }");
    put("        if c > 16 { c = 16; }");
    put("        return c;");
    put("    }");
    put("    // worker = the address of the compiled loop body (it gets a block [frame of the caller, from, to]);");
    put("    // runs it on several threads, each with its own part of lo..hi, and waits for all of them");
    put("    static void run(int worker, int fp, int lo, int hi) {");
    put("        int n = hi - lo;");
    put("        if n <= 0 { return; }");
    put("        int parts = __Mt::cores();");
    put("        if parts > n { parts = n; }");
    put("        int size = 1048576;");
    put("        int^ blk = (int^)Mem::alloc(parts * 64);          // per part: [0] frame [1] from [2] to [3] thread id [4] stack");
    put("        if (int)blk == 0 { __panic(\"out of memory\"); }");
    put("        for p in 0..parts {");
    put("            blk[p * 8] = fp;");
    put("            blk[p * 8 + 1] = lo + n * p / parts;");
    put("            blk[p * 8 + 2] = lo + n * (p + 1) / parts;");
    put("            blk[p * 8 + 3] = 0;");
    put("            int base = syscall(222, 0, size, 3, 34, -1, 0);");
    put("            if base < 0 { throw \"cannot start the threads of the #multithread loop\"; }");
    put("            blk[p * 8 + 4] = base;");
    put("            int top = base + size - 1024;");
    put("            int tid = __thread_start(worker, (int)blk + p * 64, top, (int)blk + p * 64 + 24, top);");
    put("            if tid < 0 { throw \"cannot start the threads of the #multithread loop\"; }");
    put("        }");
    put("        for p in 0..parts {");
    put("            while blk[p * 8 + 3] != 0 {");
    put("                syscall(98, (int)blk + p * 64 + 24, 0, blk[p * 8 + 3], 0, 0, 0);");
    put("            }");
    put("            syscall(215, blk[p * 8 + 4], size);");
    put("        }");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}
