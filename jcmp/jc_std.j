// push_cpu(): `import cpu` -- threads and locks.
void push_cpu() {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    put("// cpu: threads and locks.   import cpu    using cpu::thread    using cpu::mutex");
    put("//");
    put("//   void work(void^ arg) { ... }");
    put("//   Thread t = create(work, @data);   t.join();      or  t.detach();");
    put("//   Mutex m;   m.lock();  ...  m.unlock();");
    put("//");
    put("// A Thread value is a handle: copies of it refer to the same thread. The thread runs on its own");
    put("// 1 MB stack (taken from the system); join() gives the stack back. A detached thread cannot free its");
    put("// own stack, so that memory stays until the program ends.");
    put("");
    put("struct Mutex {");
    put("    int state;                         // 0 free, 1 taken, 2 taken and somebody waits");
    put("");
    put("    void init(self) {");
    put("        self.state = 0;");
    put("    }");
    put("    void lock(self) {");
    put("        int^ w = @self.state;");
    put("        int c = __cas(w, 0, 1);");
    put("        if c == 0 { return; }");
    put("        if c != 2 { c = __xchg(w, 2); }");
    put("        while c != 0 {");
    put("            syscall(98, w, 128, 2, 0, 0, 0);           // futex wait: sleep while the word is 2");
    put("            c = __xchg(w, 2);");
    put("        }");
    put("    }");
    put("    void unlock(self) {");
    put("        int^ w = @self.state;");
    put("        int old = __xchg(w, 0);");
    put("        if old == 2 { syscall(98, w, 129, 1, 0, 0, 0); }     // futex wake: one waiter");
    put("    }");
    put("    // true if the lock was free and is now yours");
    put("    bool try_lock(self) {");
    put("        int^ w = @self.state;");
    put("        return __cas(w, 0, 1) == 0;");
    put("    }");
    put("}");
    put("");
    put("struct Thread {");
    put("    int^ cb;                           // [0] thread id (the kernel makes it 0 when the thread ends), [1] stack, [2] size, [3] detached");
    put("");
    put("    // start function(arg) in a new thread");
    put("    static Thread create(void(void^)^ f, void^ arg) {");
    put("        int size = 1048576;");
    put("        int base = syscall(222, 0, size, 3, 34, -1, 0);       // mmap: the stack (zeroed)");
    put("        if base < 0 { throw \"cannot create the thread: no memory for its stack\"; }");
    put("        int^ cb = (int^)Mem::alloc(32);");
    put("        if (int)cb == 0 { throw \"cannot create the thread: out of memory\"; }");
    put("        cb[1] = base;");
    put("        cb[2] = size;");
    put("        cb[3] = 0;");
    put("        int block = base + size - 1024;                        // the thread's own block (try/catch state) at the top");
    put("        int tid = __thread_start(f, arg, block, (int)cb, block);");
    put("        if tid < 0 {");
    put("            syscall(215, base, size);");
    put("            Mem::free(cb);");
    put("            throw \"cannot create the thread\";");
    put("        }");
    put("        Thread t;");
    put("        t.cb = cb;");
    put("        return t;");
    put("    }");
    put("    // wait until the thread has ended");
    put("    void join(self) {");
    put("        int^ cb = self.cb;");
    put("        if (int)cb == 0 { throw \"join: this is not a running or finished thread\"; }");
    put("        if cb[3] != 0 { throw \"cannot join a detached thread\"; }");
    put("        while cb[0] != 0 {");
    put("            syscall(98, cb, 0, cb[0], 0, 0, 0);                // futex wait (not the private kind: the kernel wakes the shared one at thread exit)");
    put("        }");
    put("        syscall(215, cb[1], cb[2]);                            // give the stack back");
    put("        Mem::free(cb);");
    put("        self.cb = null;");
    put("    }");
    put("    // let the thread run on its own; it cannot be joined any more");
    put("    void detach(self) {");
    put("        int^ cb = self.cb;");
    put("        if (int)cb == 0 { throw \"detach: this is not a thread\"; }");
    put("        if cb[3] != 0 { throw \"the thread is already detached\"; }");
    put("        cb[3] = 1;");
    put("    }");
    put("    bool is_running(self) {");
    put("        int^ cb = self.cb;");
    put("        if (int)cb == 0 { return false; }");
    put("        return cb[0] != 0;");
    put("    }");
    put("    // pause the calling thread for ms milliseconds");
    put("    static void sleep(int ms) {");
    put("        int ts[2];");
    put("        ts[0] = ms / 1000;");
    put("        ts[1] = ms % 1000 * 1000000;");
    put("        syscall(101, @ts, 0);");
    put("    }");
    put("    static void yield() {");
    put("        syscall(124);");
    put("    }");
    put("    static int id() {");
    put("        return syscall(178);");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}

// push_prelude(): read in front of every program (Mem and the dynamic array routines).
void push_prelude() {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    put("// The prelude: read in front of every program (unused functions are left out).");
    put("// Mem: a small heap. Every block has a 16-byte header: [size, next-free].");
    put("int std_heap_cur;");
    put("int std_heap_end;");
    put("int std_free_list;");
    put("int std_mem_lock;                 // 0 free, 1 taken (threads share the heap)");
    put("int std_alloc_n;                  // blocks given out / given back (the -d build reports the difference at the end)");
    put("int std_free_n;");
    put("");
    put("struct Mem {");
    put("    static void lock_heap() {");
    put("        while __cas(@std_mem_lock, 0, 1) != 0 {");
    put("            syscall(124);                  // sched_yield: let the thread that holds the heap finish");
    put("        }");
    put("    }");
    put("    static void unlock_heap() {");
    put("        __xchg(@std_mem_lock, 0);");
    put("    }");
    put("    // n bytes, not cleared (null if the system has no memory left)");
    put("    static void^ alloc(int n) {");
    put("        Mem::lock_heap();");
    put("        void^ r = Mem::alloc_raw(n);");
    put("        Mem::unlock_heap();");
    put("        return r;");
    put("    }");
    put("    static void^ alloc_raw(int n) {");
    put("        if n <= 0 { return null; }");
    put("        int need = (n + 15) / 16 * 16 + 16;");
    put("        int prev = 0;");
    put("        int cur = std_free_list;");
    put("        while cur != 0 {");
    put("            int^ hdr = (int^)cur;");
    put("            if hdr[0] >= need {");
    put("                if prev == 0 {");
    put("                    std_free_list = hdr[1];");
    put("                } else {");
    put("                    int^ before = (int^)prev;");
    put("                    before[1] = hdr[1];");
    put("                }");
    put("                std_alloc_n += 1;");
    put("                return (void^)(cur + 16);");
    put("            }");
    put("            prev = cur;");
    put("            cur = hdr[1];");
    put("        }");
    put("        if std_heap_cur + need > std_heap_end {");
    put("            int chunk = 1048576;");
    put("            if need > chunk { chunk = (need + 4095) / 4096 * 4096; }");
    put("            int base = syscall(222, 0, chunk, 3, 34, -1, 0);      // mmap: anonymous, read + write");
    put("            if base < 0 { return null; }");
    put("            std_heap_cur = base;");
    put("            std_heap_end = base + chunk;");
    put("        }");
    put("        int blk = std_heap_cur;");
    put("        std_heap_cur = std_heap_cur + need;");
    put("        std_alloc_n += 1;");
    put("        int^ head = (int^)blk;");
    put("        head[0] = need;");
    put("        return (void^)(blk + 16);");
    put("    }");
    put("    // give a block from alloc back (null is ignored)");
    put("    static void free(void^ p) {");
    put("        Mem::lock_heap();");
    put("        Mem::free_raw(p);");
    put("        Mem::unlock_heap();");
    put("    }");
    put("    static void free_raw(void^ p) {");
    put("        if (int)p == 0 { return; }");
    put("        int blk = (int)p - 16;");
    put("        int^ head = (int^)blk;");
    put("        head[1] = std_free_list;");
    put("        std_free_list = blk;");
    put("        std_free_n += 1;");
    put("    }");
    put("    // -d : at the end of main, say how many blocks were never given back");
    put("    static void report() {");
    put("        int n = std_alloc_n - std_free_n;");
    put("        if n <= 0 { return; }");
    put("        char d[24];");
    put("        int k = 23;");
    put("        d[k] = 10;");
    put("        while n > 0 {");
    put("            k -= 1;");
    put("            d[k] = '0' + n % 10;");
    put("            n = n / 10;");
    put("        }");
    put("        syscall(64, 2, \"debug: memory blocks never freed: \", 34);");
    put("        syscall(64, 2, @d + k, 24 - k);");
    put("    }");
    put("    static void set(void^ p, int value, int n) {");
    put("        char^ q = (char^)p;");
    put("        int i = 0;");
    put("        while i < n {");
    put("            q[i] = value;");
    put("            i += 1;");
    put("        }");
    put("    }");
    put("    static void copy(void^ dst, void^ src, int n) {");
    put("        char^ d = (char^)dst;");
    put("        char^ s = (char^)src;");
    put("        int i = 0;");
    put("        while i < n {");
    put("            d[i] = s[i];");
    put("            i += 1;");
    put("        }");
    put("    }");
    put("}");
    put("");
    put("// Dynamic arrays (T[] x = arr(n)): a header [length, capacity, data, element size]");
    put("// points to the elements. The header stays where it is, so every copy of the");
    put("// variable sees the same array; only the data block moves when it grows.");
    put("struct __Arr {");
    put("    static void nullerr() {");
    put("        throw \"the dynamic array is null\";");
    put("    }");
    put("    static void^ make(int esize, int cap) {");
    put("        int^ h = (int^)Mem::alloc(32);");
    put("        if (int)h == 0 { throw \"out of memory\"; }");
    put("        int c = cap;");
    put("        if c < 4 { c = 4; }");
    put("        h[0] = 0;");
    put("        h[1] = c;");
    put("        h[2] = (int)Mem::alloc(c * esize);");
    put("        h[3] = esize;");
    put("        if h[2] == 0 { throw \"out of memory\"; }");
    put("        return (void^)h;");
    put("    }");
    put("    // room for at least `need` elements");
    put("    static void grow(int^ h, int need) {");
    put("        if need <= h[1] { return; }");
    put("        int c = h[1] * 2;");
    put("        if c < need { c = need; }");
    put("        int nd = (int)Mem::alloc(c * h[3]);");
    put("        if nd == 0 { throw \"out of memory\"; }");
    put("        Mem::copy((void^)nd, (void^)h[2], h[0] * h[3]);");
    put("        Mem::free((void^)h[2]);");
    put("        h[2] = nd;");
    put("        h[1] = c;");
    put("    }");
    put("    // append one element: returns the address of its (new) place");
    put("    static void^ slot(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { throw \"the dynamic array is null\"; }");
    put("        __Arr::grow(h, h[0] + 1);");
    put("        int at = h[2] + h[0] * h[3];");
    put("        h[0] += 1;");
    put("        return (void^)at;");
    put("    }");
    put("    // remove the last element: returns the address where it still is");
    put("    static void^ pop(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { throw \"the dynamic array is null\"; }");
    put("        if h[0] == 0 { throw \"pop from an empty array\"; }");
    put("        h[0] -= 1;");
    put("        return (void^)(h[2] + h[0] * h[3]);");
    put("    }");
    put("    static void resize(void^ hv, int n) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { throw \"the dynamic array is null\"; }");
    put("        if n < 0 { throw \"negative array size\"; }");
    put("        __Arr::grow(h, n);");
    put("        if n > h[0] { Mem::set((void^)(h[2] + h[0] * h[3]), 0, (n - h[0]) * h[3]); }");
    put("        h[0] = n;");
    put("    }");
    put("    // give the elements and the header back (null is ignored)");
    put("    static void free(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { return; }");
    put("        Mem::free((void^)h[2]);");
    put("        Mem::free(hv);");
    put("    }");
    put("}");
    put("");
    put("// Reading the keyboard (cin >> x, cinf >> x): a buffer over file descriptor 0.");
    put("char std_in_buf[4096];");
    put("int std_in_pos;");
    put("int std_in_len;");
    put("");
    put("struct __In {");
    put("    // the next byte without taking it, or -1 at the end of the input");
    put("    static int peek() {");
    put("        if std_in_pos >= std_in_len {");
    put("            int n = syscall(63, 0, @std_in_buf, 4096);");
    put("            if n <= 0 { return -1; }");
    put("            std_in_len = n;");
    put("            std_in_pos = 0;");
    put("        }");
    put("        return std_in_buf[std_in_pos];");
    put("    }");
    put("    static bool space(int c) {");
    put("        return c == 32 || c == 9 || c == 10 || c == 13;");
    put("    }");
    put("    // skip white space: the first character of the next word, or -1");
    put("    static int start() {");
    put("        int c = __In::peek();");
    put("        while c >= 0 && __In::space(c) {");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        return c;");
    put("    }");
    put("    // a whole number (an error unless lo <= value <= hi; no limits when lo > hi; uns = 1: no minus sign)");
    put("    static int num(int lo, int hi, int uns) {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        int neg = 0;");
    put("        if c == '-' || c == '+' {");
    put("            if c == '-' { neg = 1; }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        if c < '0' || c > '9' { throw \"invalid input\"; }");
    put("        if neg == 1 && uns == 1 { throw \"invalid input\"; }");
    put("        int v = 0;");
    put("        while c >= '0' && c <= '9' {");
    put("            v = v * 10 + (c - '0');");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        if c >= 0 && !__In::space(c) { throw \"invalid input\"; }");
    put("        if neg == 1 { v = 0 - v; }");
    put("        if lo <= hi && (v < lo || v > hi) { throw \"number out of range\"; }");
    put("        return v;");
    put("    }");
    put("    // a decimal number: 12  -3.5  .5  2e-3");
    put("    static f64 fnum() {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        int neg = 0;");
    put("        if c == '-' || c == '+' {");
    put("            if c == '-' { neg = 1; }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        int mant = 0;");
    put("        int exp = 0;");
    put("        int seen = 0;");
    put("        while c >= '0' && c <= '9' {");
    put("            seen = 1;");
    put("            if mant < 100000000000000000 { mant = mant * 10 + (c - '0'); } else { exp += 1; }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        if c == '.' {");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("            while c >= '0' && c <= '9' {");
    put("                seen = 1;");
    put("                if mant < 100000000000000000 {");
    put("                    mant = mant * 10 + (c - '0');");
    put("                    exp -= 1;");
    put("                }");
    put("                std_in_pos += 1;");
    put("                c = __In::peek();");
    put("            }");
    put("        }");
    put("        if seen == 0 { throw \"invalid input\"; }");
    put("        if c == 'e' || c == 'E' {");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("            int eneg = 0;");
    put("            if c == '-' || c == '+' {");
    put("                if c == '-' { eneg = 1; }");
    put("                std_in_pos += 1;");
    put("                c = __In::peek();");
    put("            }");
    put("            if c < '0' || c > '9' { throw \"invalid input\"; }");
    put("            int ev = 0;");
    put("            while c >= '0' && c <= '9' {");
    put("                if ev < 10000 { ev = ev * 10 + (c - '0'); }");
    put("                std_in_pos += 1;");
    put("                c = __In::peek();");
    put("            }");
    put("            if eneg == 1 { exp -= ev; } else { exp += ev; }");
    put("        }");
    put("        if c >= 0 && !__In::space(c) { throw \"invalid input\"; }");
    put("        f64 v = (f64)mant;");
    put("        while exp > 0 {");
    put("            v = v * 10.0;");
    put("            exp -= 1;");
    put("        }");
    put("        while exp < 0 {");
    put("            v = v / 10.0;");
    put("            exp += 1;");
    put("        }");
    put("        if neg == 1 { v = -v; }");
    put("        return v;");
    put("    }");
    put("    // one character");
    put("    static int ch() {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        std_in_pos += 1;");
    put("        return c;");
    put("    }");
    put("    static int put(char^ buf, int at, char^ s) {");
    put("        int i = 0;");
    put("        while s[i] != 0 {");
    put("            buf[at] = s[i];");
    put("            at += 1;");
    put("            i += 1;");
    put("        }");
    put("        return at;");
    put("    }");
    put("    static int putnum(char^ buf, int at, int v) {");
    put("        char d[24];");
    put("        int n = 0;");
    put("        if v == 0 {");
    put("            d[0] = '0';");
    put("            n = 1;");
    put("        }");
    put("        while v > 0 {");
    put("            d[n] = '0' + v % 10;");
    put("            v = v / 10;");
    put("            n += 1;");
    put("        }");
    put("        while n > 0 {");
    put("            n -= 1;");
    put("            buf[at] = d[n];");
    put("            at += 1;");
    put("        }");
    put("        return at;");
    put("    }");
    put("    // a word into dst (room for cap characters including the 0): longer words are cut");
    put("    static int word(char^ dst, int cap, char^ name) {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        int n = 0;");
    put("        int cut = 0;");
    put("        while c >= 0 && !__In::space(c) {");
    put("            if n < cap - 1 {");
    put("                dst[n] = c;");
    put("                n += 1;");
    put("            } else {");
    put("                cut = 1;");
    put("            }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        dst[n] = 0;");
    put("        if cut == 1 {");
    put("            char m[200];");
    put("            int at = __In::put(@m, 0, \"warning: input truncated — '\");");
    put("            at = __In::put(@m, at, name);");
    put("            at = __In::put(@m, at, \"' accepts max \");");
    put("            at = __In::putnum(@m, at, cap - 1);");
    put("            at = __In::put(@m, at, \" characters (char[\");");
    put("            at = __In::putnum(@m, at, cap);");
    put("            at = __In::put(@m, at, \"] - 1 for \\\\0)\\n\");");
    put("            syscall(64, 2, @m, at);");
    put("        }");
    put("        return n;");
    put("    }");
    put("}");
    put("");
    put("// #multithread for i in a..b { ... }: the iterations are shared among several threads.");
    put("struct __Mt {");
    put("    // how many threads the machine can run at once (1 .. 16)");
    put("    static int cores() {");
    put("        char mask[128];");
    put("        int n = syscall(123, 0, 128, @mask);               // sched_getaffinity");
    put("        if n <= 0 { return 4; }");
    put("        int c = 0;");
    put("        for i in 0..n {");
    put("            int b = mask[i];");
    put("            while b != 0 {");
    put("                c += b & 1;");
    put("                b = b >> 1;");
    put("            }");
    put("        }");
    put("        if c < 1 { c = 1; }");
    put("        if c > 16 { c = 16; }");
    put("        return c;");
    put("    }");
    put("    // worker = the address of the compiled loop body (it gets a block [frame of the caller, from, to]);");
    put("    // runs it on several threads, each with its own part of lo..hi, and waits for all of them");
    put("    static void run(int worker, int fp, int lo, int hi) {");
    put("        int n = hi - lo;");
    put("        if n <= 0 { return; }");
    put("        int parts = __Mt::cores();");
    put("        if parts > n { parts = n; }");
    put("        int size = 1048576;");
    put("        int^ blk = (int^)Mem::alloc(parts * 64);          // per part: [0] frame [1] from [2] to [3] thread id [4] stack");
    put("        if (int)blk == 0 { throw \"out of memory\"; }");
    put("        for p in 0..parts {");
    put("            blk[p * 8] = fp;");
    put("            blk[p * 8 + 1] = lo + n * p / parts;");
    put("            blk[p * 8 + 2] = lo + n * (p + 1) / parts;");
    put("            blk[p * 8 + 3] = 0;");
    put("            int base = syscall(222, 0, size, 3, 34, -1, 0);");
    put("            if base < 0 { throw \"cannot start the threads of the #multithread loop\"; }");
    put("            blk[p * 8 + 4] = base;");
    put("            int top = base + size - 1024;");
    put("            int tid = __thread_start(worker, (int)blk + p * 64, top, (int)blk + p * 64 + 24, top);");
    put("            if tid < 0 { throw \"cannot start the threads of the #multithread loop\"; }");
    put("        }");
    put("        for p in 0..parts {");
    put("            while blk[p * 8 + 3] != 0 {");
    put("                syscall(98, (int)blk + p * 64 + 24, 0, blk[p * 8 + 3], 0, 0, 0);");
    put("            }");
    put("            syscall(215, blk[p * 8 + 4], size);");
    put("        }");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}
