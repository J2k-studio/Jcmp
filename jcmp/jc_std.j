// push_std_units(mask): the units of the standard library in the mask become a new "file" that is read next (core, number, text, files, system, time, data, crypto).
void push_std_units(int mask) {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    stk_len[lx_depth] = cur_len;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    lvl_lib[lx_depth] = 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    if (mask & 1) != 0 {
        ext_put("core");
    }
    if (mask & 2) != 0 {
        ext_put("number");
    }
    if (mask & 4) != 0 {
        ext_put("text");
    }
    if (mask & 8) != 0 {
        ext_put("files");
    }
    if (mask & 16) != 0 {
        ext_put("system");
    }
    if (mask & 32) != 0 {
        ext_put("time");
    }
    if (mask & 64) != 0 {
        ext_put("data");
    }
    if (mask & 128) != 0 {
        ext_put("crypto");
    }
    if (mask & 256) != 0 {
        ext_put("net");
    }
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}

