    put("        int n = syscall(63, fd, buf, buf.len - 1);");
    put("        if n < 0 { return (i32)n; }");
    put("        buf[n] = 0;");
    put("        return (i32)n;");
    put("    }");
    put("    static i32 write(i32 fd, char buf[]) {");
    put("        int n = 0;");
    put("        while n < buf.len && buf[n] != 0 { n += 1; }");
    put("        return (i32)syscall(64, fd, buf, n);");
    put("    }");
    put("    static i32 read_line(i32 fd, char line[]) {");
    put("        int n = 0;");
    put("        char c = 0;");
    put("        while n < line.len - 1 {");
    put("            int got = syscall(63, fd, @c, 1);");
    put("            if got < 0 { return (i32)got; }");
    put("            if got == 0 {");
    put("                if n == 0 { return -1; }");
    put("                break;");
    put("            }");
    put("            if c == 10 { break; }");
    put("            line[n] = c;");
    put("            n += 1;");
    put("        }");
    put("        line[n] = 0;");
    put("        return (i32)n;");
    put("    }");
