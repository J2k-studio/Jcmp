    put("enum class ErrorKind { Other, NotFound, Denied, Invalid, Parse, Io };");
    put("");
    put("// the usual error: what went wrong (kind) and a message");
    put("struct Error {");
    put("    ErrorKind kind;");
    put("    String message;");
    put("    static Error make(ErrorKind kind, String message) {");
    put("        Error e;");
    put("        e.kind = kind;");
    put("        e.message = message;");
    put("        return e;");
    put("    }");
    put("    void free(self) {");
    put("        self.message.free();");
    put("    }");
    put("};");
    put("");
    put("enum class Option<T> { Some(T value), None;");
    put("    bool is_some(self) { return self.__tag == 0; }");
    put("    bool is_none(self) { return self.__tag == 1; }");
    put("    // the value (throws if there is none)");
    put("    T unwrap(self) {");
    put("        switch self^ {");
    put("            Option::Some(v): return v;");
    put("            Option::None: __panic(\"unwrap of a None\");");
    put("        }");
    put("        __panic(\"unwrap of a None\");");
    put("    }");
    put("    // the value, or fallback");
    put("    T or(self, T fallback) {");
    put("        switch self^ {");
    put("            Option::Some(v): return v;");
    put("            Option::None: return fallback;");
    put("        }");
    put("        return fallback;");
    put("    }");
    put("};");
    put("");
    put("enum class Result<T, E> { Ok(T value), Err(E error);");
    put("    bool is_ok(self) { return self.__tag == 0; }");
    put("    bool is_err(self) { return self.__tag == 1; }");
    put("    // the value (throws if it is an error)");
    put("    T unwrap(self) {");
    put("        switch self^ {");
    put("            Result::Ok(v): return v;");
    put("            Result::Err(e): __panic(\"unwrap of an Err\");");
    put("        }");
    put("        __panic(\"unwrap of an Err\");");
    put("    }");
    put("    // the value, or fallback");
    put("    T or(self, T fallback) {");
    put("        switch self^ {");
    put("            Result::Ok(v): return v;");
    put("            Result::Err(e): return fallback;");
    put("        }");
    put("        return fallback;");
    put("    }");
    put("};");
    put("");
    put("// Map<K,V> and Set<T>: hash tables (open addressing, linear probing). K and T can be int, char, double,");
    put("// pointers or String. Both have a free(self) method, so a local one is freed at the end of its block.");
    put("");
    put("struct Map<K, V> {");
    put("    K[] keys;");
    put("    V[] vals;");
    put("    int[] st;                  // 0 empty, 1 used, 2 deleted");
    put("    int len;                   // how many keys");
    put("    int used;                  // used + deleted places");
    put("");
    put("    // the place of key k, or -1");
    put("    int find(self, K k) {");
    put("        if self.st == null { return -1; }");
    put("        int mask = self.st.len - 1;");
    put("        int i = __hash(k) & mask;");
    put("        while true {");
    put("            int s = self.st[i];");
    put("            if s == 0 { return -1; }");
    put("            if s == 1 && self.keys[i] == k { return i; }");
    put("            i = (i + 1) & mask;");
    put("        }");
    put("        return -1;");
    put("    }");
    put("    bool has(self, K k) {");
    put("        return self.find(k) >= 0;");
    put("    }");
    put("    // the value of key k (throws \"key not found\")");
    put("    V get(self, K k) {");
    put("        int i = self.find(k);");
    put("        if i < 0 { throw \"key not found\"; }");
    put("        return self.vals[i];");
    put("    }");
    put("    // the value of key k as an Option: Some(value) or None");
    put("    Option<V> try_get(self, K k) {");
    put("        int i = self.find(k);");
    put("        if i < 0 { return Option<V>::None; }");
    put("        return Option<V>::Some(self.vals[i]);");
    put("    }");
    put("    void put(self, K k, V v) {");
    put("        if self.st == null { self.rehash(8); }");
    put("        if (self.used + 1) * 4 > self.st.len * 3 { self.rehash(self.st.len * 2); }");
    put("        int mask = self.st.len - 1;");
    put("        int i = __hash(k) & mask;");
    put("        int tomb = -1;");
    put("        while true {");
    put("            int s = self.st[i];");
    put("            if s == 0 { break; }");
    put("            if s == 2 && tomb < 0 { tomb = i; }");
    put("            if s == 1 && self.keys[i] == k {");
    put("                self.vals[i] = v;");
    put("                return;");
    put("            }");
    put("            i = (i + 1) & mask;");
    put("        }");
    put("        if tomb >= 0 {");
    put("            i = tomb;");
    put("        } else {");
    put("            self.used += 1;");
    put("        }");
    put("        self.keys[i] = k;");
    put("        self.vals[i] = v;");
    put("        self.st[i] = 1;");
    put("        self.len += 1;");
    put("    }");
    put("    // true if key k was there");
    put("    bool remove(self, K k) {");
    put("        int i = self.find(k);");
    put("        if i < 0 { return false; }");
    put("        self.st[i] = 2;");
    put("        self.len -= 1;");
    put("        return true;");
    put("    }");
    put("    void rehash(self, int cap) {");
    put("        K[] ok = self.keys;");
    put("        V[] ov = self.vals;");
    put("        int[] os = self.st;");
    put("        self.keys = arr(cap);");
    put("        self.keys.resize(cap);");
    put("        self.vals = arr(cap);");
    put("        self.vals.resize(cap);");
    put("        self.st = arr(cap);");
    put("        self.st.resize(cap);");
    put("        self.len = 0;");
    put("        self.used = 0;");
    put("        if os != null {");
    put("            for i in 0..os.len {");
    put("                if os[i] == 1 { self.put(ok[i], ov[i]); }");
    put("            }");
    put("            ok.free();");
    put("            ov.free();");
    put("            os.free();");
    put("        }");
    put("    }");
    put("    // a new array with the keys (in table order)");
    put("    K[] keys_list(self) {");
    put("        K[] r = arr(self.len + 1);");
    put("        if self.st != null {");
    put("            for i in 0..self.st.len {");
    put("                if self.st[i] == 1 { r.push(self.keys[i]); }");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    V[] values_list(self) {");
    put("        V[] r = arr(self.len + 1);");
    put("        if self.st != null {");
    put("            for i in 0..self.st.len {");
    put("                if self.st[i] == 1 { r.push(self.vals[i]); }");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    void free(self) {");
    put("        self.keys.free();");
    put("        self.vals.free();");
    put("        self.st.free();");
    put("        self.len = 0;");
    put("        self.used = 0;");
    put("    }");
    put("}");
    put("");
    put("struct Set<T> {");
    put("    T[] items;");
    put("    int[] st;");
    put("    int len;");
    put("    int used;");
    put("");
    put("    int find(self, T x) {");
    put("        if self.st == null { return -1; }");
    put("        int mask = self.st.len - 1;");
    put("        int i = __hash(x) & mask;");
    put("        while true {");
    put("            int s = self.st[i];");
    put("            if s == 0 { return -1; }");
    put("            if s == 1 && self.items[i] == x { return i; }");
    put("            i = (i + 1) & mask;");
    put("        }");
    put("        return -1;");
    put("    }");
    put("    bool has(self, T x) {");
    put("        return self.find(x) >= 0;");
    put("    }");
    put("    // true if x was new");
    put("    bool add(self, T x) {");
    put("        if self.find(x) >= 0 { return false; }");
    put("        if self.st == null { self.rehash(8); }");
    put("        if (self.used + 1) * 4 > self.st.len * 3 { self.rehash(self.st.len * 2); }");
    put("        int mask = self.st.len - 1;");
    put("        int i = __hash(x) & mask;");
    put("        while self.st[i] == 1 { i = (i + 1) & mask; }");
    put("        if self.st[i] == 0 { self.used += 1; }");
    put("        self.items[i] = x;");
    put("        self.st[i] = 1;");
    put("        self.len += 1;");
    put("        return true;");
    put("    }");
    put("    bool remove(self, T x) {");
    put("        int i = self.find(x);");
    put("        if i < 0 { return false; }");
    put("        self.st[i] = 2;");
    put("        self.len -= 1;");
    put("        return true;");
    put("    }");
    put("    void rehash(self, int cap) {");
    put("        T[] oi = self.items;");
    put("        int[] os = self.st;");
    put("        self.items = arr(cap);");
    put("        self.items.resize(cap);");
    put("        self.st = arr(cap);");
    put("        self.st.resize(cap);");
    put("        self.len = 0;");
    put("        self.used = 0;");
    put("        if os != null {");
    put("            for i in 0..os.len {");
    put("                if os[i] == 1 { self.add(oi[i]); }");
    put("            }");
    put("            oi.free();");
    put("            os.free();");
    put("        }");
    put("    }");
    put("    T[] items_list(self) {");
    put("        T[] r = arr(self.len + 1);");
    put("        if self.st != null {");
    put("            for i in 0..self.st.len {");
    put("                if self.st[i] == 1 { r.push(self.items[i]); }");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    void free(self) {");
    put("        self.items.free();");
    put("        self.st.free();");
    put("        self.len = 0;");
    put("        self.used = 0;");
    put("    }");
    put("}");
    put("");
    put("// Files, folders, the environment, time and random numbers. A name is a String (a text in the program is fine).");
    put("// Things that can fail for outside reasons give a Result<T, Error>; check it with switch or use ? .");
    put("");
    put("// an Error for the system error number e (a negative number from a system call is fine) and what was being done");
    put("struct Fs {");
    put("    static Error error(int e, String what, String path) {");
    put("        if e < 0 { e = 0 - e; }");
    put("        ErrorKind k = ErrorKind::Io;");
    put("        if e == 2 || e == 20 { k = ErrorKind::NotFound; }");
    put("        if e == 13 || e == 1 { k = ErrorKind::Denied; }");
    put("        if e == 22 || e == 21 || e == 36 { k = ErrorKind::Invalid; }");
    put("        String m = what + path;");
    put("        m += \" (error \";");
    put("        m += (char)('0' + e / 100 % 10);");
    put("        m += (char)('0' + e / 10 % 10);");
    put("        m += (char)('0' + e % 10);");
    put("        m += \")\";");
    put("        return Error::make(k, m);");
    put("    }");
    put("    // the whole file as a String");
    put("    static Result<String, Error> read_text(String path) {");
    put("        int fd = syscall(56, -100, path.c(), 0, 0);");
    put("        if fd < 0 { return Result<String, Error>::Err(Fs::error(fd, \"cannot open \", path)); }");
    put("        String text = \"\";");
    put("        char buf[4096];");
    put("        int n = syscall(63, fd, @buf, 4095);");
    put("        while n > 0 {");
    put("            buf[n] = 0;");
    put("            text.append((char^)@buf);");
    put("            n = syscall(63, fd, @buf, 4095);");
    put("        }");
    put("        syscall(57, fd);");
    put("        if n < 0 { return Result<String, Error>::Err(Fs::error(n, \"cannot read \", path)); }");
    put("        return Result<String, Error>::Ok(text);");
    put("    }");
    put("    // the lines of a file (without the line ends)");
    put("    static Result<String[], Error> read_lines(String path) {");
    put("        String text = Fs::read_text(path)?;");
    put("        String[] parts = text.split(\"\\n\");");
    put("        String[] lines = arr(parts.len + 1);");
    put("        for i in 0..parts.len {");
    put("            String line = parts[i];");
    put("            int n = line.len;");
    put("            if n > 0 {");
    put("                char last = line[n - 1];");
    put("                if last == 13 { line = line.slice(0, n - 1); }");
    put("            }");
    put("            if i < parts.len - 1 || line.len > 0 { lines.push(line); }");
    put("        }");
    put("        parts.free();");
    put("        return Result<String[], Error>::Ok(lines);");
    put("    }");
    put("    // write the text to the file (made or emptied); Ok(the number of bytes)");
    put("    static Result<int, Error> write_text(String path, String text) {");
    put("        return Fs::put(path, text, 577);");
    put("    }");
    put("    // add the text at the end of the file (made if needed)");
    put("    static Result<int, Error> append_text(String path, String text) {");
    put("        return Fs::put(path, text, 1089);");
    put("    }");
    put("    static Result<int, Error> put(String path, String text, int flags) {");
    put("        int fd = syscall(56, -100, path.c(), flags, 420);");
    put("        if fd < 0 { return Result<int, Error>::Err(Fs::error(fd, \"cannot write \", path)); }");
    put("        int done = 0;");
    put("        char^ p = text.c();");
    put("        while done < text.len {");
    put("            int n = syscall(64, fd, p + done, text.len - done);");
    put("            if n <= 0 {");
    put("                syscall(57, fd);");
    put("                return Result<int, Error>::Err(Fs::error(n, \"cannot write \", path));");
    put("            }");
    put("            done += n;");
    put("        }");
    put("        syscall(57, fd);");
    put("        return Result<int, Error>::Ok(done);");
    put("    }");
    put("    static bool exists(String path) {");
    put("        return syscall(48, -100, path.c(), 0, 0) == 0;");
    put("    }");
    put("    // the size of a file in bytes");
    put("    static Result<int, Error> size(String path) {");
    put("        int fd = syscall(56, -100, path.c(), 0, 0);");
    put("        if fd < 0 { return Result<int, Error>::Err(Fs::error(fd, \"cannot open \", path)); }");
    put("        int n = syscall(62, fd, 0, 2);");
    put("        syscall(57, fd);");
    put("        if n < 0 { return Result<int, Error>::Err(Fs::error(n, \"cannot size \", path)); }");
    put("        return Result<int, Error>::Ok(n);");
    put("    }");
    put("    static Result<int, Error> remove(String path) {");
    put("        int r = syscall(35, -100, path.c(), 0);");
    put("        if r < 0 { return Result<int, Error>::Err(Fs::error(r, \"cannot remove \", path)); }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("    static Result<int, Error> rename(String from, String to) {");
    put("        int r = syscall(38, -100, from.c(), -100, to.c());");
    put("        if r < 0 { return Result<int, Error>::Err(Fs::error(r, \"cannot rename \", from)); }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("}");
    put("");
    put("struct Dir {");
    put("    static bool exists(String path) {");
    put("        int st[18];");
    put("        if syscall(79, -100, path.c(), @st, 0) != 0 { return false; }       // newfstatat");
    put("        return (st[2] & 4294967295 & 61440) == 16384;                          // st_mode is a folder");
    put("    }");
    put("    static Result<int, Error> make(String path) {");
    put("        int r = syscall(34, -100, path.c(), 493);");
    put("        if r < 0 { return Result<int, Error>::Err(Fs::error(r, \"cannot make the folder \", path)); }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("    // the folder and the ones above it (like mkdir -p)");
    put("    static Result<int, Error> make_all(String path) {");
    put("        String part = \"\";");
    put("        for ch in path {");
    put("            if ch == '/' && part.len > 0 {");
    put("                if !Dir::exists(part) {");
    put("                    int r1 = syscall(34, -100, part.c(), 493);");
    put("                    if r1 < 0 { return Result<int, Error>::Err(Fs::error(r1, \"cannot make the folder \", part)); }");
    put("                }");
    put("            }");
    put("            part.push(ch);");
    put("        }");
    put("        if part.len > 0 && !Dir::exists(part) {");
    put("            int r2 = syscall(34, -100, part.c(), 493);");
    put("            if r2 < 0 { return Result<int, Error>::Err(Fs::error(r2, \"cannot make the folder \", part)); }");
    put("        }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("    // remove an empty folder");
    put("    static Result<int, Error> remove(String path) {");
    put("        int r = syscall(35, -100, path.c(), 512);                // AT_REMOVEDIR");
    put("        if r < 0 { return Result<int, Error>::Err(Fs::error(r, \"cannot remove the folder \", path)); }");
    put("        return Result<int, Error>::Ok(0);");
    put("    }");
    put("    // the names in a folder (not . and ..), in order");
    put("    static Result<String[], Error> list(String path) {");
    put("        int fd = syscall(56, -100, path.c(), 16384, 0);");
    put("        if fd < 0 { return Result<String[], Error>::Err(Fs::error(fd, \"cannot read the folder \", path)); }");
    put("        String[] names = arr(8);");
    put("        char buf[4096];");
    put("        int n = syscall(61, fd, @buf, 4096);                     // getdents64");
    put("        while n > 0 {");
    put("            int at = 0;");
    put("            while at < n {");
    put("                int reclen = buf[at + 16] + buf[at + 17] * 256;");
    put("                String name = \"\";");
    put("                int k = at + 19;");
    put("                while buf[k] != 0 {");
    put("                    name.push(buf[k]);");
    put("                    k += 1;");
    put("                }");
    put("                if !(name == \".\") && !(name == \"..\") { names.push(name); }");
    put("                at += reclen;");
    put("            }");
    put("            n = syscall(61, fd, @buf, 4096);");
    put("        }");
    put("        syscall(57, fd);");
    put("        names.sort();");
    put("        return Result<String[], Error>::Ok(names);");
    put("    }");
    put("    static Result<String, Error> current() {");
    put("        char buf[1024];");
    put("        int n = syscall(17, @buf, 1024);");
    put("        if n < 0 { return Result<String, Error>::Err(Fs::error(n, \"cannot get the folder\", \"\")); }");
    put("        String s = \"\";");
    put("        s.append((char^)@buf);");
    put("        return Result<String, Error>::Ok(s);");
    put("    }");
    put("}");
    put("");
    put("struct Env {");
    put("    // the value of an environment variable");
    put("    static Option<String> get(String name) {");
    put("        int i = argc() + 1;");
    put("        int nl = name.len;");
    put("        char^ nm = name.c();");
    put("        while arg(i) != null {");
    put("            char^ e = arg(i);");
    put("            int k = 0;");
    put("            while k < nl && e[k] == nm[k] { k += 1; }");
    put("            if k == nl && e[k] == '=' {");
    put("                String v = \"\";");
    put("                v.append((char^)(e + nl + 1));");
    put("                return Option<String>::Some(v);");
    put("            }");
    put("            i += 1;");
    put("        }");
    put("        return Option<String>::None;");
    put("    }");
    put("    // the arguments of the program (the first one is the program itself)");
    put("    static String[] args() {");
    put("        String[] r = arr(argc() + 1);");
    put("        for i in 0..argc() {");
    put("            String a = \"\";");
    put("            a.append((char^)arg(i));");
    put("            r.push(a);");
    put("        }");
    put("        return r;");
    put("    }");
    put("}");
    put("");
    put("struct Time {");
    put("    // milliseconds since 1970 (the clock of the computer)");
    put("    static int now_ms() {");
    put("        int ts[2];");
    put("        syscall(113, 0, @ts);");
    put("        return ts[0] * 1000 + ts[1] / 1000000;");
    put("    }");
    put("    // a clock that only goes forward, in nanoseconds: for measuring how long something takes");
    put("    static int mono_ns() {");
    put("        int ts[2];");
    put("        syscall(113, 1, @ts);");
    put("        return ts[0] * 1000000000 + ts[1];");
    put("    }");
    put("    static void sleep_ms(int ms) {");
    put("        int ts[2];");
    put("        ts[0] = ms / 1000;");
    put("        ts[1] = ms % 1000 * 1000000;");
    put("        syscall(101, @ts, 0);");
    put("    }");
    put("}");
    put("");
    put("u64 std_rand_state;");
    put("");
    put("struct Random {");
    put("    // start the series from a number (the same number gives the same series)");
    put("    static void seed(int s) {");
    put("        std_rand_state = (u64)s;");
    put("        if std_rand_state == 0 { std_rand_state = 88172645463325252; }");
    put("    }");
    put("    // the next number: 0 or more (xorshift64)");
    put("    static int next() {");
    put("        if std_rand_state == 0 { Random::seed(Time::mono_ns() + Time::now_ms()); }");
    put("        u64 x = std_rand_state;");
    put("        x = x xor (x shl 13);");
    put("        x = x xor (x shr 7);");
    put("        x = x xor (x shl 17);");
    put("        std_rand_state = x;");
    put("        return (int)(x shr 1);");
    put("    }");
    put("    // a number from lo up to (not including) hi");
    put("    static int range(int lo, int hi) {");
    put("        if hi <= lo { return lo; }");
    put("        return lo + Random::next() % (hi - lo);");
    put("    }");
    put("    // a decimal number from 0 up to (not including) 1");
    put("    static double unit() {");
    put("        return (double)(Random::next() shr 10) / 9.007199254740992e15;");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}

// push_cpu(): `import cpu` -- threads and locks.
void push_cpu() {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    put("// cpu: threads and locks.   import cpu    using cpu::thread    using cpu::mutex");
    put("//");
    put("//   void work(void^ arg) { ... }");
    put("//   Thread t = create(work, @data);   t.join();      or  t.detach();");
    put("//   Mutex m;   m.lock();  ...  m.unlock();");
    put("//");
    put("// A Thread value is a handle: copies of it refer to the same thread. The thread runs on its own");
    put("// 1 MB stack (taken from the system); join() gives the stack back. A detached thread cannot free its");
    put("// own stack, so that memory stays until the program ends.");
    put("");
    put("struct Mutex {");
    put("    int state;                         // 0 free, 1 taken, 2 taken and somebody waits");
    put("");
    put("    void init(self) {");
    put("        self.state = 0;");
    put("    }");
    put("    void lock(self) {");
    put("        int^ w = @self.state;");
    put("        int c = __cas(w, 0, 1);");
    put("        if c == 0 { return; }");
    put("        if c != 2 { c = __xchg(w, 2); }");
    put("        while c != 0 {");
    put("            syscall(98, w, 128, 2, 0, 0, 0);           // futex wait: sleep while the word is 2");
    put("            c = __xchg(w, 2);");
    put("        }");
    put("    }");
    put("    void unlock(self) {");
    put("        int^ w = @self.state;");
    put("        int old = __xchg(w, 0);");
    put("        if old == 2 { syscall(98, w, 129, 1, 0, 0, 0); }     // futex wake: one waiter");
    put("    }");
    put("    // true if the lock was free and is now yours");
    put("    bool try_lock(self) {");
    put("        int^ w = @self.state;");
    put("        return __cas(w, 0, 1) == 0;");
    put("    }");
    put("}");
    put("");
    put("struct Thread {");
    put("    int^ cb;                           // [0] thread id (the kernel makes it 0 when the thread ends), [1] stack, [2] size, [3] detached");
    put("");
    put("    // start function(arg) in a new thread");
    put("    static Thread create(void(void^)^ f, void^ arg) {");
    put("        int size = 1048576;");
    put("        int base = syscall(222, 0, size, 3, 34, -1, 0);       // mmap: the stack (zeroed)");
    put("        if base < 0 { throw \"cannot create the thread: no memory for its stack\"; }");
    put("        int^ cb = (int^)Mem::alloc(32);");
    put("        if (int)cb == 0 { throw \"cannot create the thread: out of memory\"; }");
    put("        cb[1] = base;");
    put("        cb[2] = size;");
    put("        cb[3] = 0;");
    put("        int block = base + size - 1024;                        // the thread's own block (try/catch state) at the top");
    put("        int tid = __thread_start(f, arg, block, (int)cb, block);");
    put("        if tid < 0 {");
    put("            syscall(215, base, size);");
    put("            Mem::free(cb);");
    put("            throw \"cannot create the thread\";");
    put("        }");
    put("        Thread t;");
    put("        t.cb = cb;");
    put("        return t;");
    put("    }");
    put("    // wait until the thread has ended");
    put("    void join(self) {");
    put("        int^ cb = self.cb;");
    put("        if (int)cb == 0 { throw \"join: this is not a running or finished thread\"; }");
    put("        if cb[3] != 0 { throw \"cannot join a detached thread\"; }");
    put("        while cb[0] != 0 {");
    put("            syscall(98, cb, 0, cb[0], 0, 0, 0);                // futex wait (not the private kind: the kernel wakes the shared one at thread exit)");
    put("        }");
    put("        syscall(215, cb[1], cb[2]);                            // give the stack back");
    put("        Mem::free(cb);");
    put("        self.cb = null;");
    put("    }");
    put("    // let the thread run on its own; it cannot be joined any more");
    put("    void detach(self) {");
    put("        int^ cb = self.cb;");
    put("        if (int)cb == 0 { throw \"detach: this is not a thread\"; }");
    put("        if cb[3] != 0 { throw \"the thread is already detached\"; }");
    put("        cb[3] = 1;");
    put("    }");
    put("    bool is_running(self) {");
    put("        int^ cb = self.cb;");
    put("        if (int)cb == 0 { return false; }");
    put("        return cb[0] != 0;");
    put("    }");
    put("    // pause the calling thread for ms milliseconds");
    put("    static void sleep(int ms) {");
    put("        int ts[2];");
    put("        ts[0] = ms / 1000;");
    put("        ts[1] = ms % 1000 * 1000000;");
    put("        syscall(101, @ts, 0);");
    put("    }");
    put("    static void yield() {");
    put("        syscall(124);");
    put("    }");
    put("    static int id() {");
    put("        return syscall(178);");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}

// push_prelude(): read in front of every program (Mem and the dynamic array routines).
void push_prelude() {
    if lx_depth >= 15 { die("imports nested too deeply"); }
    stk_pos[lx_depth] = cur_pos;
    stk_line[lx_depth] = cur_line;
    stk_ls[lx_depth] = cur_line_start;
    str_copy(@lvl_name + (lx_depth + 1) * 128, @lvl_name + lx_depth * 128, 128);
    lx_depth += 1;
    cur_base = lx_depth * 524288;
    cur_len = 0;
    put("// The prelude: read in front of every program (unused functions are left out).");
    put("// Mem: a small heap. Every block has a 16-byte header: [size, next-free].");
    put("int std_heap_cur;");
    put("int std_heap_end;");
    put("int std_free_list;");
    put("int std_mem_lock;                 // 0 free, 1 taken (threads share the heap)");
    put("int std_alloc_n;                  // blocks given out / given back (the -d build reports the difference at the end)");
    put("int std_free_n;");
    put("");
    put("// a bug in the program (a null array, a position out of range, ...): say so and stop; try/catch cannot catch it");
    put("void __panic(char^ msg) {");
    put("    int n = 0;");
    put("    while msg[n] != 0 { n += 1; }");
    put("    syscall(64, 2, \"panic: \", 7);");
    put("    syscall(64, 2, msg, n);");
    put("    syscall(64, 2, \"\\n\", 1);");
    put("    syscall(94, 134);");
    put("}");
    put("");
    put("struct Mem {");
    put("    static void lock_heap() {");
    put("        while __cas(@std_mem_lock, 0, 1) != 0 {");
    put("            syscall(124);                  // sched_yield: let the thread that holds the heap finish");
    put("        }");
    put("    }");
    put("    static void unlock_heap() {");
    put("        __xchg(@std_mem_lock, 0);");
    put("    }");
    put("    // n bytes, not cleared (null if the system has no memory left)");
    put("    static void^ alloc(int n) {");
    put("        Mem::lock_heap();");
    put("        void^ r = Mem::alloc_raw(n);");
    put("        Mem::unlock_heap();");
    put("        return r;");
    put("    }");
    put("    static void^ alloc_raw(int n) {");
    put("        if n <= 0 { return null; }");
    put("        int need = (n + 15) / 16 * 16 + 16;");
    put("        int prev = 0;");
    put("        int cur = std_free_list;");
    put("        while cur != 0 {");
    put("            int^ hdr = (int^)cur;");
    put("            if hdr[0] >= need {");
    put("                if prev == 0 {");
    put("                    std_free_list = hdr[1];");
    put("                } else {");
    put("                    int^ before = (int^)prev;");
    put("                    before[1] = hdr[1];");
    put("                }");
    put("                std_alloc_n += 1;");
    put("                return (void^)(cur + 16);");
    put("            }");
    put("            prev = cur;");
    put("            cur = hdr[1];");
    put("        }");
    put("        if std_heap_cur + need > std_heap_end {");
    put("            int chunk = 1048576;");
    put("            if need > chunk { chunk = (need + 4095) / 4096 * 4096; }");
    put("            int base = syscall(222, 0, chunk, 3, 34, -1, 0);      // mmap: anonymous, read + write");
    put("            if base < 0 { return null; }");
    put("            std_heap_cur = base;");
    put("            std_heap_end = base + chunk;");
    put("        }");
    put("        int blk = std_heap_cur;");
    put("        std_heap_cur = std_heap_cur + need;");
    put("        std_alloc_n += 1;");
    put("        int^ head = (int^)blk;");
    put("        head[0] = need;");
    put("        return (void^)(blk + 16);");
    put("    }");
    put("    // give a block from alloc back (null is ignored)");
    put("    static void free(void^ p) {");
    put("        Mem::lock_heap();");
    put("        Mem::free_raw(p);");
    put("        Mem::unlock_heap();");
    put("    }");
    put("    static void free_raw(void^ p) {");
    put("        if (int)p == 0 { return; }");
    put("        int blk = (int)p - 16;");
    put("        int^ head = (int^)blk;");
    put("        head[1] = std_free_list;");
    put("        std_free_list = blk;");
    put("        std_free_n += 1;");
    put("    }");
    put("    // -d : at the end of main, say how many blocks were never given back");
    put("    static void report() {");
    put("        int n = std_alloc_n - std_free_n;");
    put("        if n <= 0 { return; }");
    put("        char d[24];");
    put("        int k = 23;");
    put("        d[k] = 10;");
    put("        while n > 0 {");
    put("            k -= 1;");
    put("            d[k] = '0' + n % 10;");
    put("            n = n / 10;");
    put("        }");
    put("        syscall(64, 2, \"debug: memory blocks never freed: \", 34);");
    put("        syscall(64, 2, @d + k, 24 - k);");
    put("    }");
    put("    static void set(void^ p, int value, int n) {");
    put("        char^ q = (char^)p;");
    put("        int i = 0;");
    put("        while i < n {");
    put("            q[i] = value;");
    put("            i += 1;");
    put("        }");
    put("    }");
    put("    static void copy(void^ dst, void^ src, int n) {");
    put("        char^ d = (char^)dst;");
    put("        char^ s = (char^)src;");
    put("        int i = 0;");
    put("        while i < n {");
    put("            d[i] = s[i];");
    put("            i += 1;");
    put("        }");
    put("    }");
    put("}");
    put("");
    put("// Dynamic arrays (T[] x = arr(n)): a header [length, capacity, data, element size]");
    put("// points to the elements. The header stays where it is, so every copy of the");
    put("// variable sees the same array; only the data block moves when it grows.");
    put("struct __Arr {");
    put("    static void nullerr() {");
    put("        __panic(\"the dynamic array is null\");");
    put("    }");
    put("    static void^ make(int esize, int cap) {");
    put("        int^ h = (int^)Mem::alloc(32);");
    put("        if (int)h == 0 { __panic(\"out of memory\"); }");
    put("        int c = cap;");
    put("        if c < 4 { c = 4; }");
    put("        h[0] = 0;");
    put("        h[1] = c;");
    put("        h[2] = (int)Mem::alloc(c * esize);");
    put("        h[3] = esize;");
    put("        if h[2] == 0 { __panic(\"out of memory\"); }");
    put("        return (void^)h;");
    put("    }");
    put("    // room for at least `need` elements");
    put("    static void grow(int^ h, int need) {");
    put("        if need <= h[1] { return; }");
    put("        int c = h[1] * 2;");
    put("        if c < need { c = need; }");
    put("        int nd = (int)Mem::alloc(c * h[3]);");
    put("        if nd == 0 { __panic(\"out of memory\"); }");
    put("        Mem::copy((void^)nd, (void^)h[2], h[0] * h[3]);");
    put("        Mem::free((void^)h[2]);");
    put("        h[2] = nd;");
    put("        h[1] = c;");
    put("    }");
    put("    // append one element: returns the address of its (new) place");
    put("    static void^ slot(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { __panic(\"the dynamic array is null\"); }");
    put("        __Arr::grow(h, h[0] + 1);");
    put("        int at = h[2] + h[0] * h[3];");
    put("        h[0] += 1;");
    put("        return (void^)at;");
    put("    }");
    put("    // remove the last element: returns the address where it still is");
    put("    static void^ pop(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { __panic(\"the dynamic array is null\"); }");
    put("        if h[0] == 0 { __panic(\"pop from an empty array\"); }");
    put("        h[0] -= 1;");
    put("        return (void^)(h[2] + h[0] * h[3]);");
    put("    }");
    put("    static void resize(void^ hv, int n) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { __panic(\"the dynamic array is null\"); }");
    put("        if n < 0 { __panic(\"negative array size\"); }");
    put("        __Arr::grow(h, n);");
    put("        if n > h[0] { Mem::set((void^)(h[2] + h[0] * h[3]), 0, (n - h[0]) * h[3]); }");
    put("        h[0] = n;");
    put("    }");
    put("    // ---- numbers in an array: kind 0 signed, 1 unsigned (also pointers), 2 float, 3 double");
    put("    // the bits of element i as a whole number (sign or zero extended; the IEEE bits for a float)");
    put("    static int get(int^ h, int i, int kind) {");
    put("        char^ d = (char^)(h[2] + i * h[3]);");
    put("        int es = h[3];");
    put("        int v = 0;");
    put("        int k = es - 1;");
    put("        while k >= 0 {");
    put("            v = v * 256 + d[k];");
    put("            k -= 1;");
    put("        }");
    put("        if kind == 0 && es < 8 {");
    put("            int sh = 64 - es * 8;");
    put("            v = (v shl sh) shr sh;");
    put("        }");
    put("        return v;");
    put("    }");
    put("    static void put(int^ h, int i, int bits) {");
    put("        char^ d = (char^)(h[2] + i * h[3]);");
    put("        int k = 0;");
    put("        while k < h[3] {");
    put("            d[k] = bits & 255;");
    put("            bits = bits shr 8;");
    put("            k += 1;");
    put("        }");
    put("    }");
    put("    // a before b ?");
    put("    static bool less(int a, int b, int kind) {");
    put("        if kind == 0 { return a < b; }");
    put("        if kind == 1 { return (a xor -9223372036854775807 - 1) < (b xor -9223372036854775807 - 1); }");
    put("        if kind == 2 {");
    put("            int x = a;");
    put("            int y = b;");
    put("            float^ fx = (float^)@x;");
    put("            float^ fy = (float^)@y;");
    put("            return fx[0] < fy[0];");
    put("        }");
    put("        int x2 = a;");
    put("        int y2 = b;");
    put("        double^ dx = (double^)@x2;");
    put("        double^ dy = (double^)@y2;");
    put("        return dx[0] < dy[0];");
    put("    }");
    put("    static void insert(void^ hv, int i, int bits) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        if i < 0 || i > h[0] { __panic(\"insert position out of range\"); }");
    put("        __Arr::grow(h, h[0] + 1);");
    put("        int k = h[0];");
    put("        while k > i {");
    put("            __Arr::put(h, k, __Arr::get(h, k - 1, 1));");
    put("            k -= 1;");
    put("        }");
    put("        __Arr::put(h, i, bits);");
    put("        h[0] += 1;");
    put("    }");
    put("    static void remove(void^ hv, int i) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        if i < 0 || i >= h[0] { __panic(\"remove position out of range\"); }");
    put("        int k = i;");
    put("        while k + 1 < h[0] {");
    put("            __Arr::put(h, k, __Arr::get(h, k + 1, 1));");
    put("            k += 1;");
    put("        }");
    put("        h[0] -= 1;");
    put("    }");
    put("    // the place of the first element equal to bits, or -1");
    put("    static int index(void^ hv, int bits, int kind) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            int e = __Arr::get(h, i, kind);");
    put("            if !__Arr::less(e, bits, kind) && !__Arr::less(bits, e, kind) { return i; }");
    put("            i += 1;");
    put("        }");
    put("        return 0 - 1;");
    put("    }");
    put("    static void sort(void^ hv, int kind) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        int n = h[0];");
    put("        int start = n / 2 - 1;");
    put("        while start >= 0 {");
    put("            __Arr::sift(h, start, n, kind);");
    put("            start -= 1;");
    put("        }");
    put("        int end = n - 1;");
    put("        while end > 0 {");
    put("            int t = __Arr::get(h, 0, kind);");
    put("            __Arr::put(h, 0, __Arr::get(h, end, kind));");
    put("            __Arr::put(h, end, t);");
    put("            __Arr::sift(h, 0, end, kind);");
    put("            end -= 1;");
    put("        }");
    put("    }");
    put("    static void sift(int^ h, int root, int n, int kind) {");
    put("        while true {");
    put("            int child = root * 2 + 1;");
    put("            if child >= n { return; }");
    put("            if child + 1 < n && __Arr::less(__Arr::get(h, child, kind), __Arr::get(h, child + 1, kind), kind) { child += 1; }");
    put("            int a = __Arr::get(h, root, kind);");
    put("            int b = __Arr::get(h, child, kind);");
    put("            if !__Arr::less(a, b, kind) { return; }");
    put("            __Arr::put(h, root, b);");
    put("            __Arr::put(h, child, a);");
    put("            root = child;");
    put("        }");
    put("    }");
    put("    // a copy of an array of numbers / pointers");
    put("    static void^ clone(void^ hv) {");
    put("        if (int)hv == 0 { __panic(\"the dynamic array is null\"); }");
    put("        int^ h = (int^)hv;");
    put("        int^ r = (int^)__Arr::make(h[3], h[0]);");
    put("        Mem::copy((void^)r[2], (void^)h[2], h[0] * h[3]);");
    put("        r[0] = h[0];");
    put("        return (void^)r;");
    put("    }");
    put("    // give the elements and the header back (null is ignored)");
    put("    static void free(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { return; }");
    put("        Mem::free((void^)h[2]);");
    put("        Mem::free(hv);");
    put("    }");
    put("}");
    put("");
    put("// String: a dynamic array of char (header [length, capacity, data, 1]) whose data always ends");
    put("// in a 0 byte after the length, so that the data is also a C-style text (cout, c()).");
    put("// An operand is a text (kind 0), another String (kind 1) or one character (kind 2).");
    put("char std_str_ch[16];");
    put("struct __Str {");
    put("    static void^ make(int cap) {");
    put("        int^ h = (int^)__Arr::make(1, cap + 1);");
    put("        char^ d = (char^)h[2];");
    put("        d[0] = 0;");
    put("        return (void^)h;");
    put("    }");
    put("    static int textlen(char^ t) {");
    put("        int n = 0;");
    put("        while t[n] != 0 { n += 1; }");
    put("        return n;");
    put("    }");
    put("    static void check(void^ hv) {");
    put("        if (int)hv == 0 { __panic(\"the String is null\"); }");
    put("    }");
    put("    // the characters of an operand");
    put("    static char^ ptr(void^ x, int k, int slot) {");
    put("        if k == 1 {");
    put("            __Str::check(x);");
    put("            int^ h = (int^)x;");
    put("            return (char^)h[2];");
    put("        }");
    put("        if k == 2 {");
    put("            std_str_ch[slot * 8] = (int)x;");
    put("            std_str_ch[slot * 8 + 1] = 0;");
    put("            return @std_str_ch + slot * 8;");
    put("        }");
    put("        return (char^)x;");
    put("    }");
    put("    static int len(void^ x, int k) {");
    put("        if k == 1 {");
    put("            __Str::check(x);");
    put("            int^ h = (int^)x;");
    put("            return h[0];");
    put("        }");
    put("        if k == 2 { return 1; }");
    put("        return __Str::textlen((char^)x);");
    put("    }");
    put("    // a new String holding a copy of the text");
    put("    static void^ from(char^ t) {");
    put("        int n = __Str::textlen(t);");
    put("        int^ h = (int^)__Str::make(n);");
    put("        Mem::copy((void^)h[2], (void^)t, n);");
    put("        char^ d = (char^)h[2];");
    put("        d[n] = 0;");
    put("        h[0] = n;");
    put("        return (void^)h;");
    put("    }");
    put("    // a copy of a String");
    put("    static void^ clone(void^ x) {");
    put("        return __Str::cat(x, 1, (void^)\"\", 0);");
    put("    }");
    put("    // a new String: a followed by b");
    put("    static void^ cat(void^ a, int ka, void^ b, int kb) {");
    put("        int na = __Str::len(a, ka);");
    put("        int nb = __Str::len(b, kb);");
    put("        int^ h = (int^)__Str::make(na + nb);");
    put("        char^ d = (char^)h[2];");
    put("        Mem::copy((void^)d, (void^)__Str::ptr(a, ka, 0), na);");
    put("        Mem::copy((void^)(d + na), (void^)__Str::ptr(b, kb, 1), nb);");
    put("        d[na + nb] = 0;");
    put("        h[0] = na + nb;");
    put("        return (void^)h;");
    put("    }");
    put("    // a followed by b, in a (returns a)");
    put("    static void^ append(void^ a, void^ b, int kb) {");
    put("        __Str::check(a);");
    put("        if kb == 1 && (int)b == (int)a {                 // s.append(s): the data may move");
    put("            void^ same = __Str::clone(a);");
    put("            __Str::append(a, same, 1);");
    put("            __Arr::free(same);");
    put("            return a;");
    put("        }");
    put("        int^ h = (int^)a;");
    put("        int nb = __Str::len(b, kb);");
    put("        char^ src = __Str::ptr(b, kb, 1);");
    put("        __Arr::grow(h, h[0] + nb + 1);");
    put("        Mem::copy((void^)(h[2] + h[0]), (void^)src, nb);");
    put("        h[0] += nb;");
    put("        char^ d = (char^)h[2];");
    put("        d[h[0]] = 0;");
    put("        return a;");
    put("    }");
    put("    static void push(void^ a, int c) {");
    put("        __Str::check(a);");
    put("        int^ h = (int^)a;");
    put("        __Arr::grow(h, h[0] + 2);");
    put("        char^ d = (char^)h[2];");
    put("        d[h[0]] = c;");
    put("        h[0] += 1;");
    put("        d[h[0]] = 0;");
    put("    }");
    put("    static int pop(void^ a) {");
    put("        __Str::check(a);");
    put("        int^ h = (int^)a;");
    put("        if h[0] == 0 { __panic(\"pop from an empty String\"); }");
    put("        h[0] -= 1;");
    put("        char^ d = (char^)h[2];");
    put("        int c = d[h[0]];");
    put("        d[h[0]] = 0;");
    put("        return c;");
    put("    }");
    put("    static void clear(void^ a) {");
    put("        __Str::check(a);");
    put("        int^ h = (int^)a;");
    put("        h[0] = 0;");
    put("        char^ d = (char^)h[2];");
    put("        d[0] = 0;");
    put("    }");
    put("    // 1 if the two operands hold the same characters");
    put("    static int eq(void^ a, int ka, void^ b, int kb) {");
    put("        int na = __Str::len(a, ka);");
    put("        int nb = __Str::len(b, kb);");
    put("        if na != nb { return 0; }");
    put("        char^ pa = __Str::ptr(a, ka, 0);");
    put("        char^ pb = __Str::ptr(b, kb, 1);");
    put("        int i = 0;");
    put("        while i < na {");
    put("            if pa[i] != pb[i] { return 0; }");
    put("            i += 1;");
    put("        }");
    put("        return 1;");
    put("    }");
    put("    // the first place of t in s at or after `from`, or -1");
    put("    static int find(void^ s, void^ t, int kt) {");
    put("        int ns = __Str::len(s, 1);");
    put("        int nt = __Str::len(t, kt);");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ pt = __Str::ptr(t, kt, 1);");
    put("        int i = 0;");
    put("        while i + nt <= ns {");
    put("            int j = 0;");
    put("            while j < nt && ps[i + j] == pt[j] { j += 1; }");
    put("            if j == nt { return i; }");
    put("            i += 1;");
    put("        }");
    put("        return 0 - 1;");
    put("    }");
    put("    // a new String: the characters a .. b - 1");
    put("    static void^ slice(void^ s, int a, int b) {");
    put("        int n = __Str::len(s, 1);");
    put("        if a < 0 || b > n || a > b { __panic(\"String slice out of range\"); }");
    put("        int^ h = (int^)__Str::make(b - a);");
    put("        char^ d = (char^)h[2];");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        Mem::copy((void^)d, (void^)(ps + a), b - a);");
    put("        d[b - a] = 0;");
    put("        h[0] = b - a;");
    put("        return (void^)h;");
    put("    }");
    put("    static char^ c(void^ s) {");
    put("        return __Str::ptr(s, 1, 0);");
    put("    }");
    put("    // hash of a whole number / of a String (FNV-1a over the bytes)");
    put("    static int hashint(int x) {");
    put("        int h = x * -7046029254386353131;");
    put("        return h xor (h shr 29);");
    put("    }");
    put("    static int hash(void^ s) {");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int h = -3750763034362895579;");
    put("        int i = 0;");
    put("        while p[i] != 0 {");
    put("            h = (h xor p[i]) * 1099511628211;");
    put("            i += 1;");
    put("        }");
    put("        return h xor (h shr 29);");
    put("    }");
    put("    // String[]: n places (new ones are null, cut ones are freed)");
    put("    static void aresize(void^ hv, int n) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        if n < 0 { __panic(\"negative array size\"); }");
    put("        int^ el = (int^)h[2];");
    put("        int i = n;");
    put("        while i < h[0] {");
    put("            __Arr::free((void^)el[i]);");
    put("            i += 1;");
    put("        }");
    put("        __Arr::grow(h, n);");
    put("        el = (int^)h[2];");
    put("        i = h[0];");
    put("        while i < n {");
    put("            el[i] = 0;");
    put("            i += 1;");
    put("        }");
    put("        h[0] = n;");
    put("    }");
    put("    // -1, 0, 1: a before, equal to, after b (bytes)");
    put("    static int cmp(void^ a, void^ b) {");
    put("        char^ pa = __Str::ptr(a, 1, 0);");
    put("        char^ pb = __Str::ptr(b, 1, 1);");
    put("        int i = 0;");
    put("        while pa[i] != 0 && pa[i] == pb[i] { i += 1; }");
    put("        if pa[i] == pb[i] { return 0; }");
    put("        if pa[i] < pb[i] { return 0 - 1; }");
    put("        return 1;");
    put("    }");
    put("");
    put("    // ---- more String functions (the bytes are treated as ASCII where case matters)");
    put("    static bool isspace(int c) {");
    put("        return c == 32 || c == 9 || c == 10 || c == 13;");
    put("    }");
    put("    // a new String: s without the white space at both ends");
    put("    static void^ trim(void^ s) {");
    put("        int n = __Str::len(s, 1);");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int a = 0;");
    put("        int b = n;");
    put("        while a < b && __Str::isspace(p[a]) { a += 1; }");
    put("        while b > a && __Str::isspace(p[b - 1]) { b -= 1; }");
    put("        return __Str::slice(s, a, b);");
    put("    }");
    put("    static void^ upper(void^ s) {");
    put("        void^ r = __Str::clone(s);");
    put("        char^ p = __Str::ptr(r, 1, 0);");
    put("        int i = 0;");
    put("        while p[i] != 0 {");
    put("            if p[i] >= 'a' && p[i] <= 'z' { p[i] = p[i] - 32; }");
    put("            i += 1;");
    put("        }");
    put("        return r;");
    put("    }");
    put("    static void^ lower(void^ s) {");
    put("        void^ r = __Str::clone(s);");
    put("        char^ p = __Str::ptr(r, 1, 0);");
    put("        int i = 0;");
    put("        while p[i] != 0 {");
    put("            if p[i] >= 'A' && p[i] <= 'Z' { p[i] = p[i] + 32; }");
    put("            i += 1;");
    put("        }");
    put("        return r;");
    put("    }");
    put("    static int starts_with(void^ s, void^ x, int kx) {");
    put("        int ns = __Str::len(s, 1);");
    put("        int nx = __Str::len(x, kx);");
    put("        if nx > ns { return 0; }");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ px = __Str::ptr(x, kx, 1);");
    put("        int i = 0;");
    put("        while i < nx {");
    put("            if ps[i] != px[i] { return 0; }");
    put("            i += 1;");
    put("        }");
    put("        return 1;");
    put("    }");
    put("    static int ends_with(void^ s, void^ x, int kx) {");
    put("        int ns = __Str::len(s, 1);");
    put("        int nx = __Str::len(x, kx);");
    put("        if nx > ns { return 0; }");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ px = __Str::ptr(x, kx, 1);");
    put("        int i = 0;");
    put("        while i < nx {");
    put("            if ps[ns - nx + i] != px[i] { return 0; }");
    put("            i += 1;");
    put("        }");
    put("        return 1;");
    put("    }");
    put("    // a new String: every a in s replaced by b");
    put("    static void^ replace(void^ s, void^ a, int ka, void^ b, int kb) {");
    put("        int na = __Str::len(a, ka);");
    put("        if na == 0 { __panic(\"replace: the text to look for is empty\"); }");
    put("        void^ r = __Str::make(__Str::len(s, 1));");
    put("        int ns = __Str::len(s, 1);");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ pa = __Str::ptr(a, ka, 1);");
    put("        int i = 0;");
    put("        while i < ns {");
    put("            int j = 0;");
    put("            while j < na && i + j < ns && ps[i + j] == pa[j] { j += 1; }");
    put("            if j == na {");
    put("                __Str::append(r, b, kb);");
    put("                i += na;");
    put("            } else {");
    put("                __Str::push(r, ps[i]);");
    put("                i += 1;");
    put("            }");
    put("        }");
    put("        return r;");
    put("    }");
    put("    // a new String: s repeated n times");
    put("    static void^ repeat(void^ s, int n) {");
    put("        void^ r = __Str::make(__Str::len(s, 1) * (n + 1));");
    put("        int i = 0;");
    put("        while i < n {");
    put("            __Str::append(r, s, 1);");
    put("            i += 1;");
    put("        }");
    put("        return r;");
    put("    }");
    put("    // the whole String as a number (an optional sign and digits); throws \"not a number\"");
    put("    static int to_int(void^ s) {");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int n = __Str::len(s, 1);");
    put("        int i = 0;");
    put("        while i < n && __Str::isspace(p[i]) { i += 1; }");
    put("        int neg = 0;");
    put("        if i < n && (p[i] == '-' || p[i] == '+') {");
    put("            if p[i] == '-' { neg = 1; }");
    put("            i += 1;");
    put("        }");
    put("        if i >= n || p[i] < '0' || p[i] > '9' { throw \"not a number\"; }");
    put("        int v = 0;");
    put("        while i < n && p[i] >= '0' && p[i] <= '9' {");
    put("            v = v * 10 + (p[i] - '0');");
    put("            i += 1;");
    put("        }");
    put("        while i < n && __Str::isspace(p[i]) { i += 1; }");
    put("        if i != n { throw \"not a number\"; }");
    put("        if neg == 1 { return 0 - v; }");
    put("        return v;");
    put("    }");
    put("    // the whole String as a decimal number (sign, digits, a point, digits, e and an exponent); throws \"not a number\"");
    put("    static double to_double(void^ s) {");
    put("        char^ p = __Str::ptr(s, 1, 0);");
    put("        int n = __Str::len(s, 1);");
    put("        int i = 0;");
    put("        while i < n && __Str::isspace(p[i]) { i += 1; }");
    put("        int neg = 0;");
    put("        if i < n && (p[i] == '-' || p[i] == '+') {");
    put("            if p[i] == '-' { neg = 1; }");
    put("            i += 1;");
    put("        }");
    put("        double v = 0.0;");
    put("        int any = 0;");
    put("        while i < n && p[i] >= '0' && p[i] <= '9' {");
    put("            v = v * 10.0 + (double)(p[i] - '0');");
    put("            any = 1;");
    put("            i += 1;");
    put("        }");
    put("        if i < n && p[i] == '.' {");
    put("            i += 1;");
    put("            double scale = 0.1;");
    put("            while i < n && p[i] >= '0' && p[i] <= '9' {");
    put("                v = v + (double)(p[i] - '0') * scale;");
    put("                scale = scale / 10.0;");
    put("                any = 1;");
    put("                i += 1;");
    put("            }");
    put("        }");
    put("        if any == 0 { throw \"not a number\"; }");
    put("        if i < n && (p[i] == 'e' || p[i] == 'E') {");
    put("            i += 1;");
    put("            int eneg = 0;");
    put("            if i < n && (p[i] == '-' || p[i] == '+') {");
    put("                if p[i] == '-' { eneg = 1; }");
    put("                i += 1;");
    put("            }");
    put("            if i >= n || p[i] < '0' || p[i] > '9' { throw \"not a number\"; }");
    put("            int e = 0;");
    put("            while i < n && p[i] >= '0' && p[i] <= '9' {");
    put("                e = e * 10 + (p[i] - '0');");
    put("                i += 1;");
    put("            }");
    put("            while e > 0 {");
    put("                if eneg == 1 { v = v / 10.0; } else { v = v * 10.0; }");
    put("                e -= 1;");
    put("            }");
    put("        }");
    put("        while i < n && __Str::isspace(p[i]) { i += 1; }");
    put("        if i != n { throw \"not a number\"; }");
    put("        if neg == 1 { return 0.0 - v; }");
    put("        return v;");
    put("    }");
    put("    // a String[] with the pieces of s between the separators (an empty separator throws)");
    put("    static void^ split(void^ s, void^ sep, int ksep) {");
    put("        int nsep = __Str::len(sep, ksep);");
    put("        if nsep == 0 { __panic(\"split: the separator is empty\"); }");
    put("        void^ r = __Arr::make(8, 4);");
    put("        int ns = __Str::len(s, 1);");
    put("        char^ ps = __Str::ptr(s, 1, 0);");
    put("        char^ pp = __Str::ptr(sep, ksep, 1);");
    put("        int start = 0;");
    put("        int i = 0;");
    put("        while i + nsep <= ns {");
    put("            int j = 0;");
    put("            while j < nsep && ps[i + j] == pp[j] { j += 1; }");
    put("            if j == nsep {");
    put("                __Str::apush(r, __Str::slice(s, start, i));");
    put("                i += nsep;");
    put("                start = i;");
    put("            } else {");
    put("                i += 1;");
    put("            }");
    put("        }");
    put("        __Str::apush(r, __Str::slice(s, start, ns));");
    put("        return r;");
    put("    }");
    put("    // a new String: the elements of a String[] with sep between them");
    put("    static void^ ajoin(void^ hv, void^ sep, int ksep) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        int^ el = (int^)h[2];");
    put("        void^ r = __Str::make(16);");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            if i > 0 { __Str::append(r, sep, ksep); }");
    put("            __Str::append(r, (void^)el[i], 1);");
    put("            i += 1;");
    put("        }");
    put("        return r;");
    put("    }");
    put("");
    put("    // ---- String[] : an array whose elements are String headers owned by the array");
    put("    // a deep copy of a String[] (every String is copied)");
    put("    static void^ aclone(void^ hv) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        void^ rv = __Arr::make(8, h[0]);");
    put("        int^ el = (int^)h[2];");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            if el[i] == 0 {");
    put("                int^ slot = (int^)__Arr::slot(rv);");
    put("                slot[0] = 0;");
    put("            } else {");
    put("                __Str::apush(rv, __Str::clone((void^)el[i]));");
    put("            }");
    put("            i += 1;");
    put("        }");
    put("        return rv;");
    put("    }");
    put("    static void aprep(void^ hv) {");
    put("        if (int)hv == 0 { __panic(\"the array is null\"); }");
    put("    }");
    put("    // the elements and the array are given back");
    put("    static void free_all(void^ hv) {");
    put("        int^ h = (int^)hv;");
    put("        if (int)h == 0 { return; }");
    put("        int^ el = (int^)h[2];");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            __Arr::free((void^)el[i]);");
    put("            i += 1;");
    put("        }");
    put("        __Arr::free(hv);");
    put("    }");
    put("    static void clear_all(void^ hv) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        int^ el = (int^)h[2];");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            __Arr::free((void^)el[i]);");
    put("            i += 1;");
    put("        }");
    put("        h[0] = 0;");
    put("    }");
    put("    // append s (the array takes it over)");
    put("    static void apush(void^ hv, void^ s) {");
    put("        __Str::aprep(hv);");
    put("        int^ slot = (int^)__Arr::slot(hv);");
    put("        slot[0] = (int)s;");
    put("    }");
    put("    // remove the last one and give it to the caller");
    put("    static void^ apop(void^ hv) {");
    put("        __Str::aprep(hv);");
    put("        int^ slot = (int^)__Arr::pop(hv);");
    put("        return (void^)slot[0];");
    put("    }");
    put("    // put s (taken over) at place i");
    put("    static void ainsert(void^ hv, int i, void^ s) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        if i < 0 || i > h[0] { __panic(\"insert position out of range\"); }");
    put("        __Arr::grow(h, h[0] + 1);");
    put("        int^ el = (int^)h[2];");
    put("        int k = h[0];");
    put("        while k > i {");
    put("            el[k] = el[k - 1];");
    put("            k -= 1;");
    put("        }");
    put("        el[i] = (int)s;");
    put("        h[0] += 1;");
    put("    }");
    put("    // remove the one at place i (it is freed)");
    put("    static void aremove(void^ hv, int i) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        if i < 0 || i >= h[0] { __panic(\"remove position out of range\"); }");
    put("        int^ el = (int^)h[2];");
    put("        __Arr::free((void^)el[i]);");
    put("        int k = i;");
    put("        while k + 1 < h[0] {");
    put("            el[k] = el[k + 1];");
    put("            k += 1;");
    put("        }");
    put("        h[0] -= 1;");
    put("    }");
    put("    // the place of the first element equal to the operand, or -1");
    put("    static int aindex(void^ hv, void^ x, int kx) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        int^ el = (int^)h[2];");
    put("        int i = 0;");
    put("        while i < h[0] {");
    put("            if __Str::eq((void^)el[i], 1, x, kx) == 1 { return i; }");
    put("            i += 1;");
    put("        }");
    put("        return 0 - 1;");
    put("    }");
    put("    // sort ascending (heap sort, no extra memory)");
    put("    static void asort(void^ hv) {");
    put("        __Str::aprep(hv);");
    put("        int^ h = (int^)hv;");
    put("        int^ el = (int^)h[2];");
    put("        int n = h[0];");
    put("        int start = n / 2 - 1;");
    put("        while start >= 0 {");
    put("            __Str::asift(el, start, n);");
    put("            start -= 1;");
    put("        }");
    put("        int end = n - 1;");
    put("        while end > 0 {");
    put("            int t = el[0];");
    put("            el[0] = el[end];");
    put("            el[end] = t;");
    put("            __Str::asift(el, 0, end);");
    put("            end -= 1;");
    put("        }");
    put("    }");
    put("    static void asift(int^ el, int root, int n) {");
    put("        while true {");
    put("            int child = root * 2 + 1;");
    put("            if child >= n { return; }");
    put("            if child + 1 < n && __Str::cmp((void^)el[child], (void^)el[child + 1]) < 0 { child += 1; }");
    put("            if __Str::cmp((void^)el[root], (void^)el[child]) >= 0 { return; }");
    put("            int t = el[root];");
    put("            el[root] = el[child];");
    put("            el[child] = t;");
    put("            root = child;");
    put("        }");
    put("    }");
    put("}");
    put("");
    put("// Reading the keyboard (cin >> x, cinf >> x): a buffer over file descriptor 0.");
    put("char std_in_buf[4096];");
    put("int std_in_pos;");
    put("int std_in_len;");
    put("");
    put("struct __In {");
    put("    // the next byte without taking it, or -1 at the end of the input");
    put("    static int peek() {");
    put("        if std_in_pos >= std_in_len {");
    put("            int n = syscall(63, 0, @std_in_buf, 4096);");
    put("            if n <= 0 { return -1; }");
    put("            std_in_len = n;");
    put("            std_in_pos = 0;");
    put("        }");
    put("        return std_in_buf[std_in_pos];");
    put("    }");
    put("    static bool space(int c) {");
    put("        return c == 32 || c == 9 || c == 10 || c == 13;");
    put("    }");
    put("    // skip white space: the first character of the next word, or -1");
    put("    static int start() {");
    put("        int c = __In::peek();");
    put("        while c >= 0 && __In::space(c) {");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        return c;");
    put("    }");
    put("    // a word into a String");
    put("    static void str(void^ h) {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        __Str::clear(h);");
    put("        while c >= 0 && !__In::space(c) {");
    put("            __Str::push(h, c);");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("    }");
    put("    // a whole number (an error unless lo <= value <= hi; no limits when lo > hi; uns = 1: no minus sign)");
    put("    static int num(int lo, int hi, int uns) {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        int neg = 0;");
    put("        if c == '-' || c == '+' {");
    put("            if c == '-' { neg = 1; }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        if c < '0' || c > '9' { throw \"invalid input\"; }");
    put("        if neg == 1 && uns == 1 { throw \"invalid input\"; }");
    put("        int v = 0;");
    put("        while c >= '0' && c <= '9' {");
    put("            v = v * 10 + (c - '0');");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        if c >= 0 && !__In::space(c) { throw \"invalid input\"; }");
    put("        if neg == 1 { v = 0 - v; }");
    put("        if lo <= hi && (v < lo || v > hi) { throw \"number out of range\"; }");
    put("        return v;");
    put("    }");
    put("    // a decimal number: 12  -3.5  .5  2e-3");
    put("    static double fnum() {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        int neg = 0;");
    put("        if c == '-' || c == '+' {");
    put("            if c == '-' { neg = 1; }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        int mant = 0;");
    put("        int exp = 0;");
    put("        int seen = 0;");
    put("        while c >= '0' && c <= '9' {");
    put("            seen = 1;");
    put("            if mant < 100000000000000000 { mant = mant * 10 + (c - '0'); } else { exp += 1; }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        if c == '.' {");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("            while c >= '0' && c <= '9' {");
    put("                seen = 1;");
    put("                if mant < 100000000000000000 {");
    put("                    mant = mant * 10 + (c - '0');");
    put("                    exp -= 1;");
    put("                }");
    put("                std_in_pos += 1;");
    put("                c = __In::peek();");
    put("            }");
    put("        }");
    put("        if seen == 0 { throw \"invalid input\"; }");
    put("        if c == 'e' || c == 'E' {");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("            int eneg = 0;");
    put("            if c == '-' || c == '+' {");
    put("                if c == '-' { eneg = 1; }");
    put("                std_in_pos += 1;");
    put("                c = __In::peek();");
    put("            }");
    put("            if c < '0' || c > '9' { throw \"invalid input\"; }");
    put("            int ev = 0;");
    put("            while c >= '0' && c <= '9' {");
    put("                if ev < 10000 { ev = ev * 10 + (c - '0'); }");
    put("                std_in_pos += 1;");
    put("                c = __In::peek();");
    put("            }");
    put("            if eneg == 1 { exp -= ev; } else { exp += ev; }");
    put("        }");
    put("        if c >= 0 && !__In::space(c) { throw \"invalid input\"; }");
    put("        double v = (double)mant;");
    put("        while exp > 0 {");
    put("            v = v * 10.0;");
    put("            exp -= 1;");
    put("        }");
    put("        while exp < 0 {");
    put("            v = v / 10.0;");
    put("            exp += 1;");
    put("        }");
    put("        if neg == 1 { v = -v; }");
    put("        return v;");
    put("    }");
    put("    // one character");
    put("    static int ch() {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        std_in_pos += 1;");
    put("        return c;");
    put("    }");
    put("    static int put(char^ buf, int at, char^ s) {");
    put("        int i = 0;");
    put("        while s[i] != 0 {");
    put("            buf[at] = s[i];");
    put("            at += 1;");
    put("            i += 1;");
    put("        }");
    put("        return at;");
    put("    }");
    put("    static int putnum(char^ buf, int at, int v) {");
    put("        char d[24];");
    put("        int n = 0;");
    put("        if v == 0 {");
    put("            d[0] = '0';");
    put("            n = 1;");
    put("        }");
    put("        while v > 0 {");
    put("            d[n] = '0' + v % 10;");
    put("            v = v / 10;");
    put("            n += 1;");
    put("        }");
    put("        while n > 0 {");
    put("            n -= 1;");
    put("            buf[at] = d[n];");
    put("            at += 1;");
    put("        }");
    put("        return at;");
    put("    }");
    put("    // a word into dst (room for cap characters including the 0): longer words are cut");
    put("    static int word(char^ dst, int cap, char^ name) {");
    put("        int c = __In::start();");
    put("        if c < 0 { throw \"end of input\"; }");
    put("        int n = 0;");
    put("        int cut = 0;");
    put("        while c >= 0 && !__In::space(c) {");
    put("            if n < cap - 1 {");
    put("                dst[n] = c;");
    put("                n += 1;");
    put("            } else {");
    put("                cut = 1;");
    put("            }");
    put("            std_in_pos += 1;");
    put("            c = __In::peek();");
    put("        }");
    put("        dst[n] = 0;");
    put("        if cut == 1 {");
    put("            char m[200];");
    put("            int at = __In::put(@m, 0, \"warning: input truncated — '\");");
    put("            at = __In::put(@m, at, name);");
    put("            at = __In::put(@m, at, \"' accepts max \");");
    put("            at = __In::putnum(@m, at, cap - 1);");
    put("            at = __In::put(@m, at, \" characters (char[\");");
    put("            at = __In::putnum(@m, at, cap);");
    put("            at = __In::put(@m, at, \"] - 1 for \\\\0)\\n\");");
    put("            syscall(64, 2, @m, at);");
    put("        }");
    put("        return n;");
    put("    }");
    put("}");
    put("");
    put("// #multithread for i in a..b { ... }: the iterations are shared among several threads.");
    put("struct __Mt {");
    put("    // how many threads the machine can run at once (1 .. 16)");
    put("    static int cores() {");
    put("        char mask[128];");
    put("        int n = syscall(123, 0, 128, @mask);               // sched_getaffinity");
    put("        if n <= 0 { return 4; }");
    put("        int c = 0;");
    put("        for i in 0..n {");
    put("            int b = mask[i];");
    put("            while b != 0 {");
    put("                c += b & 1;");
    put("                b = b >> 1;");
    put("            }");
    put("        }");
    put("        if c < 1 { c = 1; }");
    put("        if c > 16 { c = 16; }");
    put("        return c;");
    put("    }");
    put("    // worker = the address of the compiled loop body (it gets a block [frame of the caller, from, to]);");
    put("    // runs it on several threads, each with its own part of lo..hi, and waits for all of them");
    put("    static void run(int worker, int fp, int lo, int hi) {");
    put("        int n = hi - lo;");
    put("        if n <= 0 { return; }");
    put("        int parts = __Mt::cores();");
    put("        if parts > n { parts = n; }");
    put("        int size = 1048576;");
    put("        int^ blk = (int^)Mem::alloc(parts * 64);          // per part: [0] frame [1] from [2] to [3] thread id [4] stack");
    put("        if (int)blk == 0 { __panic(\"out of memory\"); }");
    put("        for p in 0..parts {");
    put("            blk[p * 8] = fp;");
    put("            blk[p * 8 + 1] = lo + n * p / parts;");
    put("            blk[p * 8 + 2] = lo + n * (p + 1) / parts;");
    put("            blk[p * 8 + 3] = 0;");
    put("            int base = syscall(222, 0, size, 3, 34, -1, 0);");
    put("            if base < 0 { throw \"cannot start the threads of the #multithread loop\"; }");
    put("            blk[p * 8 + 4] = base;");
    put("            int top = base + size - 1024;");
    put("            int tid = __thread_start(worker, (int)blk + p * 64, top, (int)blk + p * 64 + 24, top);");
    put("            if tid < 0 { throw \"cannot start the threads of the #multithread loop\"; }");
    put("        }");
    put("        for p in 0..parts {");
    put("            while blk[p * 8 + 3] != 0 {");
    put("                syscall(98, (int)blk + p * 64 + 24, 0, blk[p * 8 + 3], 0, 0, 0);");
    put("            }");
    put("            syscall(215, blk[p * 8 + 4], size);");
    put("        }");
    put("    }");
    put("}");
    put("");
    src_bufs[cur_base + cur_len] = 0;
    cur_pos = 0;
    cur_line = 1;
    cur_line_start = 0;
}
