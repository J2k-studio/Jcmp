    put("            if got < 0 { return (i32)got; }");
    put("            if got == 0 {");
    put("                if n == 0 { return -1; }");
    put("                break;");
    put("            }");
    put("            if c == 10 { break; }");
    put("            line[n] = c;");
    put("            n += 1;");
    put("        }");
    put("        line[n] = 0;");
    put("        return (i32)n;");
    put("    }");
