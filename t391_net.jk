#import <net>
int main() {
    // a connection inside the program
    int p[2];
    Net::pair(@p).unwrap();
    Net::send(p[0], "ping").unwrap();
    String a = Net::recv(p[1], 100).unwrap();
    Net::send(p[1], "pong " + a).unwrap();
    String b = Net::recv(p[0], 100).unwrap();
    cout << a << " " << b << "\n";
    Net::close(p[0]);
    Net::close(p[1]);
    // a listening socket and a client on this computer (the system picks the port)
    int l = Net::tcp_listen(0).unwrap();
    int port = Net::port_of(l);
    int c = Net::tcp_connect("127.0.0.1", port).unwrap();
    int s = Net::accept(l).unwrap();
    Net::send(c, "hello server").unwrap();
    cout << Net::recv(s, 100).unwrap() << " " << (port > 0) << "\n";
    Net::close(c);
    cout << "[" << Net::recv(s, 100).unwrap() << "]\n";
    Net::close(s);
    Net::close(l);
    // errors are values
    cout << Net::tcp_connect("not an ip", 80).is_err() << Net::tcp_connect("300.1.1.1", 80).is_err() << "\n";
    return 0;
}
