#import <stdlib>
#import <gamej>
#import <gpu>
void main() {
    // CPU path of gamej in surface mode (160 x 90): clear + 200 rects + convert + write, 300 frames
    Game g = Game::open("b");
    int t0 = Time::now_ms();
    for f in 0..300 {
        g.clear(0x101010);
        for i in 0..200 { g.rect((i * 7) % 150, (i * 3) % 80, 8, 8, 0xff0000 + i); }
        g.present();
    }
    int t1 = Time::now_ms();
    cout << "gamej CPU: " << (t1 - t0) * 1000 / 300 << " us per frame (200 rects, 160x90)\n";
    // the pixel work alone at a bigger size
    // gpu command building + serialisation: 2000 triangles per frame, 300 frames
    Gpu q = Gpu::open(320, 180);
    cout << "gpu ok here: " << q.ok() << "\n";
}
