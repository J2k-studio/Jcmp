#import <stdlib>
#import <opengl3>
int main() {
    Gl gl = Gl::open(32, 32, 2, 0);
    if !gl.ok { cout << "no ES 2.0: " << gl.log << "\n"; return 1; }
    String vs = "attribute vec2 pos;\nvoid main() { gl_Position = vec4(pos, 0.0, 1.0); }\n";
    String fs = "precision mediump float;\nvoid main() { gl_FragColor = vec4(0.0, 1.0, 0.0, 1.0); }\n";
    int prog = gl.program(vs, fs);
    if prog == 0 { cout << "shader: " << gl.log << "\n"; return 1; }
    gl.clear_color(0.0, 0.0, 0.0, 1.0); gl.clear_color_buffer();
    gl.use(prog);
    int loc = gl.attrib(prog, "pos");
    cout << "attrib " << loc << "\n";
    Floats t = Floats::make(6);
    t.set(0, -1.0); t.set(1, -1.0); t.set(2, 1.0); t.set(3, -1.0); t.set(4, 0.0); t.set(5, 1.0);
    gl.draw_triangles(t, 3);
    String px = gl.read_pixels(16, 8, 1, 1);
    cout << "ES 2.0 pixel " << (px[0] & 255) << " " << (px[1] & 255) << " " << (px[2] & 255) << "\n";
    return 0;
}
