#import <stdlib>
void probe(float a, float b, float c, float d) { cout << a << " " << b << " " << c << " " << d << "\n"; }
void probe2(int loc, float a, float b) { cout << loc << " " << a << " " << b << "\n"; }
int main() {
    void(float, float, float, float)^ f = probe;
    int addr = (int)f;
    void(float, float, float, float)^ g = (void(float, float, float, float)^)addr;
    g(1.5, 2.5, 3.5, 4.5);
    void(int, float, float)^ h = (void(int, float, float)^)((int)probe2);
    h(7, 0.25, 0.75);
    return 0;
}
